---
import { SITE_NAME, NAV_LINKS } from '../consts';
import { getLangFromUrl, localizePath, useTranslations } from '../i18n/utils';
import LangSwitcher from './LangSwitcher.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const homeHref = lang === 'en' ? '/en/' : '/';
---

<header class="site-header" id="site-header">
  <div class="container-editorial flex items-center justify-between" style="height:64px;">
    <a href={homeHref} class="font-serif text-base tracking-widest uppercase" aria-label={SITE_NAME} style="letter-spacing:0.2em;font-weight:400;">
      {SITE_NAME}
    </a>
    <nav class="hidden md:flex items-center gap-10" aria-label="Global">
      {
        NAV_LINKS.map((link) => (
          <a href={localizePath(link.href, lang)} class="hover-underline text-xs tracking-widest uppercase" style="letter-spacing:0.12em;color:var(--color-text);">
            {link.label}
          </a>
        ))
      }
      <LangSwitcher />
    </nav>
    <button
      id="menu-toggle"
      class="md:hidden flex flex-col gap-[5px] justify-center items-end w-8 h-8"
      aria-label={t('nav.menu')}
      type="button"
    >
      <span class="menu-bar block h-px bg-current w-6 transition-all duration-300"></span>
      <span class="menu-bar block h-px bg-current w-4 transition-all duration-300"></span>
      <span class="menu-bar block h-px bg-current w-6 transition-all duration-300"></span>
    </button>
  </div>

  <!-- Mobile menu -->
  <nav
    id="mobile-menu"
    class="md:hidden overflow-hidden"
    style="max-height:0; transition: max-height 0.5s cubic-bezier(0.19,1,0.22,1);"
    aria-label="Mobile"
  >
    <ul class="flex flex-col border-t border-[var(--color-border)]">
      {
        NAV_LINKS.map((link) => (
          <li class="border-b border-[var(--color-border)]">
            <a href={localizePath(link.href, lang)} class="flex items-center justify-between px-5 py-5 text-sm tracking-widest uppercase" style="letter-spacing:0.1em;">
              {link.label}
              <span style="font-size:10px;">→</span>
            </a>
          </li>
        ))
      }
      <li class="hd-lang-row">
        <span class="hd-lang-label">Language / 言語</span>
        <LangSwitcher compact />
      </li>
    </ul>
  </nav>
</header>

<!-- Header height spacer -->
<div style="height:64px;"></div>

<style>
  /* モバイルメニュー: ゆとりある余白 */
  #mobile-menu ul li > a {
    padding-top: 20px;
    padding-bottom: 20px;
  }
  .hd-lang-row {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: 26px 20px 22px;
  }
  .hd-lang-label {
    font-family: "Inter", sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #9aa3b0;
  }
</style>

<script>
  // Scroll effect
  const header = document.getElementById('site-header');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 20) {
      header?.classList.add('scrolled');
    } else {
      header?.classList.remove('scrolled');
    }
  }, { passive: true });

  // Mobile menu
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu') as HTMLElement | null;
  let open = false;
  toggle?.addEventListener('click', () => {
    open = !open;
    if (menu) {
      menu.style.maxHeight = open ? menu.scrollHeight + 'px' : '0';
    }
    const bars = toggle.querySelectorAll('.menu-bar');
    if (open) {
      (bars[0] as HTMLElement).style.transform = 'rotate(45deg) translateY(7px)';
      (bars[1] as HTMLElement).style.opacity = '0';
      (bars[2] as HTMLElement).style.transform = 'rotate(-45deg) translateY(-7px)';
    } else {
      (bars[0] as HTMLElement).style.transform = '';
      (bars[1] as HTMLElement).style.opacity = '1';
      (bars[2] as HTMLElement).style.transform = '';
    }
  });
</script>
