---
import { SITE_URL, SITE_NAME } from '../consts';
import { hreflangUrls } from '../i18n/utils';
import type { Locale } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  /** ページの言語 */
  lang?: Locale;
  image?: string;
  /** og:type — トップやサービスは website、記事・実績は article */
  ogType?: string;
  /** ページ固有の追加 JSON-LD（Service / Article / FAQPage / CreativeWork など） */
  jsonLd?: Record<string, any> | Record<string, any>[];
  noindex?: boolean;
  /** article 系ページ用: 公開日 */
  publishedTime?: string;
  /** article 系ページ用: 更新日 */
  modifiedTime?: string;
}

const {
  title,
  description,
  lang = 'ja',
  image = '/og-image.png',
  ogType = 'website',
  jsonLd,
  noindex = false,
  publishedTime,
  modifiedTime,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.url);

// hreflang（英語版が存在するページのみ en を出す）
const alt = hreflangUrls(Astro.url, Astro.site);
const ogLocale = lang === 'en' ? 'en_US' : 'ja_JP';

// サイト全体で常に出す構造化データ（運営者・サイト）
const organization = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${SITE_URL}/#organization`,
  name: SITE_NAME,
  alternateName: 'Sane Design',
  description:
    '個人事業主・中小企業向けのホームページ制作と内部SEO対策を専門とするデザインスタジオ。最速3日納品・20,000円〜、DTP・WEB合わせて実績300件以上。',
  url: SITE_URL,
  image: new URL('/og-image.png', SITE_URL).href,
  priceRange: '¥20,000〜',
  areaServed: { '@type': 'Country', name: 'Japan' },
  serviceType: ['ホームページ制作', 'Web制作', 'SEO対策', 'LP制作', 'DTPデザイン'],
  knowsLanguage: ['ja'],
  sameAs: [
    'https://note.com/sane_design2026',
    'https://www.instagram.com/sane_design2023/',
    'https://x.com/sane_design',
  ],
};

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE_URL}/#website`,
  name: SITE_NAME,
  url: SITE_URL,
  inLanguage: 'ja',
  publisher: { '@id': `${SITE_URL}/#organization` },
  potentialAction: {
    '@type': 'SearchAction',
    target: `${SITE_URL}/works/?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};

const extra = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
// noindexページ（管理画面・決済）には構造化データを出さない
const graph = noindex ? [] : [organization, website, ...extra];
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />

<!-- hreflang（多言語対応ページのみ） -->
{alt.en && <link rel="alternate" hreflang="ja" href={alt.ja} />}
{alt.en && <link rel="alternate" hreflang="en" href={alt.en} />}
{alt.en && <link rel="alternate" hreflang="x-default" href={alt.ja} />}

<meta
  name="robots"
  content={noindex ? 'noindex,nofollow' : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1'}
/>

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content={ogLocale} />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />

<!-- Theme Color -->
<meta name="theme-color" content="#4FB4E8" />

<!-- JSON-LD 構造化データ -->
{graph.map((node) => (
  <script type="application/ld+json" set:html={JSON.stringify(node)} />
))}
