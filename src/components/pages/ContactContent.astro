    psSeoBadge: 'SEO', psSeoName: 'SEO Plan', psSeoDesc: '60 articles + internal SEO',
    bothNote: 'You can select both plans and combine them',
    consultName: 'Just consult for now', consultDesc: "Haven't decided on a plan? Feel free to just ask",
