---

<!-- ── Hero ── -->
<section class="ct-hero reveal">
  <div class="wrap">
    <span class="sec-sub">Contact</span>
    <div class="ct-hero-illust">
      <img src="/assets/creator_thumbsup_tablet.webp" alt={t.heroAlt}>
    </div>
    <h1>{t.h1a}<span class="big">{t.h1b}</span></h1>
    <p class="lead" set:html={t.lead}></p>
    <div class="hero-badges">
      <span class="hero-badge"><i class="ck"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg></i>{t.badge1}</span>
      <span class="hero-badge"><i class="ck"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg></i>{t.badge2}</span>
      <span class="hero-badge"><i class="ck"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg></i>{t.badge3}</span>
    </div>
  </div>
</section>

<div class="wave"><svg viewBox="0 0 1200 60" preserveAspectRatio="none"><path d="M0,60 C300,0 900,0 1200,60 L1200,0 L0,0 Z" fill="#fff"/></svg></div>

<section class="ct-form-section" style="background:var(--cream-bg)">
  <div class="wrap">
    <div class="ct-form-wrap">
      <div class="step-tabs reveal" id="stepTabs">
        <div class="step-tab active" data-step="1"><span class="st-num">1</span><span class="st-label">{t.tab1}</span></div>
        <div class="step-tab" data-step="2"><span class="st-num">2</span><span class="st-label">{t.tab2}</span></div>
        <div class="step-tab" data-step="3"><span class="st-num">3</span><span class="st-label">{t.tab3}</span></div>
      </div>

      <form id="contact-form" action="https://api.web3forms.com/submit" method="POST">
        <input type="hidden" name="access_key" value="7bcc6bbc-01d3-4a99-a783-3cdad33fbaa5">
        <input type="hidden" name="subject" value={t.subject}>
        <input type="hidden" name="from_name" value={t.fromName}>
        <input type="checkbox" name="botcheck" style="display:none">
        <input type="hidden" name="selected_plan" id="hiddenPlan" value={t.hiddenPlanDefault}>
        <input type="hidden" name="selected_options" id="hiddenOptions" value="">
        <input type="hidden" name="total_amount" id="hiddenTotal" value={t.hiddenTotalDefault}>

        <!-- STEP 1 -->
        <div class="step-panel active" id="step1">
          <div class="form-card reveal">
            <div class="form-sec-head"><h2>{t.s1h}</h2><p>{t.s1p}</p></div>

            <div class="plan-selector" id="planSelector">
              <div class="plan-sel-card active" data-plan="web" id="planCardWeb">
                <span class="ps-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg></span>
                <span class="ps-badge">{t.psWebBadge}</span>
                <span class="ps-name">{t.psWebName}</span>
                <span class="ps-price">¥20,000<small>〜</small></span>
                <span class="ps-desc">{t.psWebDesc}</span>
              </div>
              <div class="plan-sel-card" data-plan="seo" id="planCardSeo">
                <span class="ps-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg></span>
                <span class="ps-badge">{t.psSeoBadge}</span>
                <span class="ps-name">{t.psSeoName}</span>
                <span class="ps-price">¥10,000<small>〜</small></span>
                <span class="ps-desc">{t.psSeoDesc}</span>
              </div>
            </div>
            <p style="font-size:12px;color:var(--text-muted);margin-bottom:20px;margin-top:-16px;text-align:center">{t.bothNote}</p>

            <div class="consult-only-wrap">
              <div class="consult-card" id="consultCard">
                <span class="cc-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg></span>
                <span class="cc-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></span>
                <span class="cc-text">
                  <span class="cc-name">{t.consultName}</span>
                  <span class="cc-desc">{t.consultDesc}</span>
                </span>
              </div>
              <div class="consult-alert" id="consultAlert">{t.consultAlert}</div>
            </div>

            <!-- WEB panel -->
            <div class="plan-panel active" id="panelWeb">
              <div class="plan-summary">
                <span class="plan-badge">{t.webBadge}</span>
                <div class="plan-info">
                  <h3>{t.webPlanName}</h3>
                  <div style="font-size:13px;color:var(--text-muted);margin-top:2px">{t.webPlanSub}</div>
                </div>
                <div class="plan-price">¥20,000<small>〜</small></div>
              </div>

              <h4 style="font-size:15px;font-weight:900;margin-bottom:14px;display:flex;align-items:center;gap:8px">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" style="width:20px;height:20px;stroke-width:2.5"><path d="M12 5v14M5 12h14"/></svg>
                {t.addOptH}
              </h4>
              <p style="font-size:13px;color:var(--text-muted);margin-bottom:16px">{t.addOptP}</p>

              <div class="opt-grid" id="optGrid">
                <div class="opt-item opt-page-add" data-price="0" id="optPageAdd">
                  <div class="opt-row">
                    <span class="opt-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg></span>
                    <span class="opt-info"><span class="opt-name">{t.pageAddName}</span><span class="opt-price">{t.pageAddPrice}</span></span>
                  </div>
                  <select id="pageAddSelect" class="opt-select">
                    {t.pageAddOpts.map((o, i) => (<option value={String(i)}>{o}</option>))}
                  </select>
                </div>
                {t.webOpts.map((o) => (
                  <label class="opt-item" data-price={o.p} data-name={o.name}>
                    <input type="checkbox"><span class="opt-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg></span>
                    <span class="opt-info"><span class="opt-name">{o.name}</span><span class="opt-price">{o.disp}</span></span>
                  </label>
                ))}
                <div class="opt-item" data-price="10000" data-name={t.dashName}>
                  <label style="display:flex;align-items:center;gap:12px;cursor:pointer;flex:1">
                    <input type="checkbox"><span class="opt-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg></span>
                    <span class="opt-info"><span class="opt-name">{t.dashName}</span><span class="opt-price">{t.dashDisp}</span></span>
                  </label>
                  <div class="opt-tip-wrap">
                    <button type="button" class="opt-tip-btn" aria-label="info"><svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-1-5h2v2h-2zm0-8h2v6h-2z"/></svg></button>
                    <div class="opt-tip-popup">{t.dashTip}</div>
                  </div>
                </div>
              </div>
              <div class="scroll-hint" id="scrollHint" style="text-align:center;font-size:12px;color:var(--text-muted);padding:8px 0;display:flex;align-items:center;justify-content:center;gap:6px;opacity:.7">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" style="width:16px;height:16px;stroke-width:2.5;animation:bounceDown 1.2s infinite"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
                {t.scrollHint}
              </div>
            </div>

            <!-- SEO panel -->
            <div class="plan-panel" id="panelSeo">
              <div class="plan-divider">{t.seoDivider}</div>
              <div class="plan-summary seo-summary">
                <span class="plan-badge">{t.seoBadge}</span>
                <div class="plan-info">
                  <h3>{t.seoPlanName}</h3>
                  <div style="font-size:13px;color:var(--text-muted);margin-top:2px">{t.seoPlanSub}</div>
                </div>
                <div class="plan-price">¥10,000<small>〜</small></div>
              </div>

              <h4 style="font-size:15px;font-weight:900;margin-bottom:14px;display:flex;align-items:center;gap:8px">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" style="width:20px;height:20px;stroke-width:2.5"><path d="M12 5v14M5 12h14"/></svg>
                {t.seoOptH}
              </h4>
              <p style="font-size:13px;color:var(--text-muted);margin-bottom:16px">{t.addOptP}</p>

              <div class="opt-grid" id="optGridSeo">
                <div class="opt-item opt-page-add" data-price="0" id="optArticleAdd">
                  <div class="opt-row">
                    <span class="opt-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg></span>
                    <span class="opt-info"><span class="opt-name">{t.articleAddName}</span><span class="opt-price">{t.articleAddPrice}</span></span>
                  </div>
                  <select id="articleAddSelect" class="opt-select">
                    {t.articleAddOpts.map((o, i) => (<option value={String(i)}>{o}</option>))}
                  </select>
                </div>
                {t.seoOpts.map((o) => (
                  <label class="opt-item" data-price={o.p} data-name={o.name}>
                    <input type="checkbox"><span class="opt-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg></span>
                    <span class="opt-info"><span class="opt-name">{o.name}</span><span class="opt-price">{o.disp}</span></span>
                  </label>
                ))}
              </div>
            </div>

            <div class="total-bar" id="totalBar">
              <div class="total-label">{t.totalLabel}<small>{t.totalSub}</small></div>
              <div class="total-price"><span class="yen">¥</span><span id="totalAmount">20,000</span><small>{t.totalTax}</small></div>
            </div>

            <p style="font-size:12px;color:var(--text-muted);margin-top:12px;line-height:1.7;text-align:center">{t.priceNote}</p>

            <div class="step-nav">
              <span></span>
              <button type="button" class="btn btn-primary" id="toStep2">
                {t.toStep2}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </button>
            </div>
          </div>
        </div>

        <!-- STEP 2 -->
        <div class="step-panel" id="step2">
          <div class="form-card reveal">
            <div class="form-sec-head"><h2>{t.s2h}</h2><p>{t.s2p}</p></div>

            <div class="selected-summary" id="selectedSummary">
              <h4>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                {t.selectedH}
              </h4>
              <div class="selected-list" id="selectedList"></div>
            </div>

            <div class="form-group">
              <label>{t.fName}<span class="req">{t.fReq}</span></label>
              <input type="text" name="name" required placeholder={t.fNamePh} class="form-input">
            </div>
            <div class="form-group">
              <label>{t.fEmail}<span class="req">{t.fReq}</span></label>
              <input type="email" name="email" required placeholder="your@email.com" class="form-input">
            </div>
            <div class="form-group">
              <label>{t.fPhone}<small style="font-weight:400;color:var(--text-muted);margin-left:6px">{t.fPhoneOpt}</small></label>
              <input type="tel" name="phone" placeholder="090-1234-5678" class="form-input">
            </div>
            <div class="form-group">
              <label>{t.fServiceLabel}</label>
              <select name="service" class="form-input" style="cursor:pointer">
                <option value="">{t.fServicePh}</option>
                {t.fServices.map((s) => (<option value={s}>{s}</option>))}
              </select>
            </div>
            <div class="form-group">
              <label>{t.fMsg}<span class="req">{t.fReq}</span></label>
              <textarea name="message" required rows="5" placeholder={t.fMsgPh} class="form-input"></textarea>
            </div>

            <div id="formError" class="error-msg"></div>

            <div class="step-nav">
              <button type="button" class="btn btn-ghost" id="backToStep1">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" style="transform:rotate(180deg)"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                {t.backToStep1}
              </button>
              <button type="submit" class="btn btn-primary" id="submitBtn">
                {t.submitLabel}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </button>
            </div>
          </div>
        </div>

        <!-- STEP 3 -->
        <div class="step-panel" id="step3">
          <div class="confirm-card reveal">
            <div class="check-circle">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg>
            </div>
            <h2>{t.s3h}</h2>
            <p set:html={t.s3p}></p>
            <div style="margin-top:28px">
              <a href={homeHref} class="btn btn-ghost">{t.backHome}</a>
            </div>
          </div>
        </div>
      </form>

    </div>
  </div>
</section>

