<script define:vars={{ L }}>
(function(){
  var webOn=true,seoOn=false,consultOn=false;
  var planCardWeb=document.getElementById('planCardWeb'),planCardSeo=document.getElementById('planCardSeo');
  var consultCard=document.getElementById('consultCard'),consultAlert=document.getElementById('consultAlert');
  var panelWeb=document.getElementById('panelWeb'),panelSeo=document.getElementById('panelSeo');
  var totalBar=document.getElementById('totalBar'),toStep2Btn=document.getElementById('toStep2');

  function syncPlanUI(){
    planCardWeb.classList.toggle('active',webOn);planCardSeo.classList.toggle('active',seoOn);consultCard.classList.toggle('active',consultOn);
    panelWeb.classList.toggle('active',webOn);panelSeo.classList.toggle('active',seoOn);
    totalBar.style.display=consultOn?'none':'';toStep2Btn.disabled=!(webOn||seoOn||consultOn);calcTotal();
  }
  function clearConsultAlert(){consultAlert.classList.remove('show');}

  planCardWeb.addEventListener('click',function(){clearConsultAlert();if(consultOn){consultOn=false;webOn=true;syncPlanUI();return;}webOn=!webOn;syncPlanUI();});
  planCardSeo.addEventListener('click',function(){clearConsultAlert();if(consultOn){consultOn=false;seoOn=true;syncPlanUI();return;}seoOn=!seoOn;syncPlanUI();});
  consultCard.addEventListener('click',function(){
    if(consultOn){consultOn=false;webOn=true;clearConsultAlert();syncPlanUI();return;}
    if(webOn||seoOn){consultAlert.classList.add('show');setTimeout(function(){consultAlert.classList.remove('show');},5000);return;}
    consultOn=true;clearConsultAlert();syncPlanUI();
  });

  var WEB_BASE=20000,SEO_BASE=10000,PAGE_UNIT=5000,ARTICLE_UNIT=3000;
  var optGrid=document.getElementById('optGrid'),optGridSeo=document.getElementById('optGridSeo');
  var totalEl=document.getElementById('totalAmount');
  var pageSelect=document.getElementById('pageAddSelect'),pageAddItem=document.getElementById('optPageAdd');
  var articleSelect=document.getElementById('articleAddSelect'),articleAddItem=document.getElementById('optArticleAdd');

  function fmt(n){return n.toLocaleString(L.locale);}

  function calcTotal(){
    if(consultOn){totalEl.textContent='—';updateHiddenFields(0);return;}
    var total=0;
    if(webOn){
      total+=WEB_BASE;
      optGrid.querySelectorAll('.opt-item:not(.opt-page-add)').forEach(function(item){
        var cb=item.querySelector('input[type=checkbox]');
        if(cb&&cb.checked){item.classList.add('is-on');total+=parseInt(item.getAttribute('data-price'),10)||0;}
        else{item.classList.remove('is-on');}
      });
      var pages=parseInt(pageSelect.value,10)||0;total+=pages*PAGE_UNIT;pageAddItem.classList.toggle('is-on',pages>0);
    }
    if(seoOn){
      total+=SEO_BASE;
      optGridSeo.querySelectorAll('.opt-item:not(.opt-page-add)').forEach(function(item){
        var cb=item.querySelector('input[type=checkbox]');
        if(cb&&cb.checked){item.classList.add('is-on');total+=parseInt(item.getAttribute('data-price'),10)||0;}
        else{item.classList.remove('is-on');}
      });
      var articles=parseInt(articleSelect.value,10)||0;total+=articles*ARTICLE_UNIT;articleAddItem.classList.toggle('is-on',articles>0);
    }
    totalEl.textContent=fmt(total);
    totalBar.style.transform='scale(1.02)';totalBar.style.transition='transform .18s cubic-bezier(.34,1.4,.64,1)';
    setTimeout(function(){totalBar.style.transform='';},200);
    updateHiddenFields(total);
  }

  optGrid.addEventListener('change',calcTotal);optGridSeo.addEventListener('change',calcTotal);
  pageAddItem.querySelector('.opt-row').addEventListener('click',function(){pageSelect.focus();});
  articleAddItem.querySelector('.opt-row').addEventListener('click',function(){articleSelect.focus();});

  document.querySelectorAll('.opt-tip-btn').forEach(function(btn){
    btn.addEventListener('click',function(e){
      e.preventDefault();e.stopPropagation();
      var wrap=btn.closest('.opt-tip-wrap'),open=wrap.classList.contains('is-open');
      document.querySelectorAll('.opt-tip-wrap.is-open').forEach(function(w){w.classList.remove('is-open');});
      if(!open)wrap.classList.add('is-open');
    });
  });
  document.addEventListener('click',function(){document.querySelectorAll('.opt-tip-wrap.is-open').forEach(function(w){w.classList.remove('is-open');});});

  function updateHiddenFields(total){
    if(consultOn){document.getElementById('hiddenPlan').value=L.consultPlan;document.getElementById('hiddenOptions').value=L.optNone;document.getElementById('hiddenTotal').value=L.totalTbd;return;}
    var plans=[],opts=[];
    if(webOn){
      plans.push(L.webPlanFull);
      var pages=parseInt(pageSelect.value,10)||0;
      if(pages>0)opts.push(L.tagWeb+L.pageAddWord+pages+L.pUnit+' ('+fmt(pages*PAGE_UNIT)+L.yen+')');
      optGrid.querySelectorAll('.opt-item:not(.opt-page-add)').forEach(function(item){var cb=item.querySelector('input[type=checkbox]');if(cb&&cb.checked){var name=item.getAttribute('data-name')||item.querySelector('.opt-name').textContent;var price=item.getAttribute('data-price');opts.push(L.tagWeb+name+' (+'+fmt(parseInt(price,10))+L.yen+')');}});
    }
    if(seoOn){
      plans.push(L.seoPlanFull);
      var articles=parseInt(articleSelect.value,10)||0;
      if(articles>0)opts.push(L.tagSeo+L.articleAddWord+(articles*10)+L.articleUnit+' ('+fmt(articles*ARTICLE_UNIT)+L.yen+')');
      optGridSeo.querySelectorAll('.opt-item:not(.opt-page-add)').forEach(function(item){var cb=item.querySelector('input[type=checkbox]');if(cb&&cb.checked){var name=item.getAttribute('data-name')||item.querySelector('.opt-name').textContent;var price=item.getAttribute('data-price');opts.push(L.tagSeo+name+' (+'+fmt(parseInt(price,10))+L.yen+')');}});
    }
    document.getElementById('hiddenPlan').value=plans.join(' + ');
    document.getElementById('hiddenOptions').value=opts.length?opts.join(' / '):L.optNone;
    document.getElementById('hiddenTotal').value='¥'+fmt(total)+L.tilde;
  }

  var currentStep=1,step1=document.getElementById('step1'),step2=document.getElementById('step2'),step3=document.getElementById('step3');
  var tabs=document.querySelectorAll('.step-tab');

  function goToStep(n){
    currentStep=n;step1.classList.toggle('active',n===1);step2.classList.toggle('active',n===2);step3.classList.toggle('active',n===3);
    tabs.forEach(function(tb){var s=parseInt(tb.getAttribute('data-step'),10);tb.classList.remove('active','done');if(s===n)tb.classList.add('active');else if(s<n)tb.classList.add('done');});
    window.scrollTo({top:document.getElementById('stepTabs').offsetTop-90,behavior:'smooth'});
    var panel=document.getElementById('step'+n);panel.querySelectorAll('.reveal:not(.visible)').forEach(function(c){setTimeout(function(){c.classList.add('visible');},100);});
  }

  toStep2Btn.addEventListener('click',function(){if(!webOn&&!seoOn&&!consultOn)return;buildSelectedSummary();goToStep(2);});
  document.getElementById('backToStep1').addEventListener('click',function(){goToStep(1);});

  function buildSelectedSummary(){
    var list=document.getElementById('selectedList');list.innerHTML='';var total=0;
    if(consultOn){
      var cr=document.createElement('div');cr.className='sel-row';cr.innerHTML='<span class="sel-name" style="font-weight:700;color:#9b59b6">'+L.consultPlan+'</span><span class="sel-price" style="color:#9b59b6">—</span>';list.appendChild(cr);
      var tr0=document.createElement('div');tr0.className='sel-total';tr0.innerHTML='<span>'+L.summaryTotal+'</span><span style="color:#9b59b6">'+L.quoteOnRequest+'</span>';list.appendChild(tr0);return;
    }
    if(webOn){
      var hdr=document.createElement('div');hdr.className='sel-row';hdr.style.borderBottom='2px solid var(--primary)';hdr.style.marginBottom='4px';hdr.style.paddingBottom='6px';
      hdr.innerHTML='<span class="sel-name" style="font-weight:700;color:var(--primary)">'+L.webPlanBasic+'</span><span class="sel-price">¥'+fmt(WEB_BASE)+'</span>';list.appendChild(hdr);total+=WEB_BASE;
      var pages=parseInt(pageSelect.value,10)||0;
      if(pages>0){var p=pages*PAGE_UNIT;total+=p;var r=document.createElement('div');r.className='sel-row';r.innerHTML='<span class="sel-name">'+L.pageAddShort+pages+L.pUnit+'</span><span class="sel-price">+ ¥'+fmt(p)+'</span>';list.appendChild(r);}
      optGrid.querySelectorAll('.opt-item:not(.opt-page-add)').forEach(function(item){var cb=item.querySelector('input[type=checkbox]');if(cb&&cb.checked){var name=item.getAttribute('data-name')||item.querySelector('.opt-name').textContent;var price=parseInt(item.getAttribute('data-price'),10)||0;total+=price;var r2=document.createElement('div');r2.className='sel-row';r2.innerHTML='<span class="sel-name">  '+name+'</span><span class="sel-price">+ ¥'+fmt(price)+'</span>';list.appendChild(r2);}});
    }
    if(seoOn){
      if(webOn){var sep=document.createElement('div');sep.style.cssText='height:1px;background:#e2e6ed;margin:10px 0;';list.appendChild(sep);}
      var hdr2=document.createElement('div');hdr2.className='sel-row';hdr2.style.borderBottom='2px solid var(--success)';hdr2.style.marginBottom='4px';hdr2.style.paddingBottom='6px';
      hdr2.innerHTML='<span class="sel-name" style="font-weight:700;color:var(--success)">'+L.seoPlanBasic+'</span><span class="sel-price">¥'+fmt(SEO_BASE)+'</span>';list.appendChild(hdr2);total+=SEO_BASE;
      var articles=parseInt(articleSelect.value,10)||0;
      if(articles>0){var a=articles*ARTICLE_UNIT;total+=a;var ra=document.createElement('div');ra.className='sel-row';ra.innerHTML='<span class="sel-name">'+L.articleAddShort+(articles*10)+L.articleUnit+'</span><span class="sel-price">+ ¥'+fmt(a)+'</span>';list.appendChild(ra);}
      optGridSeo.querySelectorAll('.opt-item:not(.opt-page-add)').forEach(function(item){var cb=item.querySelector('input[type=checkbox]');if(cb&&cb.checked){var name=item.getAttribute('data-name')||item.querySelector('.opt-name').textContent;var price=parseInt(item.getAttribute('data-price'),10)||0;total+=price;var r2=document.createElement('div');r2.className='sel-row';r2.innerHTML='<span class="sel-name">  '+name+'</span><span class="sel-price">+ ¥'+fmt(price)+'</span>';list.appendChild(r2);}});
    }
    var tr=document.createElement('div');tr.className='sel-total';tr.innerHTML='<span>'+L.summaryTotal+'</span><span style="color:var(--primary)">¥'+fmt(total)+L.tilde+'</span>';list.appendChild(tr);
  }

  var form=document.getElementById('contact-form'),submitBtn=document.getElementById('submitBtn'),errorEl=document.getElementById('formError');
  form.addEventListener('submit',function(e){
    e.preventDefault();errorEl.style.display='none';submitBtn.disabled=true;
    submitBtn.querySelector('svg').style.display='none';submitBtn.childNodes[0].textContent=L.sending;
    fetch('https://api.web3forms.com/submit',{method:'POST',body:new FormData(form),headers:{'Accept':'application/json'}})
    .then(function(res){return res.json().then(function(json){return{ok:res.ok,json:json};});})
    .then(function(data){if(data.ok&&data.json.success){goToStep(3);}else{throw new Error('fail');}})
    .catch(function(){errorEl.textContent=L.error;errorEl.style.display='block';})
    .finally(function(){submitBtn.disabled=false;submitBtn.childNodes[0].textContent=L.submitLabel;if(submitBtn.querySelector('svg'))submitBtn.querySelector('svg').style.display='';});
  });

  var scrollHint=document.getElementById('scrollHint');
  optGrid.addEventListener('scroll',function(){var atBottom=optGrid.scrollTop+optGrid.clientHeight>=optGrid.scrollHeight-10;if(scrollHint)scrollHint.style.display=atBottom?'none':'flex';});
  calcTotal();
})();
</script>
