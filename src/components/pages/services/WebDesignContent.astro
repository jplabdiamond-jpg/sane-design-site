<script>
// ── Form typing animation (looping) ──
function typeInField(fieldId, callback) {
  var wrapper = document.getElementById(fieldId);
  if (!wrapper) { callback && callback(); return; }
  var span = wrapper.querySelector('.typed-text');
  if (!span) { callback && callback(); return; }
  var text = span.getAttribute('data-text') || '';
  span.textContent = '';
  var cursor = document.createElement('span');
  cursor.className = 'cursor';
  wrapper.classList.add('active');
  wrapper.appendChild(cursor);
  var i = 0;
  var speed = 70;
  function type() {
    if (i < text.length) {
      span.textContent += text.charAt(i);
      i++;
      setTimeout(type, speed + Math.random() * 40);
    } else {
      wrapper.classList.remove('active');
      cursor.remove();
      setTimeout(function(){ callback && callback(); }, 300);
    }
  }
  type();
}

function resetFormFields() {
  ['fi1','fi2','fi3','fi4'].forEach(function(id) {
    var w = document.getElementById(id);
    if (w) {
      var span = w.querySelector('.typed-text');
      if (span) span.textContent = '';
      w.classList.remove('active');
      var cur = w.querySelector('.cursor');
      if (cur) cur.remove();
    }
  });
  var btn = document.getElementById('formSubmitBtn');
  if (btn) btn.style.opacity = '0';
}

function runFormLoop() {
  resetFormFields();
  setTimeout(function() {
    typeInField('fi1', function() {
      typeInField('fi2', function() {
        typeInField('fi3', function() {
          typeInField('fi4', function() {
            var btn = document.getElementById('formSubmitBtn');
            if (btn) btn.style.opacity = '1';
            setTimeout(runFormLoop, 3000);
          });
        });
      });
    });
  }, 600);
}

// ── LINE chat animation (looping) ──
function resetLineChat() {
  var msgs = document.querySelectorAll('.line-msg');
  msgs.forEach(function(m) { m.classList.remove('line-show'); });
  var time = document.querySelector('.line-time');
  if (time) time.classList.remove('line-show');
}

function runLineLoop() {
  resetLineChat();
  var msg1 = document.querySelector('.line-msg.m1');
  var msg3 = document.querySelector('.line-msg.m3');
  var msg2 = document.querySelector('.line-msg.m2');
  var time = document.querySelector('.line-time');
  setTimeout(function() {
    if (msg1) msg1.classList.add('line-show');
    setTimeout(function() {
      if (msg3) msg3.classList.add('line-show');
      setTimeout(function() {
        if (msg2) msg2.classList.add('line-show');
        setTimeout(function() {
          if (time) time.classList.add('line-show');
          setTimeout(runLineLoop, 3000);
        }, 600);
      }, 1800);
    }, 1400);
  }, 1000);
}

function startStep1Animations() {
  var formMock = document.querySelector('.form-mock');
  var lineChat = document.querySelector('.line-chat');
  if (!formMock && !lineChat) return;
  var target = formMock || lineChat;
  var obs = new IntersectionObserver(function(entries) {
    entries.forEach(function(e) {
      if (e.isIntersecting) {
        obs.unobserve(e.target);
        runFormLoop();
        runLineLoop();
      }
    });
  }, { threshold: 0.2 });
  obs.observe(target);
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', startStep1Animations);
} else {
  startStep1Animations();
}

// ── STEP 02 animations ──
function startStep2Animation() {
  var hearingList = document.getElementById('hearingList');
  if (hearingList) {
    var obs1 = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) {
        if (e.isIntersecting) {
          obs1.unobserve(e.target);
          var items = hearingList.querySelectorAll('.hearing-item');
          items.forEach(function(item, i) {
            setTimeout(function() { item.classList.add('show'); }, 400 + i * 350);
          });
        }
      });
    }, { threshold: 0.3 });
    obs1.observe(hearingList);
  }
  var shareFiles = document.getElementById('shareFiles');
  if (shareFiles) {
    var obs2 = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) {
        if (e.isIntersecting) {
          obs2.unobserve(e.target);
          var files = shareFiles.querySelectorAll('.share-file');
          files.forEach(function(file, i) {
            setTimeout(function() { file.classList.add('show'); }, 600 + i * 400);
          });
        }
      });
    }, { threshold: 0.3 });
    obs2.observe(shareFiles);
  }
}
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', startStep2Animation);
} else {
  startStep2Animation();
}

// ── STEP 03 animations ──
function startStep3Animation() {
  var dp = document.getElementById('designPreview');
  if (dp) {
    var obs3a = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) {
        if (e.isIntersecting) {
          obs3a.unobserve(e.target);
          var blocks = dp.querySelectorAll('.dp-block');
          blocks.forEach(function(b, i) {
            setTimeout(function() { b.classList.add('show'); }, 500 + i * 300);
          });
          var cards = dp.querySelectorAll('.dp-card');
          cards.forEach(function(c, i) {
            setTimeout(function() { c.classList.add('show'); }, 1800 + i * 250);
          });
        }
      });
    }, { threshold: 0.3 });
    obs3a.observe(dp);
  }
  var pt = document.getElementById('progressTimeline');
  if (pt) {
    var obs3b = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) {
        if (e.isIntersecting) {
          obs3b.unobserve(e.target);
          var items = pt.querySelectorAll('.tl-item');
          items.forEach(function(item, i) {
            setTimeout(function() { item.classList.add('show'); }, 400 + i * 400);
          });
        }
      });
    }, { threshold: 0.3 });
    obs3b.observe(pt);
  }
}
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', startStep3Animation);
} else {
  startStep3Animation();
}

// ── STEP 04 animations ──
function startStep4Animation() {
  var fb = document.getElementById('feedbackMock');
  if (fb) {
    var obs4a = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) {
        if (e.isIntersecting) {
          obs4a.unobserve(e.target);
          var msgs = fb.querySelectorAll('.fb-msg');
          msgs.forEach(function(msg, i) {
            setTimeout(function() { msg.classList.add('show'); }, 400 + i * 600);
          });
        }
      });
    }, { threshold: 0.3 });
    obs4a.observe(fb);
  }
}
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', startStep4Animation);
} else {
  startStep4Animation();
}

// ── Performance count-up & bounce ──
function startPerfAnimations() {
  var perfGrid = document.querySelector('.perf-grid');
  if (!perfGrid) return;
  var perfObs = new IntersectionObserver(function(entries) {
    entries.forEach(function(e) {
      if (e.isIntersecting) {
        perfObs.unobserve(e.target);
        var counters = perfGrid.querySelectorAll('.perf-count');
        counters.forEach(function(el) {
          var target = parseInt(el.getAttribute('data-target'));
          var duration = 1500;
          var startTime = null;
          function step(timestamp) {
            if (!startTime) startTime = timestamp;
            var progress = Math.min((timestamp - startTime) / duration, 1);
            var eased = 1 - Math.pow(1 - progress, 3);
            el.textContent = Math.floor(eased * target);
            if (progress < 1) requestAnimationFrame(step);
            else el.textContent = target;
          }
          requestAnimationFrame(step);
        });
        var bounceEls = perfGrid.querySelectorAll('.perf-bounce');
        bounceEls.forEach(function(el) {
          setTimeout(function() { el.classList.add('active'); }, 300);
        });
      }
    });
  }, { threshold: 0.3 });
  perfObs.observe(perfGrid);
}
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', startPerfAnimations);
} else {
  startPerfAnimations();
}
</script>
