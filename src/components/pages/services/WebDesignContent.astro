---

<!-- ═══ 01 HERO ═══ -->
<section class="wd-hero reveal">
  <div class="wrap">
    <span class="sec-sub">Web Design</span>
    <h1 set:html={t.h1}></h1>
    <img class="hero-top-img" src="/assets/webdesign_page_top.webp" alt={t.heroImgAlt}>
    <p class="lead" set:html={t.lead}></p>
    <div style="display:flex;gap:16px;flex-wrap:wrap;justify-content:center">
      <a href={lp('/contact/')} class="btn btn-primary">{t.ctaConsult}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
      <a href={lp('/payment/')} class="btn btn-ghost">{t.ctaOrder}</a>
    </div>
    <div class="hero-badges">
      <span class="hero-badge"><i class="ck"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg></i>{t.badge1}</span>
      <span class="hero-badge"><i class="ck"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg></i>{t.badge2}</span>
      <span class="hero-badge"><i class="ck"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg></i>{t.badge3}</span>
    </div>
    <div class="spec-strip">
      <div class="spec-item"><div class="lbl-top">{t.spec1t}</div><div class="big"><span class="num">¥20,000</span>〜</div><div class="lbl">{t.spec1b}</div></div>
      <div class="spec-item"><div class="lbl-top">{t.spec2t}</div><div class="big">{t.spec2pre}<span class="num">3</span>{t.spec2post}</div><div class="lbl">{t.spec2b}</div></div>
      <div class="spec-item"><div class="lbl-top">{t.spec3t}</div><div class="big">{t.spec3pre}<span class="num">4</span>{t.spec3post}</div><div class="lbl">{t.spec3b}</div></div>
      <div class="spec-item"><div class="lbl-top">{t.spec4t}</div><div class="big" style="font-size:20px;padding-top:4px">{t.spec4big}</div><div class="lbl">{t.spec4b}</div></div>
    </div>
  </div>
</section>

<!-- ═══ 02 こんな方におすすめ ═══ -->
<section class="cream" style="padding-top:60px">
  <div class="wave top"><svg viewBox="0 0 1200 60" preserveAspectRatio="none"><path d="M0,60 C300,0 900,0 1200,60 L1200,0 L0,0 Z" fill="#fff"/></svg></div>
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="sec-sub">Recommend</span>
      <h2 class="sec-title">{t.recTitlePre}<span class="mk">{t.recTitleMk}</span><small>{t.recSub}</small></h2>
    </div>
    <div class="recommend-grid">
      <div class="rec-card reveal">
        <div class="rec-illust-wrap">
          <div class="rec-bubble bl">{t.rec1bubble}</div>
          <img loading="lazy" class="rec-illust rec-illust-1" src="/assets/webdesign_page_recommend1.webp" alt={t.rec1alt}>
        </div>
        <h4 set:html={t.rec1h}></h4>
        <p>{t.rec1p}</p>
      </div>
      <div class="rec-card reveal">
        <div class="rec-illust-wrap">
          <div class="rec-bubble br">{t.rec2bubble}</div>
          <img loading="lazy" class="rec-illust rec-illust-2" src="/assets/webdesign_page_recommend2.webp" alt={t.rec2alt}>
        </div>
        <h4 set:html={t.rec2h}></h4>
        <p>{t.rec2p}</p>
      </div>
      <div class="rec-card reveal">
        <div class="rec-illust-wrap">
          <div class="rec-bubble bl">{t.rec3bubble}</div>
          <img loading="lazy" class="rec-illust rec-illust-3" src="/assets/webdesign_page_recommend3.webp" alt={t.rec3alt}>
        </div>
        <h4 set:html={t.rec3h}></h4>
        <p>{t.rec3p}</p>
      </div>
      <div class="rec-card reveal">
        <div class="rec-illust-wrap">
          <div class="rec-bubble br">{t.rec4bubble}</div>
          <img loading="lazy" class="rec-illust rec-illust-4" src="/assets/webdesign_page_recommend4.webp" alt={t.rec4alt}>
        </div>
        <h4 set:html={t.rec4h}></h4>
        <p>{t.rec4p}</p>
      </div>
    </div>
  </div>
</section>

<!-- ═══ 03 制作の流れ ═══ -->
<section class="mint">
  <div class="wave top"><svg viewBox="0 0 1200 60" preserveAspectRatio="none"><path d="M0,60 C300,0 900,0 1200,60 L1200,0 L0,0 Z" fill="var(--cream-bg)"/></svg></div>
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="sec-sub">Flow</span>
      <h2 class="sec-title">{t.flowTitlePre}<span class="mk">{t.flowTitleMk}</span><small>{t.flowSub}</small></h2>
    </div>
    <div class="flow-grid">
      <!-- STEP 01 -->
      <div class="step reveal" style="grid-column:1/-1">
        <span class="st">STEP 01</span>
        <div class="step1-layout">
          <div class="step1-center">
            <div class="step-heading"><h4>{t.s1h}</h4><p set:html={t.s1p}></p></div>
            <img loading="lazy" src="/assets/webdesign_page_step1b.webp" alt={t.s1imgAlt}>
          </div>
          <div class="form-mock">
            <div class="form-mock-header"><h5>{t.fmH}</h5><p>{t.fmP}</p></div>
            <div class="form-mock-body">
              <div class="form-field"><div class="form-label">{t.fmName} <span class="req">{t.fmReq}</span></div><div class="form-input" id="fi1"><span class="typed-text" data-text={t.fmNameVal}></span></div></div>
              <div class="form-field"><div class="form-label">{t.fmEmail} <span class="req">{t.fmReq}</span></div><div class="form-input" id="fi2"><span class="typed-text" data-text="hanako@example.com"></span></div></div>
              <div class="form-field"><div class="form-label">{t.fmTel} <span class="req" style="color:var(--sub);font-weight:400">{t.fmTelOpt}</span></div><div class="form-input" id="fi3"><span class="typed-text" data-text="090-1234-5678"></span></div></div>
              <div class="form-field"><div class="form-label">{t.fmMsg} <span class="req">{t.fmReq}</span></div><div class="form-input" id="fi4" style="min-height:48px"><span class="typed-text" data-text={t.fmMsgVal}></span></div></div>
              <button class="form-btn" id="formSubmitBtn">{t.fmBtn}</button>
            </div>
          </div>
          <div class="line-chat">
            <div class="line-header"><div class="line-header-icon">SD</div><div class="line-header-name">Sane Design</div></div>
            <div class="line-body">
              <div class="line-msg left m1">{t.line1}</div>
              <div class="line-msg left m3">{t.line3}</div>
              <div class="line-msg right m2">{t.line2}</div>
              <div class="line-time">{t.lineTime}</div>
            </div>
          </div>
        </div>
      </div>
      <!-- STEP 02 -->
      <div class="step reveal" style="grid-column:1/-1">
        <span class="st">STEP 02</span>
        <div class="step2-layout">
          <div class="hearing-list">
            <div class="hearing-list-header"><h5>{t.hlH}</h5></div>
            <div class="hearing-list-body" id="hearingList">
              {t.hl.map((h) => (<div class="hearing-item"><span class="hi-icon">✓</span><span>{h}</span></div>))}
            </div>
          </div>
          <div>
            <div class="share-mock">
              <div class="share-mock-header"><h5>{t.shH}</h5></div>
              <div class="share-mock-body" id="shareFiles">
                {t.shFiles.map((f, i) => (
                  <div class="share-file"><div class={`share-file-icon ${['img','doc','ref','img'][i]}`}>{['🖼️','📄','🔗','📸'][i]}</div><div class="share-file-info"><div class="share-file-name">{f[0]}</div><div class="share-file-size">{f[1]}</div></div></div>
                ))}
              </div>
            </div>
            <p style="font-size:10px;color:var(--orange);font-weight:700;margin-top:10px;line-height:1.5;text-align:center">{t.shNote}</p>
          </div>
          <div class="step2-center">
            <div class="step-heading"><h4>{t.s2h}</h4><p set:html={t.s2p}></p></div>
            <img loading="lazy" src="/assets/webdesign_page_step2.webp" alt={t.s2imgAlt}>
          </div>
        </div>
      </div>
      <!-- STEP 03 -->
      <div class="step reveal" style="grid-column:1/-1">
        <span class="st">STEP 03</span>
        <div class="step3-layout">
          <div class="step3-center">
            <div class="step-heading"><h4>{t.s3h}</h4><p set:html={t.s3p}></p></div>
            <img loading="lazy" src="/assets/webdesign_page_step3.webp" alt={t.s3imgAlt}>
          </div>
          <div class="design-preview">
            <div class="design-preview-header"><div class="dots"><span></span><span></span><span></span></div><div class="url-bar">nail-salon.com</div></div>
            <div class="design-preview-body" id="designPreview">
              <div class="dp-hero"><h6>{t.dpHeroH}</h6><p>{t.dpHeroP}</p></div>
              <div class="dp-content">
                <div class="dp-block w100"></div><div class="dp-block w80"></div><div class="dp-block w60"></div>
                <div class="dp-grid"><div class="dp-card"></div><div class="dp-card"></div></div>
                <div class="dp-block w40" style="margin-top:8px"></div>
              </div>
            </div>
          </div>
          <div class="progress-timeline">
            <div class="progress-timeline-header"><h5>{t.ptH}</h5></div>
            <div class="progress-timeline-body" id="progressTimeline">
              {t.pt.map((p, i) => (
                <div class="tl-item"><div class={`tl-dot ${['done','done','active','wait'][i]}`}></div><div class="tl-info"><div class="tl-label">{p[0]}</div><div class="tl-time">{p[1]}</div></div></div>
              ))}
            </div>
          </div>
        </div>
      </div>
      <!-- STEP 04 -->
      <div class="step reveal" style="grid-column:1/-1">
        <span class="st">STEP 04</span>
        <div class="step4-layout">
          <div class="feedback-mock">
            <div class="feedback-mock-header"><h5>{t.fbH}</h5></div>
            <div class="feedback-mock-body" id="feedbackMock">
              {t.fb.map((m) => (
                <div class={`fb-msg ${m[0]}`}><div class={`fb-avatar ${m[0]}`}>{m[0] === 'client' ? t.fbClient : t.fbDesigner}</div><div class="fb-bubble">{m[1]}</div><div class="fb-time">{m[2]}</div></div>
              ))}
            </div>
          </div>
          <div class="step4-right">
            <div class="step-heading"><h4>{t.s4h}</h4><p set:html={t.s4p}></p></div>
            <img loading="lazy" src="/assets/webdesign_page_step4.webp" alt={t.s4imgAlt}>
          </div>
        </div>
      </div>
      <!-- STEP 05 -->
      <div class="step reveal">
        <span class="st">STEP 05</span>
        <div class="step5-layout">
          <div class="step5-center">
            <div class="step-heading"><h4>{t.s5h}</h4><p set:html={t.s5p}></p></div>
            <img loading="lazy" src="/assets/webdesign_page_step5.webp" alt={t.s5imgAlt}>
          </div>
          <div class="step5-mock step5-phone">
            <div class="step5-mock-screen"><img loading="lazy" class="step5-mock-shot" src="/assets/webdesign_page_flow5mobile.webp" alt={t.s5phoneAlt}></div>
            <img loading="lazy" class="step5-mock-frame" src="/assets/phone_frame.webp" alt="">
          </div>
          <div class="step5-mock step5-laptop">
            <div class="step5-mock-screen"><img loading="lazy" class="step5-mock-shot" src="/assets/webdesign_page_flow5desktop.webp" alt={t.s5laptopAlt}></div>
            <img loading="lazy" class="step5-mock-frame" src="/assets/laptop_frame.webp" alt="">
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ═══ 04 サービス詳細 ═══ -->
<section>
  <div class="wave top"><svg viewBox="0 0 1200 60" preserveAspectRatio="none"><path d="M0,60 C300,0 900,0 1200,60 L1200,0 L0,0 Z" fill="var(--mint-bg)"/></svg></div>
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="sec-sub">Detail</span>
      <h2 class="sec-title" set:html={`${t.detailTitle}<small>${t.detailSub}</small>`}></h2>
    </div>
    <div class="detail-grid">
      <div class="detail-card reveal">
        <h3><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg>{t.inclH}</h3>
        <ul class="detail-list">
          {t.incl.map((it) => (
            <li><span class="ck"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg></span><span set:html={it}></span></li>
          ))}
        </ul>
      </div>
      <div class="detail-card reveal">
        <h3><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 5v14M5 12h14"/></svg>{t.optH}</h3>
        <ul class="detail-list">
          {t.opt.map((it) => (<li><span class="plus">+</span>{it}</li>))}
        </ul>
      </div>
    </div>
    <p style="text-align:center;font-size:13px;color:var(--sub);margin-top:28px;font-weight:500;line-height:1.8">{t.detailNote}</p>
  </div>
</section>

<!-- ═══ 05 パフォーマンス ═══ -->
<section class="sky">
  <div class="wave top"><svg viewBox="0 0 1200 60" preserveAspectRatio="none"><path d="M0,60 C300,0 900,0 1200,60 L1200,0 L0,0 Z" fill="#fff"/></svg></div>
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="sec-sub">Performance</span>
      <h2 class="sec-title">{t.perfTitlePre}<span class="mk">{t.perfTitleMk}</span></h2>
    </div>
    <div class="perf-grid">
      <div class="perf-card reveal">
        <span class="perf-num perf-bounce" style="font-family:'Noto Sans JP'">{t.perf1big}</span>
        <span class="perf-label">{t.perf1l}</span>
      </div>
      <div class="perf-card reveal">
        <span class="perf-num perf-count" data-target="5">0</span><span class="perf-unit">{t.perf2u}</span>
        <span class="perf-label">{t.perf2l}</span>
      </div>
      <div class="perf-card reveal">
        <span class="perf-num perf-count" data-target="300">0</span><span class="perf-unit">{t.perf3u}</span>
        <span class="perf-label">{t.perf3l}</span>
      </div>
    </div>
  </div>
</section>

<!-- ═══ 06 制作実績 ═══ -->
<section id="web-works">
  <div class="wave top"><svg viewBox="0 0 1200 60" preserveAspectRatio="none"><path d="M0,60 C300,0 900,0 1200,60 L1200,0 L0,0 Z" fill="var(--sky-bg)"/></svg></div>
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="sec-sub">Works</span>
      <h2 class="sec-title" set:html={`${t.worksTitle}<small>${t.worksSub}</small>`}></h2>
    </div>
    <div class="work-grid">
      {t.works.map((w) => (
        <a class="work reveal" href={lp(w[0])}>
          <div class="thumb"><img src={w[1]} alt={w[2]} loading="lazy"></div>
          <div class="body"><div class="tags">{w[3].map((tg) => (<span>{tg}</span>))}</div><h4>{w[4]}</h4><p>{w[5]}</p></div>
        </a>
      ))}
    </div>
    <div style="text-align:center;margin-top:36px"><a href={lp('/works/')} class="btn btn-ghost">{t.worksAll}</a></div>
  </div>
</section>

<!-- ═══ 07 CTA ═══ -->
<section class="cta-section">
  <div class="wrap" style="position:relative;z-index:2">
    <h2>{t.ctaH}</h2>
    <p class="cta-sub">{t.ctaSubBottom}</p>
    <div class="cta-btns">
      <a href={lp('/payment/')} class="btn btn-white">{t.ctaOrderBtn}</a>
      <a href={lp('/contact/') + '#contact-form'} class="btn btn-primary" style="box-shadow:0 5px 0 rgba(0,0,0,.2)">{t.ctaConsultBtn}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
    </div>
  </div>
</section>

<style is:global>
/* ══════════════════════════════════════════════
   WEB DESIGN PAGE STYLES
   ══════════════════════════════════════════════ */
:root {
  --primary:#4FB4E8; --primary-dark:#2E90C4; --primary-deep:#1c6f9c;
  --sky-bg:#E4F4FD; --cream-bg:#FFF6E0; --mint-bg:#E9F7E4; --pink-bg:#FFEFF0;
  --green:#78C25E; --green-dark:#4e8a3c;
  --yellow:#FFCF4D; --yellow-dark:#a9821f;
  --orange:#F79B3E; --orange-dark:#c76f14;
  --text:#3A4256; --sub:#7A8494;
  --white:#fff; --radius:24px; --shadow:0 10px 30px rgba(58,66,86,.08);
}
img{max-width:100%;display:block}
h1,h2,h3,h4{font-family:"Noto Sans JP",sans-serif}
.en{font-family:"Inter",sans-serif}
.wrap{max-width:1080px;margin:0 auto;padding:0 22px}
.mk{background:linear-gradient(transparent 60%, #FFE08A 60%);padding:0 2px}

/* ── Buttons ── */
.btn{display:inline-flex;align-items:center;gap:10px;font-family:"Noto Sans JP";font-weight:700;border-radius:999px;padding:16px 34px;font-size:16px;transition:.12s;cursor:pointer;border:none;position:relative;text-decoration:none;box-sizing:border-box}
.btn svg{width:18px;height:18px;stroke-width:3}
.btn-primary{background:var(--orange);color:#fff!important;box-shadow:0 5px 0 var(--orange-dark)}
.btn-primary:hover{transform:translateY(2px);box-shadow:0 3px 0 var(--orange-dark);background:var(--orange);color:#fff!important}
.btn-primary::after{display:none!important}
.btn-blue{background:var(--primary);color:#fff!important;box-shadow:0 5px 0 var(--primary-deep)}
.btn-blue:hover{transform:translateY(2px);box-shadow:0 3px 0 var(--primary-deep);background:var(--primary);color:#fff!important}
.btn-blue::after{display:none!important}
.btn-ghost{background:#fff;color:var(--primary-dark)!important;box-shadow:0 5px 0 #CDEBFA;border:2px solid #CDEBFA}
.btn-ghost:hover{transform:translateY(2px);box-shadow:0 3px 0 #CDEBFA;color:var(--primary-dark)!important;background:#fff}
.btn-ghost::after{display:none!important}
.btn-white{background:#fff;color:var(--text)!important;box-shadow:0 5px 0 #ddd;border:2px solid #eee}
.btn-white:hover{transform:translateY(2px);box-shadow:0 3px 0 #ddd;background:#fff;color:var(--text)!important}
.btn-white::after{display:none!important}

/* ── Section base ── */
section{padding:84px 0;position:relative}
.sky{background:var(--sky-bg)} .cream{background:var(--cream-bg)} .mint{background:var(--mint-bg)} .pink{background:var(--pink-bg)}
.sec-head{text-align:center;margin-bottom:48px}
.sec-sub{font-family:"Inter";font-weight:800;font-size:14px;letter-spacing:2px;color:var(--primary);text-transform:uppercase;display:block;margin-bottom:6px}
.sec-title{font-size:34px;font-weight:900;line-height:1.5}
.sec-title small{display:block;font-size:15px;color:var(--sub);font-weight:500;margin-top:12px;font-family:"Noto Sans JP"}
.wave{position:absolute;left:0;width:100%;line-height:0;z-index:1}
.wave.top{top:-1px}
.wave svg{width:100%;height:60px;display:block}

/* HERO */
.wd-hero{background:radial-gradient(120% 90% at 80% 0%,#D7EFFB 0%,#EAF7FE 45%,#fff 100%);padding:60px 0 0;text-align:center}
.wd-hero .sec-sub{margin-bottom:10px;font-size:clamp(28px,9vw,42px);letter-spacing:6px;white-space:nowrap}
.wd-hero h1{font-size:clamp(28px,4.5vw,52px);font-weight:900;line-height:1.3;letter-spacing:1px}
.wd-hero h1 .big{color:var(--primary);font-size:1.15em}
.wd-hero .lead{font-size:17px;color:#5b6474;margin:16px 0 28px;font-weight:500;line-height:1.8}
.wd-hero .hero-badges{display:flex;gap:20px;margin-top:24px;flex-wrap:wrap;justify-content:center}
.hero-badge{display:flex;align-items:center;gap:7px;font-size:13px;font-weight:700}
.hero-badge svg{width:22px;height:22px;color:#fff;background:var(--green);border-radius:50%;padding:4px;stroke-width:3;display:block}
.hero-badge .ck{position:relative;display:inline-flex;line-height:0}
.hero-top-img{width:clamp(400px,60vw,640px);margin:0 auto 24px;filter:drop-shadow(0 12px 20px rgba(58,66,86,.15))}

/* spec strip */
.spec-strip{display:grid;grid-template-columns:repeat(4,1fr);gap:0;background:#fff;border-radius:26px;box-shadow:var(--shadow);overflow:hidden;margin-top:44px}
.spec-item{text-align:center;padding:22px 14px;position:relative}
.spec-item+.spec-item{border-left:2px dashed #E7ECF2}
.spec-item .lbl-top{font-size:12px;color:var(--sub);font-weight:700;margin-bottom:4px}
.spec-item .big{font-family:"Inter";font-size:28px;font-weight:800;color:var(--primary);line-height:1.2}
.spec-item .big .num{font-size:1.3em;color:var(--orange);font-weight:800}
.spec-item .lbl{font-size:11px;color:var(--sub);margin-top:2px}

/* recommend */
.recommend-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}
.rec-card{background:#fff;border-radius:20px;padding:32px 22px;text-align:center;box-shadow:var(--shadow);transition:transform .3s ease,box-shadow .3s ease;position:relative;overflow:visible}
.rec-card:hover{transform:scale(1.5) !important;z-index:10 !important;box-shadow:0 12px 40px rgba(58,66,86,.18) !important}
.rec-icon{width:60px;height:60px;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 14px;font-size:28px}
.rec-icon.blue{background:#EAF7FE;color:var(--primary)}
.rec-icon.orange{background:#FFF0DB;color:var(--orange)}
.rec-icon.green{background:#E9F7E4;color:var(--green)}
.rec-icon.pink{background:#FFEFF0;color:#e06b7a}
.rec-card h4{font-size:16px;font-weight:900;margin-bottom:6px;line-height:1.4}
.rec-card p{font-size:13px;color:var(--sub);line-height:1.6}
.rec-illust-wrap{position:relative;display:flex;align-items:center;justify-content:center;margin-bottom:16px}
.rec-illust{height:auto;filter:drop-shadow(0 6px 12px rgba(58,66,86,.12))}
.rec-illust-1{width:200px}
.rec-illust-2{width:130px}
.rec-illust-3{width:200px}
.rec-illust-4{width:150px}

/* speech bubble on recommend cards */
.rec-bubble{position:absolute;background:#fff;border:2px solid #e0e6ed;border-radius:14px;padding:8px 14px;font-size:11px;font-weight:700;color:var(--text);line-height:1.5;white-space:nowrap;box-shadow:0 3px 10px rgba(58,66,86,.10);z-index:2;opacity:0;left:50%;transform:translate(-50%,6px);transition:opacity .6s,transform .6s}
.rec-bubble::after{content:"";position:absolute;bottom:-8px;left:50%;transform:translateX(-50%);width:0;height:0;border-left:8px solid transparent;border-right:8px solid transparent;border-top:8px solid #fff;filter:drop-shadow(0 2px 1px rgba(58,66,86,.08))}
.rec-bubble::before{content:"";position:absolute;bottom:-11px;left:50%;transform:translateX(-50%);width:0;height:0;border-left:9px solid transparent;border-right:9px solid transparent;border-top:9px solid #e0e6ed}
.rec-card.visible .rec-bubble{opacity:1;transform:translate(-50%,0);transition-delay:.5s}
.rec-bubble.bl{top:-33px}
.rec-bubble.br{top:-33px}
.rec-bubble.tl{top:-39px}

/* flow */
.flow-grid{display:grid;grid-template-columns:1fr;gap:0;row-gap:32px;counter-reset:step}
.step{text-align:center;position:relative;padding:0 12px}
.step:not(:last-child)::after{content:"";position:absolute;bottom:-22px;left:50%;width:20px;height:20px;border:0;border-bottom:3px solid var(--primary);border-right:3px solid var(--primary);transform:translateX(-50%) rotate(45deg);z-index:2}
.st{display:block;font-family:"Inter";font-size:36px;font-weight:800;letter-spacing:4px;color:var(--primary);margin-bottom:16px;text-transform:uppercase;line-height:1.2}
.step-heading{text-align:center;margin-bottom:10px}
.step-heading h4{font-size:18px;font-weight:900;margin:0}
.step-heading p{font-size:13px;color:var(--sub);line-height:1.6;margin-top:6px}
.step-content-side{display:flex;flex-direction:column;gap:16px}
.step-content-side > *{flex:1}

/* STEP 01 */
.step1-layout{display:grid;grid-template-columns:1.2fr 1fr 1fr;gap:12px;column-gap:12px;align-items:stretch;margin-top:20px;padding:32px 24px;background:#fff;border-radius:20px;box-shadow:0 8px 32px rgba(58,66,86,.08)}
.step1-center{text-align:center;display:flex;flex-direction:column;align-items:center;justify-content:center}
.step1-center img{width:220px;margin:0 auto;filter:drop-shadow(0 8px 16px rgba(58,66,86,.12))}

/* Form mock */
.form-mock{background:#fff;border-radius:14px;overflow:hidden;box-shadow:0 4px 20px rgba(58,66,86,.12);max-width:100%;margin:0 auto;border:1px solid #e8eef4;transition:transform .4s cubic-bezier(.19,1,.22,1),box-shadow .4s}
.form-mock:hover{transform:translateY(-8px);box-shadow:0 12px 36px rgba(58,66,86,.18)}
.form-mock-header{background:linear-gradient(135deg,#E4F4FD,#dde9f9);padding:14px 16px;border-bottom:1px solid #d8e4f0}
.form-mock-header h5{font-size:13px;font-weight:900;color:var(--text);margin:0}
.form-mock-header p{font-size:10px;color:var(--sub);margin:4px 0 0}
.form-mock-body{padding:14px 16px}
.form-field{margin-bottom:12px}
.form-label{font-size:10px;font-weight:700;color:var(--text);margin-bottom:4px;display:flex;align-items:center;gap:4px}
.form-label .req{color:#e05555;font-size:9px}
.form-input{width:100%;border:1.5px solid #dde4ec;border-radius:8px;padding:8px 10px;font-size:11px;color:var(--text);background:#fafbfc;font-family:"Noto Sans JP",sans-serif;position:relative;min-height:32px;overflow:hidden;transition:border-color .3s;box-sizing:border-box}
.form-input.active{border-color:var(--primary)}
.form-input .typed-text{color:var(--text)}
.form-input .cursor{display:inline-block;width:1.5px;height:13px;background:var(--primary);vertical-align:text-bottom;margin-left:1px;animation:cursorBlink .7s step-end infinite}
@keyframes cursorBlink{0%,100%{opacity:1}50%{opacity:0}}
.form-btn{display:block;width:100%;padding:10px;background:var(--orange);color:#fff;font-size:12px;font-weight:700;border:none;border-radius:999px;cursor:pointer;margin-top:14px;font-family:"Noto Sans JP";box-shadow:0 3px 0 var(--orange-dark);opacity:0;transition:opacity .4s}

/* LINE chat mock */
.line-chat{background:#8CAAD0;border-radius:14px;overflow:hidden;box-shadow:0 4px 20px rgba(58,66,86,.12);max-width:100%;margin:0 auto;transition:transform .4s cubic-bezier(.19,1,.22,1),box-shadow .4s;display:flex;flex-direction:column}
.line-chat:hover{transform:translateY(-8px);box-shadow:0 12px 36px rgba(58,66,86,.18)}
.line-header{background:#6B97C4;padding:10px 14px;display:flex;align-items:center;gap:10px}
.line-header-icon{width:32px;height:32px;border-radius:50%;background:#fff;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:700;color:#6B97C4}
.line-header-name{color:#fff;font-size:13px;font-weight:700}
.line-body{padding:16px 12px;flex:1;display:flex;flex-direction:column;gap:10px}
.line-msg{max-width:85%;padding:10px 14px;border-radius:16px;font-size:12px;line-height:1.6;opacity:0;transform:translateY(10px)}
.line-msg.left{background:#fff;color:#333;align-self:flex-start;border-bottom-left-radius:4px}
.line-msg.right{background:#78C25E;color:#fff;align-self:flex-end;border-bottom-right-radius:4px}
.line-msg.m1,.line-msg.m2,.line-msg.m3{animation:none}
.line-msg.line-show{opacity:1;transform:translateY(0);transition:opacity .5s,transform .5s}
.line-time{font-size:9px;color:rgba(255,255,255,.7);text-align:right;opacity:0;transition:opacity .3s}
.line-time.line-show{opacity:1}

/* STEP 02 */
.step2-layout{display:grid;grid-template-columns:1fr 1fr 1.2fr;gap:12px;column-gap:12px;align-items:stretch;margin-top:20px;padding:32px 24px;background:#fff;border-radius:20px;box-shadow:0 8px 32px rgba(58,66,86,.08)}
.step2-center{text-align:center;display:flex;flex-direction:column;align-items:center;justify-content:center}
.step2-center img{width:280px;margin:0 auto;filter:drop-shadow(0 8px 16px rgba(58,66,86,.12))}
.hearing-list{background:#fff;border-radius:14px;overflow:hidden;box-shadow:0 4px 20px rgba(58,66,86,.12);max-width:100%;margin:0 auto;border:1px solid #e8eef4}
.hearing-list-header{background:linear-gradient(135deg,#E9F7E4,#d8f0d0);padding:14px 16px;border-bottom:1px solid #c8e4be}
.hearing-list-header h5{font-size:13px;font-weight:900;color:var(--text);margin:0;display:flex;align-items:center;gap:6px}
.hearing-list-body{padding:14px 16px}
.hearing-item{display:flex;align-items:flex-start;gap:10px;padding:8px 0;border-bottom:1px solid #f0f0f0;font-size:12px;color:var(--text);line-height:1.5;opacity:0;transform:translateX(-10px);transition:opacity .5s,transform .5s}
.hearing-item:last-child{border-bottom:none}
