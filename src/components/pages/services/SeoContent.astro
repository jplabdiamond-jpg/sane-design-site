.seo-flow-dot{position:absolute;left:-33px;top:20px;width:16px;height:16px;border-radius:50%;background:var(--primary);border:3px solid #fff;box-shadow:0 0 0 3px var(--primary);z-index:2}
.seo-flow-dot.active{background:var(--orange);box-shadow:0 0 0 3px var(--orange);animation:dotPulse 1.5s ease infinite}
.seo-flow-dot.done{background:var(--green);box-shadow:0 0 0 3px var(--green)}
@keyframes dotPulse{0%,100%{box-shadow:0 0 0 3px var(--orange)}50%{box-shadow:0 0 0 8px rgba(247,155,62,.2)}}
.seo-flow-card{background:#fff;border-radius:16px;padding:24px 28px;box-shadow:var(--shadow);transition:transform .3s,box-shadow .3s}
