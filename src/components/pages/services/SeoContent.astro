/* ── Flow timeline ── */
.seo-flow-timeline{max-width:640px;margin:0 auto;position:relative;padding-left:40px}
.seo-flow-timeline::before{content:"";position:absolute;left:15px;top:24px;bottom:24px;width:3px;background:linear-gradient(to bottom,var(--primary),var(--green));border-radius:3px}
.seo-flow-step{position:relative;margin-bottom:28px}
