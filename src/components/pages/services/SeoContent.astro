---
// SEOサービスページ本文（日英単一ソース）。CSS/JS は元ファイルから移植。
import { localizePath } from '../../../i18n/utils';
import type { Locale } from '../../../i18n/ui';

interface Props { lang: Locale }
const { lang } = Astro.props;
const lp = (p: string) => localizePath(p, lang);

const S = {
  ja: {
    h1: '検索で<br><span class="big">見つかるサイト</span>に',
    lead: '指定キーワードに基づく厳選記事追加と内部SEO対策で、<br>あなたのサイトの検索順位向上をサポートします。',
    ctaConsult: 'まずは無料で相談する', ctaOrder: '今すぐ注文する',
    badge1: '相談だけでもOK', badge2: '1日3記事ずつ公開', badge3: '実績200件以上',
    spec1t: 'コミコミ価格', spec1b: '追加費用なし',
    spec2t: '公開ペース', spec2pre: '1日', spec2post: '記事', spec2b: 'じっくり公開',
    spec3t: '記事数', spec3post: '本', spec3b: 'キーワード厳選',
    spec4t: '納品形態', spec4big: 'テキスト / 直接UP', spec4b: 'どちらでもOK',
    recTitlePre: 'こんな方に', recTitleMk: 'おすすめ', recSub: 'ひとつでも当てはまったら、お気軽にご相談ください',
    rec1h: '着実にSEO効果を<br>出したい方', rec1p: '1日3記事ずつ計60記事を公開。検索エンジンに評価されやすいペースで着実に対策します。',
    rec2h: '記事作成の<br>リソースが不足', rec2p: '社内にライターがいなくても大丈夫。プロが60本すべて作成します。',
    rec3h: '内部対策の<br>見直しをしたい方', rec3p: 'タイトル・メタ・見出し構造・内部リンク・スキーマを徹底的に最適化。',
    rec4h: '検索順位を上げて<br>問い合わせを増やしたい', rec4p: 'コンテンツSEOと内部対策の両面から、検索流入の増加をサポートします。',
    svcTitle: 'かんたん<span class="mk">2ステップ</span>で<br>SEO対策を実装', svcSub: 'コンテンツSEOと内部対策の両面からアプローチ',
    svc1h: 'コンテンツSEO', svc1desc: '指定キーワードに基づき、検索意図を満たす記事を<strong>60本</strong>作成・追加します。',
    svc1f: ['キーワード調査・選定', '検索意図に合った記事構成', 'SEOに最適化されたライティング', '内部リンク設計'],
    svc2h: '内部SEO対策', svc2desc: 'サイト全体の技術的なSEO要素を見直し、検索エンジンに正しく評価される構造に最適化します。',
    svc2f: ['タイトルタグ・メタディスクリプション', '見出し構造（h1〜h6）最適化', '構造化データ（スキーマ）マークアップ', 'サイト内リンク構造の改善'],
    flowTitle: 'ご依頼から<span class="mk">公開まで</span>', flowSub: '1日3記事ずつ、じっくり公開していきます',
    flow1h: 'ヒアリング', flow1p: '対策したいキーワードやサイトの現状をお伺いします。お気軽にご相談ください。',
    flow2h: 'キーワード調査・記事作成', flow2p: 'ターゲットキーワードを選定し、検索意図に合った記事60本を作成します。',
    flow3h: '1日3記事ずつ公開', flow3p: '検索エンジンに評価されやすいペースで、1日3記事ずつじっくり公開していきます。',
    flow4h: '内部SEO対策＋完了', flow4p: 'タイトル・メタ・見出し・スキーマなどの内部SEO対策を実施し、すべての作業が完了します。',
    flowNote: '※ SEO対策では一度に大量の記事を公開する事はマイナス評価に繋がる可能性があるので、じっくり公開して参ります。<br>※ 検索順位への反映には通常数週間〜数ヶ月かかります。即日の順位変動を保証するものではありません。',
    detailTitle: 'サービス詳細', detailSub: '基本プランに含まれるもの・オプション',
    inclH: '含まれるもの',
    incl: ['指定キーワードに基づくブログ記事 <strong>60本</strong>作成・追加', '内部SEO対策（タイトル・メタ・見出し構造・内部リンク・スキーマ）', '実績200件以上のノウハウで対策を実施', 'キーワード調査・選定'],
    optH: 'オプション',
    opt: ['¥5,000 — サーバーへの直接アップロード（内部SEO対策実施含）', '¥5,000 — 完全オリジナル画像付き記事 60本'],
    optNote: 'ご不明点はお気軽にご相談ください。<br>キーワード選定のアドバイスも無料で承ります。',
    perfTitlePre: '選ばれる', perfTitleMk: '理由',
    perf1u: '本', perf1l: '厳選記事を追加', perf2u: '記事/日', perf2l: 'じっくり公開', perf3u: '+', perf3l: 'SEO対策実績',
    ctaH: '¥10,000〜 / 1日3記事ずつ公開', ctaSubBottom: 'フォームからお気軽にご相談ください',
    ctaOrderBtn: '今すぐ注文する →', ctaConsultBtn: 'まずは相談する',
  },
  en: {
    h1: 'Get <span class="big">found in search</span>',
    lead: "Curated articles based on your target keywords, plus internal SEO,<br>to help lift your site's search rankings.",
    ctaConsult: 'Get a free consultation', ctaOrder: 'Order now',
    badge1: 'Just a chat is fine', badge2: '3 articles per day', badge3: '200+ projects',
    spec1t: 'All-inclusive', spec1b: 'No extra fees',
    spec2t: 'Pace', spec2pre: '', spec2post: '/day', spec2b: 'Steady pace',
    spec3t: 'Articles', spec3post: ' articles', spec3b: 'Curated keywords',
    spec4t: 'Delivery', spec4big: 'Text / Direct upload', spec4b: 'Either works',
    recTitlePre: '', recTitleMk: 'Recommended for you', recSub: 'If even one applies, feel free to consult us',
    rec1h: 'Want steady<br>SEO results', rec1p: '60 articles total, 3 per day. We build steadily at a pace search engines tend to favor.',
    rec2h: 'Short on<br>writing resources', rec2p: 'No in-house writer? No problem — our pros write all 60.',
    rec3h: 'Want to revisit<br>internal SEO', rec3p: 'We thoroughly optimize titles, meta, heading structure, internal links, and schema.',
    rec4h: 'Raise rankings &<br>get more inquiries', rec4p: 'We support more search traffic from both content SEO and internal optimization.',
    svcTitle: 'SEO in <span class="mk">2 simple steps</span>', svcSub: 'Approaching from both content SEO and internal optimization',
    svc1h: 'Content SEO', svc1desc: 'We create and add <strong>60 articles</strong> that satisfy search intent, based on your target keywords.',
    svc1f: ['Keyword research & selection', 'Article structure matched to search intent', 'SEO-optimized writing', 'Internal link design'],
    svc2h: 'Internal SEO', svc2desc: 'We review technical SEO across the whole site and optimize it into a structure search engines evaluate correctly.',
    svc2f: ['Title tags & meta descriptions', 'Heading structure (h1–h6) optimization', 'Structured data (schema) markup', 'Improving internal link structure'],
    flowTitle: 'From request <span class="mk">to launch</span>', flowSub: 'We publish steadily, 3 articles per day',
    flow1h: 'Interview', flow1p: "We ask about the keywords you want to target and your site's current state. Feel free to consult us.",
    flow2h: 'Keyword research & writing', flow2p: 'We select target keywords and write 60 articles matched to search intent.',
    flow3h: 'Publish 3 articles/day', flow3p: 'At a pace search engines tend to favor, we publish 3 articles per day, steadily.',
    flow4h: 'Internal SEO + done', flow4p: 'We implement internal SEO (titles, meta, headings, schema, etc.) and complete all work.',
    flowNote: '* Publishing many articles at once can hurt SEO, so we publish steadily.<br>* Ranking changes usually take several weeks to a few months. We do not guarantee same-day changes.',
    detailTitle: 'Service details', detailSub: "What's included in the base plan, and options",
    inclH: "What's included",
    incl: ['Create & add <strong>60</strong> blog articles based on target keywords', 'Internal SEO (titles, meta, heading structure, internal links, schema)', 'Executed with know-how from 200+ projects', 'Keyword research & selection'],
    optH: 'Options',
    opt: ['¥5,000 — Direct upload to your server (includes internal SEO)', '¥5,000 — 60 articles with fully original images'],
    optNote: 'Feel free to ask any questions.<br>We also advise on keyword selection for free.',
    perfTitlePre: 'Why we are ', perfTitleMk: 'chosen',
    perf1u: ' articles', perf1l: 'Curated articles added', perf2u: ' /day', perf2l: 'Steady publishing', perf3u: '+', perf3l: 'SEO projects',
    ctaH: '¥10,000~ / 3 articles published per day', ctaSubBottom: 'Feel free to reach out via the form',
    ctaOrderBtn: 'Order now →', ctaConsultBtn: 'Get in touch',
  },
} as const;
const t = S[lang];
---

<!-- ═══ 01 HERO ═══ -->
<section class="seo-hero reveal">
  <div class="wrap">
    <span class="sec-sub">SEO</span>
    <h1 set:html={t.h1}></h1>
    <p class="lead" set:html={t.lead}></p>
    <div style="display:flex;gap:16px;flex-wrap:wrap;justify-content:center">
      <a href={lp('/contact/')} class="btn btn-primary">{t.ctaConsult}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
      <a href={lp('/payment/')} class="btn btn-ghost">{t.ctaOrder}</a>
    </div>
    <div class="hero-badges">
      <span class="hero-badge"><i class="ck"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg></i>{t.badge1}</span>
      <span class="hero-badge"><i class="ck"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg></i>{t.badge2}</span>
      <span class="hero-badge"><i class="ck"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg></i>{t.badge3}</span>
    </div>
    <div class="spec-strip">
      <div class="spec-item">
        <div class="lbl-top">{t.spec1t}</div>
        <div class="big"><span class="num">¥10,000</span>〜</div>
        <div class="lbl">{t.spec1b}</div>
      </div>
      <div class="spec-item">
        <div class="lbl-top">{t.spec2t}</div>
        <div class="big">{t.spec2pre}<span class="num">3</span>{t.spec2post}</div>
        <div class="lbl">{t.spec2b}</div>
      </div>
      <div class="spec-item">
        <div class="lbl-top">{t.spec3t}</div>
        <div class="big"><span class="num">60</span>{t.spec3post}</div>
        <div class="lbl">{t.spec3b}</div>
      </div>
      <div class="spec-item">
        <div class="lbl-top">{t.spec4t}</div>
        <div class="big" style="font-size:20px;padding-top:4px">{t.spec4big}</div>
        <div class="lbl">{t.spec4b}</div>
      </div>
    </div>
  </div>
</section>

<!-- ═══ 02 こんな方におすすめ ═══ -->
<section class="cream" style="padding-top:60px">
  <div class="wave top"><svg viewBox="0 0 1200 60" preserveAspectRatio="none"><path d="M0,60 C300,0 900,0 1200,60 L1200,0 L0,0 Z" fill="#fff"/></svg></div>
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="sec-sub">Recommend</span>
      <h2 class="sec-title">{t.recTitlePre}<span class="mk">{t.recTitleMk}</span><small>{t.recSub}</small></h2>
    </div>
    <div class="seo-recommend-grid">
      <div class="seo-rec-card reveal">
        <div class="seo-rec-icon blue">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
        </div>
        <h4 set:html={t.rec1h}></h4>
        <p>{t.rec1p}</p>
      </div>
      <div class="seo-rec-card reveal">
        <div class="seo-rec-icon orange">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4-4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
        </div>
        <h4 set:html={t.rec2h}></h4>
        <p>{t.rec2p}</p>
      </div>
      <div class="seo-rec-card reveal">
        <div class="seo-rec-icon green">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/></svg>
        </div>
        <h4 set:html={t.rec3h}></h4>
        <p>{t.rec3p}</p>
      </div>
      <div class="seo-rec-card reveal">
        <div class="seo-rec-icon pink">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
        </div>
        <h4 set:html={t.rec4h}></h4>
        <p>{t.rec4p}</p>
      </div>
    </div>
  </div>
</section>

<!-- ═══ 03 実施内容 ═══ -->
<section class="mint">
  <div class="wave top"><svg viewBox="0 0 1200 60" preserveAspectRatio="none"><path d="M0,60 C300,0 900,0 1200,60 L1200,0 L0,0 Z" fill="var(--cream-bg)"/></svg></div>
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="sec-sub">Service</span>
      <h2 class="sec-title" set:html={`${t.svcTitle}<small>${t.svcSub}</small>`}></h2>
    </div>
    <div class="seo-service-grid">
      <div class="seo-service-card reveal">
        <div class="seo-service-num">01</div>
        <div class="seo-service-body">
          <h3>{t.svc1h}</h3>
          <p class="seo-service-desc" set:html={t.svc1desc}></p>
          <div class="seo-feature-list">
            {t.svc1f.map((f) => (
              <div class="seo-feature-item">
                <span class="seo-fi-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg></span>
                <span>{f}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
      <div class="seo-service-card reveal">
        <div class="seo-service-num">02</div>
        <div class="seo-service-body">
          <h3>{t.svc2h}</h3>
          <p class="seo-service-desc">{t.svc2desc}</p>
          <div class="seo-feature-list">
            {t.svc2f.map((f) => (
              <div class="seo-feature-item">
                <span class="seo-fi-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg></span>
                <span>{f}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ═══ 04 Flow ═══ -->
<section class="sky">
  <div class="wave top"><svg viewBox="0 0 1200 60" preserveAspectRatio="none"><path d="M0,60 C300,0 900,0 1200,60 L1200,0 L0,0 Z" fill="var(--mint-bg)"/></svg></div>
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="sec-sub">Flow</span>
      <h2 class="sec-title" set:html={`${t.flowTitle}<small>${t.flowSub}</small>`}></h2>
    </div>
    <div class="seo-flow-timeline">
      <div class="seo-flow-step reveal">
        <div class="seo-flow-dot"></div>
        <div class="seo-flow-card"><span class="seo-flow-day">STEP 1</span><h4>{t.flow1h}</h4><p>{t.flow1p}</p></div>
      </div>
      <div class="seo-flow-step reveal">
        <div class="seo-flow-dot"></div>
        <div class="seo-flow-card"><span class="seo-flow-day">STEP 2</span><h4>{t.flow2h}</h4><p>{t.flow2p}</p></div>
      </div>
      <div class="seo-flow-step reveal">
        <div class="seo-flow-dot active"></div>
        <div class="seo-flow-card"><span class="seo-flow-day">STEP 3</span><h4>{t.flow3h}</h4><p>{t.flow3p}</p></div>
      </div>
      <div class="seo-flow-step reveal">
        <div class="seo-flow-dot done"></div>
        <div class="seo-flow-card"><span class="seo-flow-day">STEP 4</span><h4>{t.flow4h}</h4><p>{t.flow4p}</p></div>
      </div>
    </div>
    <p style="text-align:center;font-size:12px;color:var(--sub);margin-top:32px;font-weight:500;line-height:1.8" set:html={t.flowNote}></p>
  </div>
</section>

<!-- ═══ 05 サービス詳細 ═══ -->
<section>
  <div class="wave top"><svg viewBox="0 0 1200 60" preserveAspectRatio="none"><path d="M0,60 C300,0 900,0 1200,60 L1200,0 L0,0 Z" fill="var(--sky-bg)"/></svg></div>
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="sec-sub">Detail</span>
      <h2 class="sec-title" set:html={`${t.detailTitle}<small>${t.detailSub}</small>`}></h2>
    </div>
    <div class="detail-grid">
      <div class="detail-card reveal">
        <h3><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg>{t.inclH}</h3>
        <ul class="detail-list">
          {t.incl.map((it) => (
            <li><span class="ck"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg></span><span set:html={it}></span></li>
          ))}
        </ul>
      </div>
      <div class="detail-card reveal">
        <h3><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 5v14M5 12h14"/></svg>{t.optH}</h3>
        <ul class="detail-list">
          {t.opt.map((it) => (
            <li><span class="plus">+</span>{it}</li>
          ))}
        </ul>
        <p style="font-size:12px;color:var(--sub);margin-top:16px;line-height:1.7;font-weight:500" set:html={t.optNote}></p>
      </div>
    </div>
  </div>
</section>

<!-- ═══ 06 パフォーマンス ═══ -->
<section class="cream">
  <div class="wave top"><svg viewBox="0 0 1200 60" preserveAspectRatio="none"><path d="M0,60 C300,0 900,0 1200,60 L1200,0 L0,0 Z" fill="#fff"/></svg></div>
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="sec-sub">Performance</span>
      <h2 class="sec-title">{t.perfTitlePre}<span class="mk">{t.perfTitleMk}</span></h2>
    </div>
    <div class="perf-grid">
      <div class="perf-card reveal">
        <span class="perf-num perf-count" data-target="60">0</span><span class="perf-unit">{t.perf1u}</span>
        <span class="perf-label">{t.perf1l}</span>
      </div>
      <div class="perf-card reveal">
        <span class="perf-num perf-count" data-target="3">0</span><span class="perf-unit">{t.perf2u}</span>
        <span class="perf-label">{t.perf2l}</span>
      </div>
      <div class="perf-card reveal">
        <span class="perf-num perf-count" data-target="200">0</span><span class="perf-unit">{t.perf3u}</span>
        <span class="perf-label">{t.perf3l}</span>
      </div>
    </div>
  </div>
</section>

<!-- ═══ 07 CTA ═══ -->
<section class="cta-section">
  <div class="wrap" style="position:relative;z-index:2">
    <h2>{t.ctaH}</h2>
    <p class="cta-sub">{t.ctaSubBottom}</p>
    <div class="cta-btns">
      <a href={lp('/payment/')} class="btn btn-white">{t.ctaOrderBtn}</a>
      <a href={lp('/contact/') + '#contact-form'} class="btn btn-primary" style="box-shadow:0 5px 0 rgba(0,0,0,.2)">{t.ctaConsultBtn}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
    </div>
  </div>
</section>

<style is:global>
/* ══════════════════════════════════════════════
   SEO PAGE STYLES
   ══════════════════════════════════════════════ */
:root {
  --primary:#4FB4E8; --primary-dark:#2E90C4; --primary-deep:#1c6f9c;
  --sky-bg:#E4F4FD; --cream-bg:#FFF6E0; --mint-bg:#E9F7E4; --pink-bg:#FFEFF0;
  --green:#78C25E; --green-dark:#4e8a3c;
  --yellow:#FFCF4D; --yellow-dark:#a9821f;
  --orange:#F79B3E; --orange-dark:#c76f14;
  --text:#3A4256; --sub:#7A8494;
  --white:#fff; --radius:24px; --shadow:0 10px 30px rgba(58,66,86,.08);
}
img{max-width:100%;display:block}
h1,h2,h3,h4{font-family:"Noto Sans JP",sans-serif}
.en{font-family:"Inter",sans-serif}
.wrap{max-width:1080px;margin:0 auto;padding:0 22px}
.mk{background:linear-gradient(transparent 60%, #FFE08A 60%);padding:0 2px}

/* ── Buttons ── */
.btn{display:inline-flex;align-items:center;gap:10px;font-family:"Noto Sans JP";font-weight:700;border-radius:999px;padding:16px 34px;font-size:16px;transition:.12s;cursor:pointer;border:none;position:relative;text-decoration:none;box-sizing:border-box}
.btn svg{width:18px;height:18px;stroke-width:3}
.btn-primary{background:var(--orange);color:#fff!important;box-shadow:0 5px 0 var(--orange-dark)}
.btn-primary:hover{transform:translateY(2px);box-shadow:0 3px 0 var(--orange-dark);background:var(--orange);color:#fff!important}
.btn-primary::after{display:none!important}
.btn-ghost{background:#fff;color:var(--primary-dark)!important;box-shadow:0 5px 0 #CDEBFA;border:2px solid #CDEBFA}
.btn-ghost:hover{transform:translateY(2px);box-shadow:0 3px 0 #CDEBFA;color:var(--primary-dark)!important;background:#fff}
.btn-ghost::after{display:none!important}
.btn-white{background:#fff;color:var(--text)!important;box-shadow:0 5px 0 #ddd;border:2px solid #eee}
