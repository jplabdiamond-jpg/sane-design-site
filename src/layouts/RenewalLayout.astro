---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import LangRedirect from '../components/LangRedirect.astro';
import LangSwitcher from '../components/LangSwitcher.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getLangFromUrl, localizePath, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const homeHref = lang === 'en' ? '/en/' : '/';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  ogType?: string;
  jsonLd?: Record<string, any> | Record<string, any>[];
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  image,
  noindex = false,
  ogType = 'website',
  jsonLd,
  publishedTime,
  modifiedTime,
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <LangRedirect />
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-17VLB3PB4C"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-17VLB3PB4C');
    </script>
    <meta name="google-site-verification" content="IUjBMyfnWEqOl6Dw1QZFX96Bgka_bV1HBMttPd3UoOc" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <SEO
      title={title}
      description={description}
      lang={lang}
      image={image}
      ogType={ogType}
      jsonLd={jsonLd}
      noindex={noindex}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE_TITLE} RSS`} href="/rss.xml" />
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;800&family=Noto+Sans+JP:wght@400;500;700;900&display=swap"
      rel="stylesheet"
    />
    <meta name="format-detection" content="telephone=no" />
  </head>
  <body class="rn-body">

    <!-- ── Renewal Header ── -->
    <header class="rn-header" id="rn-header">
      <div class="rn-nav-wrap">
        <a href={homeHref} class="rn-logo" aria-label="Sane Design">Sane<b>Design</b></a>
        <nav class="rn-nav-links" id="rn-nav-links">
          <a href={localizePath('/#reasons', lang)}>{t('rn.reasons')}</a>
          <a href={localizePath('/#services', lang)}>{t('rn.services')}</a>
          <a href={localizePath('/#pricing', lang)}>{t('rn.pricing')}</a>
          <a href={localizePath('/works/', lang)}>{t('rn.works')}</a>
          <a href={localizePath('/blog/', lang)}>{t('rn.blog')}</a>
          <a href={localizePath('/#faq', lang)}>{t('rn.faq')}</a>
          <a href={localizePath('/contact/', lang)} class="rn-btn rn-btn-primary rn-btn-nav">{t('rn.consult')}</a>
          <LangSwitcher />
        </nav>
        <button class="rn-menu-btn" id="rn-menu-btn" aria-label={t('nav.menu')}>
          <span></span><span></span><span></span>
        </button>
      </div>

      <!-- Mobile menu overlay -->
      <div class="rn-mobile-menu" id="rn-mobile-menu">
        <nav class="rn-mobile-nav">
          <a href={localizePath('/#reasons', lang)}>{t('rn.reasons')}</a>
          <a href={localizePath('/#services', lang)}>{t('rn.services')}</a>
          <a href={localizePath('/#pricing', lang)}>{t('rn.pricing')}</a>
          <a href={localizePath('/works/', lang)}>{t('rn.works')}</a>
          <a href={localizePath('/blog/', lang)}>{t('rn.blog')}</a>
          <a href={localizePath('/#faq', lang)}>{t('rn.faq')}</a>
          <a href={localizePath('/contact/', lang)} class="rn-btn rn-btn-primary" style="margin-top:16px;width:100%;justify-content:center;">{t('rn.consult')}</a>
          <div class="rn-lang-row">
            <span class="rn-lang-label">Language / 言語</span>
            <LangSwitcher compact />
          </div>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <!-- ── Renewal Footer ── -->
    <footer class="rn-footer">
      <div class="rn-footer-wrap">
        <div class="rn-foot-grid">
          <a href={homeHref} class="rn-foot-logo">Sane<b>Design</b></a>
          <div class="rn-foot-links">
            <a href={localizePath('/#services', lang)}>{t('rn.services')}</a>
            <a href={localizePath('/#pricing', lang)}>{t('rn.pricing')}</a>
            <a href={localizePath('/works/', lang)}>{t('rn.works')}</a>
            <a href={localizePath('/#faq', lang)}>{t('rn.faq')}</a>
            <a href={localizePath('/contact/', lang)}>{t('rn.footContact')}</a>
          </div>
        </div>
        <div class="rn-copy">{t('rn.copy')} &copy; 2026 Sane Design</div>
      </div>
    </footer>

    <!-- ── Mobile Sticky CTA ── -->
    <div class="rn-sticky-cta">
      <a href={localizePath('/works/', lang)} class="rn-btn rn-btn-ghost">{t('rn.footWorks')}</a>
      <a href={localizePath('/contact/', lang)} class="rn-btn rn-btn-primary">{t('rn.stickyConsult')}</a>
    </div>

  </body>
</html>

<style is:global>
  /* ══════════════════════════════════════════════
     RENEWAL LAYOUT — GLOBAL STYLES
     ══════════════════════════════════════════════ */

  .rn-body {
    margin: 0;
    padding: 0;
    font-family: "Noto Sans JP", sans-serif;
    color: #3A4256;
    background: #fff;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    overflow-x: hidden;
  }

  /* ── Buttons ── */
  .rn-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: "Noto Sans JP", sans-serif;
    font-weight: 700;
    border-radius: 999px;
    padding: 16px 34px;
    font-size: 16px;
    transition: transform 0.12s, box-shadow 0.12s;
    cursor: pointer;
    border: none;
    text-decoration: none;
    position: relative;
    box-sizing: border-box;
  }
  .rn-btn svg {
    width: 18px;
    height: 18px;
    stroke-width: 3;
  }
  .rn-btn-primary {
    background: #F79B3E;
    color: #fff !important;
    box-shadow: 0 5px 0 #c76f14;
  }
  .rn-btn-primary:hover {
    transform: translateY(2px);
    box-shadow: 0 3px 0 #c76f14;
  }
  .rn-btn-ghost {
    background: #fff;
    color: #2E90C4 !important;
    box-shadow: 0 5px 0 #CDEBFA;
    border: 2px solid #CDEBFA;
  }
  .rn-btn-ghost:hover {
    transform: translateY(2px);
    box-shadow: 0 3px 0 #CDEBFA;
  }

  /* ── Header ── */
  .rn-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255,255,255,0.95);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: 0 2px 14px rgba(58,66,86,0.06);
  }
  .rn-nav-wrap {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 22px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 70px;
  }
  .rn-logo {
    font-family: "Inter", sans-serif;
    font-weight: 800;
    font-size: 24px;
    color: #3A4256;
    text-decoration: none;
  }
  .rn-logo b {
    color: #4FB4E8;
  }
  .rn-nav-links {
    display: flex;
    gap: 26px;
    align-items: center;
    font-size: 14px;
    font-weight: 700;
    font-family: "Noto Sans JP", sans-serif;
  }
  .rn-nav-links a {
    color: #3A4256;
    text-decoration: none;
    transition: color 0.2s;
  }
  .rn-nav-links a:hover {
    color: #4FB4E8;
  }
  .rn-btn-nav {
    padding: 10px 22px;
    font-size: 14px;
    box-shadow: 0 4px 0 #c76f14;
  }
  .rn-menu-btn {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    width: 28px;
  }
  .rn-menu-btn span {
    display: block;
    height: 2px;
    background: #3A4256;
    border-radius: 1px;
    transition: transform 0.3s, opacity 0.3s;
  }

  /* ── Mobile Menu ── */
  .rn-mobile-menu {
    display: none;
    overflow: hidden;
    max-height: 0;
    transition: max-height 0.4s cubic-bezier(0.19,1,0.22,1);
    background: #fff;
    border-top: 1px solid #e8e8e8;
  }
  .rn-mobile-menu.open {
    max-height: 680px;
  }
  .rn-mobile-nav {
    display: flex;
    flex-direction: column;
    padding: 12px 22px 28px;
    gap: 0;
  }
  .rn-mobile-nav a {
    display: block;
    padding: 20px 4px;
    font-size: 16px;
    font-weight: 700;
    color: #3A4256;
    text-decoration: none;
    border-bottom: 1px solid #eef1f4;
  }
  .rn-mobile-nav a:hover {
    color: #4FB4E8;
  }
  .rn-mobile-nav .rn-btn {
    display: flex;
    justify-content: center;
    text-align: center;
    border-bottom: none;
  }
  .rn-lang-row {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    margin-top: 24px;
    padding-top: 24px;
    border-top: 1px solid #eef1f4;
  }
  .rn-lang-label {
    font-family: "Inter", sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #9aa3b0;
  }

  /* ── Footer ── */
  .rn-footer {
    background: #3A4256;
    color: #aeb6c2;
    padding: 50px 0 30px;
    font-size: 13px;
  }
  .rn-footer-wrap {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 22px;
  }
  .rn-foot-grid {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
    margin-bottom: 26px;
  }
  .rn-foot-logo {
    color: #fff;
    font-family: "Inter", sans-serif;
    font-weight: 800;
    font-size: 22px;
    text-decoration: none;
  }
  .rn-foot-logo b {
    color: #4FB4E8;
  }
  .rn-foot-links {
    display: flex;
    gap: 22px;
    flex-wrap: wrap;
    font-family: "Noto Sans JP", sans-serif;
    font-weight: 700;
  }
  .rn-foot-links a {
    color: #aeb6c2;
    text-decoration: none;
    transition: color 0.2s;
  }
  .rn-foot-links a:hover {
    color: #fff;
  }
  .rn-copy {
    border-top: 1px solid #4b5262;
    padding-top: 20px;
    text-align: center;
    font-size: 12px;
  }

  /* ── Sticky CTA ── */
  .rn-sticky-cta {
    display: none;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 60;
    background: #fff;
    padding: 10px 14px;
    gap: 10px;
    box-shadow: 0 -4px 20px rgba(0,0,0,0.1);
  }
  .rn-sticky-cta a {
    flex: 1;
    justify-content: center;
    padding: 13px;
    font-size: 14px;
  }

  /* ── Page transition ── */
  main {
    animation: rnFadeIn 0.5s cubic-bezier(0.19,1,0.22,1) backwards;
  }
  @keyframes rnFadeIn {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: none; }
  }

  /* ── Mobile ── */
  @media (max-width: 860px) {
    .rn-nav-links {
      display: none;
    }
    .rn-menu-btn {
      display: flex;
    }
    .rn-mobile-menu {
      display: block;
    }
    .rn-body {
      padding-bottom: 72px;
    }
    .rn-sticky-cta {
      display: flex;
    }
  }
</style>

<script>
  // ── Header scroll effect ──
  const rnHeader = document.getElementById('rn-header');
  // (The header already has box-shadow, no extra scroll effect needed)

  // ── Mobile menu toggle ──
  const menuBtn = document.getElementById('rn-menu-btn');
  const mobileMenu = document.getElementById('rn-mobile-menu');
  let menuOpen = false;

  menuBtn?.addEventListener('click', () => {
    menuOpen = !menuOpen;
    mobileMenu?.classList.toggle('open', menuOpen);

    const spans = menuBtn.querySelectorAll('span');
    if (menuOpen) {
      (spans[0] as HTMLElement).style.transform = 'rotate(45deg) translateY(7px)';
      (spans[1] as HTMLElement).style.opacity = '0';
      (spans[2] as HTMLElement).style.transform = 'rotate(-45deg) translateY(-7px)';
    } else {
      (spans[0] as HTMLElement).style.transform = '';
      (spans[1] as HTMLElement).style.opacity = '1';
      (spans[2] as HTMLElement).style.transform = '';
    }
  });

  // ── Scroll reveal (for CTA etc) ──
  function initReveal() {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('visible');
            observer.unobserve(e.target);
          }
        });
      },
      { threshold: 0.01 }
    );
    document.querySelectorAll('.reveal, .reveal-left, .reveal-scale').forEach((el) => {
      const rect = el.getBoundingClientRect();
      if (rect.top < window.innerHeight && rect.bottom > 0) {
        el.classList.add('visible');
      } else {
        observer.observe(el);
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initReveal);
  } else {
    initReveal();
  }
  document.addEventListener('astro:page-load', initReveal);
</script>
