---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { SITE_URL, SITE_NAME } from '../../consts';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft))
    .sort((a, b) => new Date(a.data.pubDate).getTime() - new Date(b.data.pubDate).getTime());
  return posts.map((post, index) => ({
    params: { slug: post.slug },
    props: { post, index, allPosts: posts },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
  index: number;
  allPosts: CollectionEntry<'blog'>[];
}

const { post, index, allPosts } = Astro.props;
const { Content } = await post.render();

// 前後の記事
const prevPost = index > 0 ? allPosts[index - 1] : null;
const nextPost = index < allPosts.length - 1 ? allPosts[index + 1] : null;

// CTA人物イラストを3枚ローテーション（制作実績ページと同じ）
const ctaImages = [
  '/assets/reason01_woman.png',
  '/assets/reason03_man.png',
  '/assets/webdesign_page_step3.png',
];
const ctaImage = ctaImages[index % 3];
const isWoman = ctaImage.includes('reason01_woman');

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  keywords: post.data.tags.join(', '),
  inLanguage: 'ja',
  ...(post.data.heroImage
    ? { image: new URL(post.data.heroImage, SITE_URL).href }
    : {}),
  mainEntityOfPage: new URL(`/blog/${post.slug}/`, SITE_URL).href,
  author: { '@type': 'Organization', name: SITE_NAME, url: SITE_URL },
  publisher: { '@id': `${SITE_URL}/#organization` },
};
---

<BaseLayout
  title={`${post.data.title} | Sane Design Journal`}
  description={post.data.description}
  image={post.data.heroImage}
  ogType="article"
  jsonLd={articleJsonLd}
>
  <article>
    <header class="container-editorial pt-16 md:pt-24 pb-12 max-w-3xl">
      <div class="mb-6">
        <Breadcrumbs
          items={[
            { label: 'Journal', href: '/blog/' },
            { label: post.data.title },
          ]}
        />
      </div>
      <p class="text-xs text-muted mb-4">
        <time>{post.data.pubDate.toISOString().slice(0, 10)}</time>
        {
          post.data.tags.length > 0 && (
            <>
              {' · '}
              {post.data.tags.map((tag, i) => (
                <span>
                  #{tag}
                  {i < post.data.tags.length - 1 ? ' ' : ''}
                </span>
              ))}
            </>
          )
        }
      </p>
      <h1 class="font-serif text-3xl md:text-5xl leading-tight">{post.data.title}</h1>
      <p class="mt-6 text-base md:text-lg text-muted leading-relaxed">
        {post.data.description}
      </p>
    </header>

    {
      post.data.heroImage && (
        <div class="container-editorial pb-16">
          <img
            src={post.data.heroImage}
            alt={post.data.title}
            class="w-full h-auto bg-[#fafafa]"
          />
        </div>
      )
    }

    <section class="container-editorial pb-24">
      <div class="prose-custom">
        <Content />
      </div>
    </section>
  </article>

  <!-- ── 前後の記事ナビゲーション ── -->
  <section class="blog-prev-next-section">
    <div class="blog-prev-next-container">
      <h3 class="blog-prev-next-heading">関連記事</h3>
      <div class="blog-prev-next-grid">
        {prevPost && (
          <a href={`/blog/${prevPost.slug}/`} class="blog-prev-next-card blog-prev-card">
            {prevPost.data.heroImage && (
              <div class="blog-prev-next-thumb">
                <img src={prevPost.data.heroImage} alt={prevPost.data.title} loading="lazy" />
              </div>
            )}
            <div class="blog-prev-next-info">
              <span class="blog-prev-next-label">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
                前の記事
              </span>
              <span class="blog-prev-next-title">{prevPost.data.title}</span>
            </div>
          </a>
        )}
        {nextPost && (
          <a href={`/blog/${nextPost.slug}/`} class="blog-prev-next-card blog-next-card">
            {nextPost.data.heroImage && (
              <div class="blog-prev-next-thumb">
                <img src={nextPost.data.heroImage} alt={nextPost.data.title} loading="lazy" />
              </div>
            )}
            <div class="blog-prev-next-info">
              <span class="blog-prev-next-label">
                次の記事
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </span>
              <span class="blog-prev-next-title">{nextPost.data.title}</span>
            </div>
          </a>
        )}
      </div>
    </div>
  </section>

  <!-- ── CTA Section（3パターンイラストローテーション） ── -->
  <section class="blog-cta-illust-section">
    <div class="blog-cta-illust-wave-top">
      <svg viewBox="0 0 1200 60" preserveAspectRatio="none"><path d="M0,60 C300,0 900,0 1200,60 L1200,0 L0,0 Z" fill="#fff"/></svg>
    </div>
    <div class="blog-cta-illust-container">
      <img class:list={["blog-cta-illust-img", { "blog-cta-illust-img-sm": isWoman }]} src={ctaImage} alt="お問い合わせイラスト" />
      <h2 class="blog-cta-illust-title">まずは気軽にご相談ください</h2>
      <p class="blog-cta-illust-desc">
        知識がなくても大丈夫です！<br />
        「何も分からない」状態でご相談いただけましたら、<br class="blog-cta-sp-hide" />こちらから様々な提案をさせていただきます。
      </p>
      <div class="blog-cta-illust-btns">
        <a href="/contact/" class="blog-cta-illust-btn blog-cta-illust-btn-primary">
          無料で相談してみる（入力は1分）
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a href="/works/" class="blog-cta-illust-btn blog-cta-illust-btn-secondary">
          制作実績を見てみる
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>
      <p class="blog-cta-illust-note">しつこい営業は一切しません。お気軽にどうぞ。</p>
    </div>
  </section>
</BaseLayout>

<style is:global>
  /* ══════════════════════════════════════════════
     BLOG PREV / NEXT NAVIGATION
     ══════════════════════════════════════════════ */
  .blog-prev-next-section {
    max-width: 820px;
    margin: 0 auto;
    padding: 0 22px 60px;
  }
  .blog-prev-next-heading {
    font-family: "Noto Sans JP", sans-serif;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.06em;
    color: #7A8494;
    text-transform: uppercase;
    margin-bottom: 20px;
    padding-bottom: 12px;
    border-bottom: 2px solid #E4F4FD;
  }
  .blog-prev-next-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  .blog-prev-next-card {
    display: flex;
    flex-direction: column;
    background: #f8fbff;
    border: 1px solid #e8edf3;
    border-radius: 16px;
    overflow: hidden;
    text-decoration: none;
    color: #3A4256;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .blog-prev-next-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 32px rgba(0,0,0,0.08);
  }
  .blog-prev-next-thumb {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #e8edf3;
  }
  .blog-prev-next-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .blog-prev-next-card:hover .blog-prev-next-thumb img {
    transform: scale(1.05);
  }
  .blog-prev-next-info {
    padding: 16px 18px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .blog-prev-next-label {
    font-size: 12px;
    font-weight: 700;
    color: #4FB4E8;
    display: flex;
    align-items: center;
    gap: 4px;
    letter-spacing: 0.04em;
  }
  .blog-prev-next-label svg {
    width: 14px;
    height: 14px;
  }
  .blog-next-card .blog-prev-next-label {
    justify-content: flex-end;
  }
  .blog-next-card .blog-prev-next-info {
    text-align: right;
  }
  .blog-prev-next-title {
    font-family: "Noto Sans JP", sans-serif;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 640px) {
    .blog-prev-next-grid {
      grid-template-columns: 1fr;
    }
    .blog-next-card .blog-prev-next-label {
      justify-content: flex-start;
    }
    .blog-next-card .blog-prev-next-info {
      text-align: left;
    }
  }

  /* ══════════════════════════════════════════════
     BLOG CTA ILLUSTRATION SECTION
     ══════════════════════════════════════════════ */
  .blog-cta-illust-section {
    position: relative;
    background: linear-gradient(135deg, #4FB4E8 0%, #69C6D9 100%);
    color: #fff;
    padding: 0 0 80px;
    margin-top: 0;
    overflow: hidden;
  }
  .blog-cta-illust-wave-top {
    line-height: 0;
  }
  .blog-cta-illust-wave-top svg {
    width: 100%;
    height: 60px;
    display: block;
  }
  .blog-cta-illust-container {
    max-width: 700px;
    margin: 0 auto;
    padding: 0 22px;
    text-align: center;
  }
  .blog-cta-illust-img {
    display: block;
    margin: 0 auto 24px;
    max-width: 260px;
    height: auto;
    filter: drop-shadow(0 8px 24px rgba(0,0,0,0.1));
  }
  .blog-cta-illust-img-sm {
    max-width: 200px;
  }
  .blog-cta-illust-title {
    font-family: "Noto Sans JP", sans-serif !important;
    font-size: clamp(22px, 4vw, 32px);
    font-weight: 900 !important;
    line-height: 1.5 !important;
    letter-spacing: 0.02em !important;
    color: #fff;
    margin-bottom: 16px;
  }
  .blog-cta-illust-desc {
    font-size: 15px;
    opacity: 0.9;
    font-weight: 500;
    line-height: 1.9;
    margin-bottom: 32px;
  }
  @media (max-width: 560px) {
    .blog-cta-sp-hide { display: none; }
  }

  .blog-cta-illust-btns {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    justify-content: center;
    margin-bottom: 20px;
  }
  .blog-cta-illust-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 16px 32px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 800;
    font-family: "Noto Sans JP", sans-serif;
    text-decoration: none;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    letter-spacing: 0.02em;
  }
  .blog-cta-illust-btn svg {
    width: 18px;
    height: 18px;
  }
  .blog-cta-illust-btn:hover {
    transform: translateY(-2px);
  }

  .blog-cta-illust-btn-primary {
    background: #fff;
    color: #3A4256;
    box-shadow: 0 6px 20px rgba(0,0,0,0.1);
  }
  .blog-cta-illust-btn-primary:hover {
    box-shadow: 0 12px 32px rgba(0,0,0,0.16);
  }
  .blog-cta-illust-btn-secondary {
    background: rgba(255,255,255,0.15);
    color: #fff;
    border: 1px solid rgba(255,255,255,0.4);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .blog-cta-illust-btn-secondary:hover {
    background: rgba(255,255,255,0.25);
    border-color: rgba(255,255,255,0.7);
    box-shadow: 0 8px 24px rgba(0,0,0,0.08);
  }

  .blog-cta-illust-note {
    font-size: 13px;
    opacity: 0.7;
    font-weight: 500;
  }

  @media (max-width: 640px) {
    .blog-cta-illust-section {
      padding: 0 0 60px;
    }
    .blog-cta-illust-img {
      max-width: 180px;
    }
    .blog-cta-illust-img-sm {
      max-width: 140px;
    }
    .blog-cta-illust-btns {
      flex-direction: column;
      align-items: center;
    }
    .blog-cta-illust-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
