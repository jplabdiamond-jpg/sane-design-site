---
import RenewalLayout from '../../layouts/RenewalLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { SITE_URL, SITE_NAME } from '../../consts';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft))
    .sort((a, b) => new Date(a.data.pubDate).getTime() - new Date(b.data.pubDate).getTime());
  return posts.map((post, index) => ({
    params: { slug: post.slug },
    props: { post, index, allPosts: posts },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
  index: number;
  allPosts: CollectionEntry<'blog'>[];
}

const { post, index, allPosts } = Astro.props;
const { Content } = await post.render();

// 前後の記事
const prevPost = index > 0 ? allPosts[index - 1] : null;
const nextPost = index < allPosts.length - 1 ? allPosts[index + 1] : null;

// CTA人物イラストを3枚ローテーション（制作実績ページと同じ）
const ctaImages = [
  '/assets/reason01_woman.webp',
  '/assets/reason03_man.webp',
  '/assets/webdesign_page_step3.webp',
];
const ctaImage = ctaImages[index % 3];
const isWoman = ctaImage.includes('reason01_woman');

const pubISO = post.data.pubDate.toISOString();
const modISO = (post.data.updatedDate ?? post.data.pubDate).toISOString();

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: pubISO,
  dateModified: modISO,
  keywords: post.data.tags.join(', '),
  inLanguage: 'ja',
  ...(post.data.heroImage
    ? {
        image: {
          '@type': 'ImageObject',
          url: new URL(post.data.heroImage, SITE_URL).href,
          width: 1200,
          height: 630,
        },
      }
    : {}),
  mainEntityOfPage: new URL(`/blog/${post.slug}/`, SITE_URL).href,
  author: { '@type': 'Organization', name: SITE_NAME, url: SITE_URL },
  publisher: { '@id': `${SITE_URL}/#organization` },
  speakable: {
    '@type': 'SpeakableSpecification',
    cssSelector: ['h1', '.blog-header-desc'],
  },
};
---

<RenewalLayout
  title={`${post.data.title} | Sane Design Journal`}
  description={post.data.description}
  image={post.data.heroImage}
  ogType="article"
  jsonLd={articleJsonLd}
  publishedTime={pubISO}
  modifiedTime={modISO}
>
  <article class="blog-article-wrap">
    <header class="blog-article-header">
      <Breadcrumbs
        items={[
          { label: 'Journal', href: '/blog/' },
          { label: post.data.title },
        ]}
      />
      <p class="blog-header-date">
        <time>{post.data.pubDate.toISOString().slice(0, 10)}</time>
      </p>
      <h1 class="blog-header-title">{post.data.title}</h1>
      <p class="blog-header-desc">
        {post.data.description}
      </p>
      {
        post.data.tags.length > 0 && (
          <div class="blog-header-tags">
            {post.data.tags.map((tag) => (
              <span class="blog-header-tag">#{tag}</span>
            ))}
          </div>
        )
      }
    </header>

    {
      post.data.heroImage && (
        <div class="blog-article-hero">
          <img
            src={post.data.heroImage}
            alt={post.data.title}
            class="blog-hero-img"
          />
        </div>
      )
    }

    <section class="blog-article-body">
      <div class="prose-custom">
        <Content />
      </div>
    </section>
  </article>

  <!-- ── 前後の記事ナビゲーション ── -->
  <section class="blog-prev-next-section">
    <div class="blog-prev-next-container">
      <h3 class="blog-prev-next-heading">関連記事</h3>
      <div class="blog-prev-next-grid">
        {prevPost && (
          <a href={`/blog/${prevPost.slug}/`} class="blog-prev-next-card blog-prev-card">
            {prevPost.data.heroImage && (
              <div class="blog-prev-next-thumb">
                <img src={prevPost.data.heroImage} alt={prevPost.data.title} loading="lazy" />
              </div>
            )}
            <div class="blog-prev-next-info">
              <span class="blog-prev-next-label">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
                前の記事
              </span>
              <span class="blog-prev-next-title">{prevPost.data.title}</span>
            </div>
          </a>
        )}
        {nextPost && (
          <a href={`/blog/${nextPost.slug}/`} class="blog-prev-next-card blog-next-card">
            {nextPost.data.heroImage && (
              <div class="blog-prev-next-thumb">
                <img src={nextPost.data.heroImage} alt={nextPost.data.title} loading="lazy" />
              </div>
            )}
            <div class="blog-prev-next-info">
              <span class="blog-prev-next-label">
                次の記事
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </span>
              <span class="blog-prev-next-title">{nextPost.data.title}</span>
            </div>
          </a>
        )}
      </div>
    </div>
  </section>

  <!-- ── CTA Section（3パターンイラストローテーション） ── -->
  <section class="blog-cta-illust-section">
    <div class="blog-cta-illust-wave-top">
      <svg viewBox="0 0 1200 60" preserveAspectRatio="none"><path d="M0,60 C300,0 900,0 1200,60 L1200,0 L0,0 Z" fill="#fff"/></svg>
    </div>
    <div class="blog-cta-illust-container">
      <img class:list={["blog-cta-illust-img", { "blog-cta-illust-img-sm": isWoman }]} src={ctaImage} alt="お問い合わせイラスト" />
      <h2 class="blog-cta-illust-title">まずは気軽にご相談ください</h2>
      <p class="blog-cta-illust-desc">
        知識がなくても大丈夫です！<br />
        「何も分からない」状態でご相談いただけましたら、<br class="blog-cta-sp-hide" />こちらから様々な提案をさせていただきます。
      </p>
      <div class="blog-cta-illust-btns">
        <a href="/contact/" class="rn-btn rn-btn-primary blog-cta-main-btn">
          <span>無料で相談してみる</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a href="/works/" class="blog-cta-illust-btn blog-cta-illust-btn-secondary">
          制作実績を見てみる
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>
      <p class="blog-cta-illust-note">しつこい営業は一切しません。お気軽にどうぞ。</p>
    </div>
  </section>
</RenewalLayout>

<style is:global>
  /* ══════════════════════════════════════════════
     BLOG ARTICLE LAYOUT — CONTENT WIDTH
     ══════════════════════════════════════════════ */
  .blog-article-wrap {
    max-width: 780px;
    margin: 0 auto;
    padding: 0 22px;
  }
  .blog-article-header {
    padding-top: 48px;
    padding-bottom: 32px;
  }
  .blog-article-header .breadcrumbs {
    margin-bottom: 24px;
  }
  .blog-article-hero {
    padding-bottom: 40px;
  }
  .blog-hero-img {
    width: 100%;
    height: auto;
    border-radius: 16px;
    box-shadow: 0 4px 16px rgba(0,0,0,0.06);
    background: #fafafa;
  }
  .blog-article-body {
    padding-bottom: 64px;
  }

  @media (max-width: 640px) {
    .blog-article-wrap {
      padding: 0 16px;
    }
    .blog-article-header {
      padding-top: 32px;
      padding-bottom: 24px;
    }
    .blog-hero-img {
      border-radius: 12px;
    }
  }

  /* ══════════════════════════════════════════════
     BLOG HEADER STYLES
     ══════════════════════════════════════════════ */
  .blog-header-date {
    font-size: 13px;
    font-weight: 600;
    color: #4FB4E8;
    letter-spacing: 0.08em;
    margin-bottom: 16px;
  }
  .blog-header-title {
    font-family: "Noto Sans JP", sans-serif;
    font-size: clamp(28px, 5vw, 44px);
    font-weight: 900;
    line-height: 1.35;
    letter-spacing: 0.02em;
    color: #1a202c;
  }
  .blog-header-desc {
    margin-top: 20px;
    font-size: 16px;
    line-height: 1.8;
    color: #6b7a8d;
    font-weight: 400;
  }
  .blog-header-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 20px;
  }
  .blog-header-tag {
    display: inline-block;
    background: #EBF5FB;
    color: #4FB4E8;
    font-size: 12px;
    font-weight: 700;
    padding: 4px 14px;
    border-radius: 999px;
    letter-spacing: 0.02em;
  }

  /* ══════════════════════════════════════════════
     PROSE CUSTOM — LIG-INSPIRED BLOG TYPOGRAPHY
     ══════════════════════════════════════════════ */
  .prose-custom {
    font-family: "Noto Sans JP", "Hiragino Kaku Gothic Pro", "メイリオ", sans-serif;
    font-size: 16px;
    font-weight: 400;
    line-height: 2;
    letter-spacing: 0.04em;
    color: #424242;
    word-break: break-word;
    overflow-wrap: break-word;
  }

  /* ── Paragraphs ── */
  .prose-custom p {
    margin-bottom: 2em;
  }

  /* ── Headings ── */
  .prose-custom h2 {
    font-family: "Noto Sans JP", sans-serif;
    font-size: clamp(24px, 4vw, 32px);
    font-weight: 800;
    line-height: 1.4;
    letter-spacing: 0.06em;
    color: #2d3748;
    margin-top: 4em;
    margin-bottom: 1.2em;
    padding-bottom: 0.6em;
    border-bottom: 3px solid #4FB4E8;
    position: relative;
  }
  .prose-custom h2::after {
    content: '';
    position: absolute;
    bottom: -3px;
    left: 0;
    width: 60px;
    height: 3px;
    background: #69C6D9;
  }

  .prose-custom h3 {
    font-family: "Noto Sans JP", sans-serif;
    font-size: clamp(20px, 3.5vw, 26px);
    font-weight: 700;
    line-height: 1.5;
    letter-spacing: 0.04em;
    color: #2d3748;
    margin-top: 3em;
    margin-bottom: 1em;
    padding-left: 16px;
    border-left: 4px solid #4FB4E8;
  }

  .prose-custom h4 {
    font-family: "Noto Sans JP", sans-serif;
    font-size: clamp(17px, 3vw, 20px);
    font-weight: 700;
    line-height: 1.5;
    color: #3A4256;
    margin-top: 2.5em;
    margin-bottom: 0.8em;
  }

  /* ── Strong / Bold — Yellow marker highlight ── */
  .prose-custom strong {
    font-weight: 700;
    background-image: linear-gradient(to top, rgba(0,0,0,0) 0%, rgba(0,0,0,0) 10%, rgba(255,255,100,0.45) 10%, rgba(255,255,100,0.45) 45%, rgba(0,0,0,0) 45%);
    padding: 0 2px;
  }

  /* ── Links ── */
  .prose-custom a {
    color: #4FB4E8;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(79,180,232,0.3);
    transition: color 0.2s, text-decoration-color 0.2s;
  }
  .prose-custom a:hover {
    color: #3a9ad9;
    text-decoration-color: #3a9ad9;
  }

  /* ── Horizontal rules ── */
  .prose-custom hr {
    border: none;
    height: 1px;
    background: linear-gradient(to right, transparent, #d0dbe8, transparent);
    margin: 3.5em 0;
  }

  /* ── Unordered & Ordered lists ── */
  .prose-custom ul {
    list-style: none;
    padding-left: 0;
    margin-bottom: 2em;
  }
  .prose-custom ul > li {
    position: relative;
    padding-left: 1.6em;
    margin-bottom: 0.8em;
    line-height: 1.9;
  }
  .prose-custom ul > li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 8px;
    height: 8px;
    background: #4FB4E8;
    border-radius: 50%;
  }

  .prose-custom ol {
    list-style: none;
    padding-left: 0;
    counter-reset: ol-counter;
    margin-bottom: 2em;
  }
  .prose-custom ol > li {
    position: relative;
    padding-left: 2.4em;
    margin-bottom: 0.8em;
    counter-increment: ol-counter;
    line-height: 1.9;
  }
  .prose-custom ol > li::before {
    content: counter(ol-counter);
    position: absolute;
    left: 0;
    top: 0.25em;
    width: 1.6em;
    height: 1.6em;
    background: #4FB4E8;
    color: #fff;
    font-size: 13px;
    font-weight: 800;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }

  /* ── Blockquotes — Callout style ── */
  .prose-custom blockquote {
    background: #f0f7ff;
    border-left: 4px solid #4FB4E8;
    border-radius: 0 12px 12px 0;
    padding: 1.4em 1.8em;
    margin: 2em 0;
    font-size: 15px;
    color: #4a5568;
    line-height: 1.9;
  }
  .prose-custom blockquote p {
    margin-bottom: 0.6em;
  }
  .prose-custom blockquote p:last-child {
    margin-bottom: 0;
  }

  /* ── Code inline ── */
  .prose-custom code {
    background: #f0f4f8;
    color: #e53e3e;
    font-size: 0.88em;
    padding: 0.2em 0.5em;
    border-radius: 4px;
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
  }
  .prose-custom pre {
    background: #1a202c;
    color: #e2e8f0;
    padding: 1.5em;
    border-radius: 12px;
    overflow-x: auto;
    margin: 2em 0;
    font-size: 14px;
    line-height: 1.7;
  }
  .prose-custom pre code {
    background: none;
    color: inherit;
    padding: 0;
    border-radius: 0;
    font-size: inherit;
  }

  /* ── Tables ── */
  .prose-custom table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    margin: 2em 0;
    font-size: 15px;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 1px 6px rgba(0,0,0,0.06);
  }
  .prose-custom thead th {
    background: #4FB4E8;
    color: #fff;
    font-weight: 700;
    padding: 12px 16px;
    text-align: left;
    font-size: 14px;
    letter-spacing: 0.04em;
  }
  .prose-custom tbody td {
    padding: 12px 16px;
    border-bottom: 1px solid #e8edf3;
  }
  .prose-custom tbody tr:last-child td {
    border-bottom: none;
  }
  .prose-custom tbody tr:nth-child(even) {
    background: #f8fbff;
  }
  .prose-custom tbody tr:hover {
    background: #eef5fc;
  }

  /* ── Images inside prose ── */
  .prose-custom img {
    border-radius: 12px;
    margin: 2em auto;
    display: block;
    max-width: 100%;
    height: auto;
    box-shadow: 0 4px 16px rgba(0,0,0,0.06);
  }

  /* ── "この記事でわかること" TOC-like box ── */
  .prose-custom ul:first-of-type {
    background: #f5f8fb;
    border-radius: 12px;
    padding: 1.6em 1.8em 1.6em 1.8em;
    border: 1px solid #e4eaf2;
  }
  .prose-custom ul:first-of-type > li::before {
    background: #51cf66;
  }

  /* ── Mobile adjustments ── */
  @media (max-width: 640px) {
    .prose-custom {
      font-size: 15px;
      line-height: 1.95;
    }
    .prose-custom h2 {
      margin-top: 3em;
      margin-bottom: 1em;
    }
    .prose-custom h3 {
      margin-top: 2.5em;
    }
    .prose-custom blockquote {
      padding: 1em 1.2em;
      margin: 1.5em 0;
    }
    .prose-custom table {
      font-size: 13px;
    }
    .prose-custom thead th,
    .prose-custom tbody td {
      padding: 10px 12px;
    }
  }

  /* ══════════════════════════════════════════════
     BLOG PREV / NEXT NAVIGATION
     ══════════════════════════════════════════════ */
  .blog-prev-next-section {
    max-width: 780px;
    margin: 0 auto;
    padding: 0 22px 60px;
  }
  .blog-prev-next-heading {
    font-family: "Noto Sans JP", sans-serif;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.06em;
    color: #7A8494;
    text-transform: uppercase;
    margin-bottom: 20px;
    padding-bottom: 12px;
    border-bottom: 2px solid #E4F4FD;
  }
  .blog-prev-next-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  .blog-prev-next-card {
    display: flex;
    flex-direction: column;
    background: #f8fbff;
    border: 1px solid #e8edf3;
    border-radius: 16px;
    overflow: hidden;
    text-decoration: none;
    color: #3A4256;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .blog-prev-next-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 32px rgba(0,0,0,0.08);
  }
  .blog-prev-next-thumb {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #e8edf3;
  }
  .blog-prev-next-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .blog-prev-next-card:hover .blog-prev-next-thumb img {
    transform: scale(1.05);
  }
  .blog-prev-next-info {
    padding: 16px 18px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .blog-prev-next-label {
    font-size: 12px;
    font-weight: 700;
    color: #4FB4E8;
    display: flex;
    align-items: center;
    gap: 4px;
    letter-spacing: 0.04em;
  }
  .blog-prev-next-label svg {
    width: 14px;
    height: 14px;
  }
  .blog-next-card .blog-prev-next-label {
    justify-content: flex-end;
  }
  .blog-next-card .blog-prev-next-info {
    text-align: right;
  }
  .blog-prev-next-title {
    font-family: "Noto Sans JP", sans-serif;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 640px) {
    .blog-prev-next-grid {
      grid-template-columns: 1fr;
    }
    .blog-next-card .blog-prev-next-label {
      justify-content: flex-start;
    }
    .blog-next-card .blog-prev-next-info {
      text-align: left;
    }
  }

  /* ══════════════════════════════════════════════
     BLOG CTA ILLUSTRATION SECTION
     ══════════════════════════════════════════════ */
  .blog-cta-illust-section {
    position: relative;
    background: linear-gradient(135deg, #4FB4E8 0%, #69C6D9 100%);
    color: #fff;
    padding: 0 0 80px;
    margin-top: 0;
    overflow: hidden;
  }
  .blog-cta-illust-wave-top {
    line-height: 0;
  }
  .blog-cta-illust-wave-top svg {
    width: 100%;
    height: 60px;
    display: block;
  }
  .blog-cta-illust-container {
    max-width: 700px;
    margin: 0 auto;
    padding: 0 22px;
    text-align: center;
  }
  .blog-cta-illust-img {
    display: block;
    margin: 0 auto 24px;
    max-width: 260px;
    height: auto;
    filter: drop-shadow(0 8px 24px rgba(0,0,0,0.1));
  }
  .blog-cta-illust-img-sm {
    max-width: 200px;
  }
  .blog-cta-illust-title {
    font-family: "Noto Sans JP", sans-serif !important;
    font-size: clamp(22px, 4vw, 32px);
    font-weight: 900 !important;
    line-height: 1.5 !important;
    letter-spacing: 0.02em !important;
    color: #fff;
    margin-bottom: 16px;
  }
  .blog-cta-illust-desc {
    font-size: 15px;
    opacity: 0.9;
    font-weight: 500;
    line-height: 1.9;
    margin-bottom: 32px;
  }
  @media (max-width: 560px) {
    .blog-cta-sp-hide { display: none; }
  }

  .blog-cta-illust-btns {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    justify-content: center;
    margin-bottom: 20px;
  }
  .blog-cta-illust-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 16px 32px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 800;
    font-family: "Noto Sans JP", sans-serif;
    text-decoration: none;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    letter-spacing: 0.02em;
  }
  .blog-cta-illust-btn svg {
    width: 18px;
    height: 18px;
  }
  .blog-cta-illust-btn:hover {
    transform: translateY(-2px);
  }

  .blog-cta-illust-btn-primary {
    background: #fff;
    color: #3A4256;
    box-shadow: 0 6px 20px rgba(0,0,0,0.1);
  }
  .blog-cta-illust-btn-primary:hover {
    box-shadow: 0 12px 32px rgba(0,0,0,0.16);
  }
  .blog-cta-illust-btn-secondary {
    background: rgba(255,255,255,0.15);
    color: #fff;
    border: 1px solid rgba(255,255,255,0.4);
    backdrop-filter: blur(8px);
