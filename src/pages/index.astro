---
import RenewalLayout from '../layouts/RenewalLayout.astro';
import HomeContent from '../components/pages/HomeContent.astro';
import { getLatestPosts, homeJsonLd } from '../lib/homeData';

const latestPosts = await getLatestPosts();
---

<RenewalLayout
  title="ホームページ制作・SEO対策｜最速3日・30,000円〜 Sane Design"
  description="ホームページ制作・LP制作・内部SEO対策なら Sane Design。最速3日納品・30,000円〜、個人事業主・中小企業・店舗のWeb集客を支援。DTP・WEB合わせて実績300件以上、オンラインで全国対応。"
  jsonLd={homeJsonLd}
>
  <HomeContent lang="ja" latestPosts={latestPosts} />
</RenewalLayout>
