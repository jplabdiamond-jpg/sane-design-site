  .illust.y{color:var(--yellow-dark);box-shadow:inset 0 0 0 3px #F6E3A4}
  .illust.o{color:var(--orange-dark);box-shadow:inset 0 0 0 3px #F8D6AC}

  /* buttons — 3D rounded pill */
