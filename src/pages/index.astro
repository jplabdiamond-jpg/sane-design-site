  .illust{background:#fff;border-radius:30px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;color:var(--primary-dark);font-size:13px;text-align:center;padding:16px;box-shadow:inset 0 0 0 3px #CDEBFA;font-weight:500}
  .illust svg{width:46px;height:46px;stroke-width:1.4}
