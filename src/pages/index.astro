<script>
(function(){
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if(reduce || !('IntersectionObserver' in window)) return;

  var cfg = [
    {sel:'.hero h1, .hero .lead, .hero-cta', step:110},
    {sel:'.hero-badge', cls:'badge-pop', step:170, base:380},
    {sel:'.hero-visual', cls:'zoom'},
    {sel:'.price-strip .ps-item', step:120},
    {sel:'.trust p', step:0},
    {sel:'.sec-head', step:0},
    {sel:'.worry-col.left .bubble', cls:'from-left', step:140},
    {sel:'.worry-col.right .bubble', cls:'from-right', step:140},
    {sel:'.worry-center', cls:'zoom'},
    {sel:'.transition .lead', step:0},
    {sel:'.reason .r-text', cls:'from-left'},
    {sel:'.reason .p-illust', cls:'from-right'},
    {sel:'.r01-visual', cls:'from-right'},
    {sel:'.r02-visual', cls:'from-left'},
    {sel:'.r03-visual', cls:'from-right'},
    {sel:'.svc-showcase', cls:'zoom'},
    {sel:'.svc', step:150},
    {sel:'.step', step:120},
    {sel:'.news-card', step:150},
    {sel:'.test', step:150},
    {sel:'.plan', cls:'from-left'},
    {sel:'.options-panel', cls:'from-right'},
    {sel:'.total-bar', cls:'zoom'},
    {sel:'.price-note', step:0},
    {sel:'.work', step:130},
    {sel:'details', step:90},
    {sel:'.final h2, .final p', step:130}
  ];
  cfg.forEach(function(c){
    var els = document.querySelectorAll(c.sel);
    Array.prototype.forEach.call(els, function(el, i){
      el.classList.add('reveal');
      if(c.cls) el.classList.add(c.cls);
      var delay = (c.base || 0) + i * (c.step || 0);
      if(delay) el.style.animationDelay = delay + 'ms';
    });
  });

  function cleanup(el){
    el.addEventListener('animationend', function handler(ev){
      if(ev.target !== el || ev.pseudoElement) return;
      el.removeEventListener('animationend', handler);
      el.classList.remove('reveal','is-visible','from-left','from-right','zoom');
      el.style.animationDelay = '';
    });
  }
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if(e.isIntersecting){ cleanup(e.target); e.target.classList.add('is-visible'); io.unobserve(e.target); }
    });
  }, {threshold:0.12, rootMargin:'0px 0px -8% 0px'});
  document.querySelectorAll('.reveal').forEach(function(el){ io.observe(el); });

  // header shrink on scroll — target RenewalLayout header
  var header = document.getElementById('rn-header');
  if(header){
    window.addEventListener('scroll', function(){
      header.classList.toggle('scrolled', window.scrollY > 40);
    }, {passive:true});
  }

  // trust logos marquee
  var tl = document.querySelector('.trust-logos');
  if(tl){
    var mask = document.createElement('div');
    mask.className = 'marquee-mask';
    tl.parentNode.insertBefore(mask, tl);
    mask.appendChild(tl);
    tl.innerHTML += tl.innerHTML;
    tl.classList.add('marquee');
  }
})();
</script>

<script>
/* ===== count-up for the price strip numbers ===== */
(function(){
  var nums=document.querySelectorAll('.ps-item .num');
  if(!nums.length || !('IntersectionObserver' in window)) return;
  if(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

  function fmt(el,v){
    var prefix=el.getAttribute('data-prefix')||'';
    return prefix + (el.getAttribute('data-comma')==='1' ? v.toLocaleString('ja-JP') : v);
  }
  function run(el){
    var to=parseInt(el.getAttribute('data-count'),10), dur=1300, t0=null;
    el.textContent=fmt(el,0);
    function step(ts){
      if(t0===null) t0=ts;
      var p=Math.min((ts-t0)/dur,1),
          eased=1-Math.pow(1-p,3);
      el.textContent=fmt(el, Math.round(to*eased));
      if(p<1){ requestAnimationFrame(step); }
      else { el.textContent=fmt(el,to); el.classList.add('counted'); }
    }
    requestAnimationFrame(step);
  }
  var io=new IntersectionObserver(function(es){
    es.forEach(function(e){ if(e.isIntersecting){ run(e.target); io.unobserve(e.target); } });
  },{threshold:0.4});
  Array.prototype.forEach.call(nums,function(el){ io.observe(el); });
})();

/* ===== hero works coverflow ===== */
(function(){
  var WORKS = [
    {img:"/assets/works/33-project-gadget-line.jpg",title:"GADGET LINE",url:"/works/33-project-gadget-line/"},
    {img:"/assets/works/35-project-lexus-lx.jpg",title:"レクサスLX買取専門店",url:"/works/35-project-lexus-lx/"},
    {img:"/assets/works/34-project-vod-navi.jpg",title:"VODナビ",url:"/works/34-project-vod-navi/"},
    {img:"/assets/works/32-project-lexus.jpg",title:"レクサスRX買取専門店",url:"/works/32-project-lexus/"},
    {img:"/assets/works/31-project-newsnow.jpg",title:"News Now",url:"/works/31-project-newsnow/"},
    {img:"/assets/works/19-project-aerotech.jpg",title:"AeroTech Co.",url:"/works/19-project-aerotech/"},
    {img:"/assets/works/26-project-biei.jpg",title:"星の光の宿BIEI",url:"/works/26-project-biei/"},
    {img:"/assets/works/20-project-kiryu.jpg",title:"お遍路宿 亀龍",url:"/works/20-project-kiryu/"},
    {img:"/assets/works/27-project-tasmoney.jpg",title:"Tas Money お小遣い稼ぎサイト",url:"/works/27-project-tasmoney/"},
    {img:"/assets/works/21-project-xpost.jpg",title:"XPost Pro",url:"/works/21-project-xpost/"},
    {img:"/assets/works/28-project-fxbot.jpg",title:"FX自動売買システム",url:"/works/28-project-fxbot/"},
    {img:"/assets/works/22-project-yorunavi.jpg",title:"夜ナビ Shine",url:"/works/22-project-yorunavi/"},
    {img:"/assets/works/29-project-rankru300.jpg",title:"ランクル300買取jp",url:"/works/29-project-rankru300/"},
    {img:"/assets/works/23-project-yorunavi-lp.jpg",title:"夜ナビ Shine LP",url:"/works/23-project-yorunavi-lp/"},
    {img:"/assets/works/30-project-tairyuji.jpg",title:"太龍寺ホームページ",url:"/works/30-project-tairyuji/"},
    {img:"/assets/works/24-project-yorunavi-check.jpg",title:"夜ナビ Shine Check",url:"/works/24-project-yorunavi-check/"},
    {img:"/assets/works/25-project-lumiere.jpg",title:"Lumière Gems",url:"/works/25-project-lumiere/"}
  ];
  var stage=document.getElementById('coverStage'),
      cap=document.getElementById('coverTitle'),
      wrap=document.getElementById('cover');
  if(!stage) return;
  var N=WORKS.length, center=0, timer=null, els=[];

  WORKS.forEach(function(w,i){
    var a=document.createElement('a');
    a.className='cover-card'; a.href=w.url;
    a.innerHTML='<img src="'+w.img+'" alt="'+w.title+'の制作実績" loading="lazy">';
    a.addEventListener('click',function(e){
      if(i!==center){ e.preventDefault(); center=i; render(); restart(); }
    });
    stage.appendChild(a); els.push(a);
  });

  function layout(off){
    var cw=(els[0] && els[0].offsetWidth) || 566;
    var n=Math.abs(off), x=0, gap=cw*0.359;
    for(var k=1;k<=n;k++){ x+=gap; gap*=0.62; }
    if(off<0) x=-x;
    return {x:x, scale:Math.pow(0.86,n), z:100-n, op:(n>3?0:1)};
  }
  function render(){
    els.forEach(function(el,i){
      var off=((i-center+N+Math.floor(N/2))%N)-Math.floor(N/2);
      var s=layout(off);
      el.style.transform='translateX('+s.x+'px) scale('+s.scale+')';
      el.style.zIndex=s.z;
      el.style.opacity=s.op;
      el.style.pointerEvents=s.op?'auto':'none';
      el.classList.toggle('is-center', off===0);
    });
    if(cap) cap.textContent=WORKS[center].title;
  }
  function next(){ center=(center+1)%N; render(); }
  function restart(){ clearInterval(timer); timer=setInterval(next,3200); }

  render();
  if(!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches)) restart();
  wrap.addEventListener('mouseenter',function(){ clearInterval(timer); });
  wrap.addEventListener('mouseleave',restart);
  var rz; window.addEventListener('resize',function(){ clearTimeout(rz); rz=setTimeout(render,150); },{passive:true});
})();
</script>

<script>
/* ===== sync options panel height to plan card ===== */
(function(){
  var plan = document.querySelector('.plan');
  var panel = document.querySelector('.options-panel');
  if(!plan || !panel) return;
  function sync(){
    if(window.innerWidth > 860){
      panel.style.maxHeight = plan.offsetHeight + 'px';
    } else {
      panel.style.maxHeight = '400px';
    }
  }
  sync();
  window.addEventListener('resize', sync);
})();

/* ===== pricing option toggle + total calc ===== */
(function(){
  var BASE = 20000;
  var PAGE_UNIT = 5000;
  var grid = document.getElementById('optGrid');
  var totalEl = document.getElementById('totalAmount');
  var pageSelect = document.getElementById('pageAddSelect');
  var pageItem = document.getElementById('optPageAdd');
  if(!grid || !totalEl) return;

  function fmt(n){ return n.toLocaleString('ja-JP'); }

  function recalc(){
    var sum = BASE;
    var items = grid.querySelectorAll('.opt-item.is-on:not(.opt-page-add)');
    Array.prototype.forEach.call(items, function(el){
      sum += parseInt(el.getAttribute('data-price'),10) || 0;
    });
    if(pageSelect){
      var pages = parseInt(pageSelect.value, 10) || 0;
      sum += pages * PAGE_UNIT;
    }
    totalEl.textContent = fmt(sum);
    var bar = document.getElementById('totalBar');
    if(bar){
      bar.style.transform = 'scale(1.02)';
      bar.style.transition = 'transform .18s cubic-bezier(.34,1.4,.64,1)';
      setTimeout(function(){ bar.style.transform = ''; }, 200);
    }
  }

  grid.addEventListener('click', function(e){
    if(e.target.closest('select')) return;
    var item = e.target.closest('.opt-item');
    if(!item || item.classList.contains('opt-page-add')) return;
    item.classList.toggle('is-on');
    recalc();
  });

  if(pageSelect && pageItem){
    pageSelect.addEventListener('change', function(){
      var pages = parseInt(pageSelect.value, 10) || 0;
      pageItem.classList.toggle('is-on', pages > 0);
      recalc();
    });
  }
})();

/* ===== other-options modal ===== */
(function(){
  var btn = document.getElementById('btnOtherOpts');
  var overlay = document.getElementById('modalOverlay');
  var close = document.getElementById('modalClose');
  if(!btn || !overlay) return;

  function open(){ overlay.classList.add('is-open'); document.body.style.overflow='hidden'; }
  function shut(){ overlay.classList.remove('is-open'); document.body.style.overflow=''; }

  btn.addEventListener('click', open);
  if(close) close.addEventListener('click', shut);
  overlay.addEventListener('click', function(e){ if(e.target === overlay) shut(); });
  document.addEventListener('keydown', function(e){ if(e.key === 'Escape' && overlay.classList.contains('is-open')) shut(); });
})();

/* ===== option tip popups ===== */
(function(){
  document.querySelectorAll('.opt-tip').forEach(function(tip){
    var popup = document.createElement('div');
    popup.className = 'opt-tip-popup';
    popup.textContent = tip.getAttribute('data-tip');
    tip.appendChild(popup);
    tip.addEventListener('click', function(e){
      e.preventDefault(); e.stopPropagation();
      var wasOpen = tip.classList.contains('is-open');
      document.querySelectorAll('.opt-tip.is-open').forEach(function(t){ t.classList.remove('is-open'); });
      if(!wasOpen) tip.classList.add('is-open');
    });
  });
  document.addEventListener('click', function(){ document.querySelectorAll('.opt-tip.is-open').forEach(function(t){ t.classList.remove('is-open'); }); });
})();

/* ===== free features modal ===== */
(function(){
  var btn = document.getElementById('btnFreeFeats');
  var overlay = document.getElementById('freeModalOverlay');
  var close = document.getElementById('freeModalClose');
  if(!btn || !overlay) return;

  function open(){ overlay.classList.add('is-open'); document.body.style.overflow='hidden'; }
  function shut(){ overlay.classList.remove('is-open'); document.body.style.overflow=''; }

  btn.addEventListener('click', open);
  if(close) close.addEventListener('click', shut);
  overlay.addEventListener('click', function(e){ if(e.target === overlay) shut(); });
  document.addEventListener('keydown', function(e){ if(e.key === 'Escape' && overlay.classList.contains('is-open')) shut(); });
})();

/* ===== testimonials carousel (mobile) ===== */
(function(){
  var grid = document.getElementById('testGrid');
  var prevBtn = document.getElementById('testPrev');
  var nextBtn = document.getElementById('testNext');
  if(!grid) return;
  var cards = grid.querySelectorAll('.test');
  var N = cards.length;
  if(N < 2) return;
  var idx = 0, timer = null;

  function isMobile(){ return window.innerWidth <= 860; }

  function goTo(i){
    idx = ((i % N) + N) % N;
    grid.style.transform = 'translateX(-' + (idx * 100) + '%)';
  }

  function next(){ goTo(idx + 1); }
  function prev(){ goTo(idx - 1); }

  function start(){ if(!timer) timer = setInterval(next, 2500); }
  function stop(){ clearInterval(timer); timer = null; }

  function reset(){
    if(isMobile()){
      grid.style.width = '';
      goTo(idx);
      start();
    } else {
      stop();
      idx = 0;
      grid.style.transform = '';
      grid.style.width = '';
    }
  }

  if(prevBtn) prevBtn.addEventListener('click', function(){ stop(); prev(); start(); });
  if(nextBtn) nextBtn.addEventListener('click', function(){ stop(); next(); start(); });

  reset();
  window.addEventListener('resize', reset);

  grid.addEventListener('mouseenter', stop);
  grid.addEventListener('mouseleave', function(){ if(isMobile()) start(); });
  grid.addEventListener('touchstart', stop, {passive:true});
  grid.addEventListener('touchend', function(){ if(isMobile()) start(); }, {passive:true});
})();
</script>
