  .btn-primary:hover{transform:translateY(2px);box-shadow:0 3px 0 var(--orange-dark)}
  .btn-blue{background:var(--primary);color:#fff;box-shadow:0 5px 0 var(--primary-deep)}
  .btn-blue:hover{transform:translateY(2px);box-shadow:0 3px 0 var(--primary-deep)}
  .btn-ghost{background:#fff;color:var(--primary-dark);box-shadow:0 5px 0 #CDEBFA;border:2px solid #CDEBFA}
  .btn-ghost:hover{transform:translateY(2px);box-shadow:0 3px 0 #CDEBFA}

  /* section base */
  section{padding:84px 0;position:relative}
