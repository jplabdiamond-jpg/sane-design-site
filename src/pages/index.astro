    padding:0 10% 4.07% 13%;text-align:center;font-size:clamp(14px,2.1vh,19px);font-weight:900;line-height:1.45;color:#BE2A2A}
  /* works coverflow */
  .cover{position:relative;width:100%;height:calc(var(--cardw) * 0.5625 + 6px);perspective:1600px}
  .cover-stage{position:absolute;inset:0}
  .cover-card{position:absolute;top:0;left:50%;width:var(--cardw);margin-left:calc(var(--cardw) / -2);border-radius:20px;overflow:hidden;
    background:#fff;box-shadow:0 12px 30px rgba(58,66,86,.20);cursor:pointer;
    transition:transform .85s cubic-bezier(.22,1,.36,1),opacity .85s,box-shadow .3s;will-change:transform}
  .cover-card img{width:100%;aspect-ratio:16/9;object-fit:cover;display:block}
  .cover-card::after{content:"";position:absolute;inset:0;background:rgba(30,45,70,.34);transition:opacity .6s;opacity:1}
  .cover-card.is-center::after{opacity:0}
  .cover-card.is-center{box-shadow:0 20px 44px rgba(58,66,86,.28)}
  .cover-card.is-center:hover{transform:translateX(0) scale(1.04)!important}
  .cover-cap{text-align:center;font-size:15px;font-weight:700;color:var(--text);margin-top:2px;line-height:1.5}
  .cover-cap em{display:block;font-style:normal;font-size:11px;color:var(--sub);font-weight:500;margin-top:1px}
  .p-illust{width:100%;height:auto;filter:drop-shadow(0 12px 18px rgba(58,66,86,.13))}
  .hero-badges{display:flex;gap:20px;margin-top:18px;flex-wrap:wrap;justify-content:center}
  .hero-badge{display:flex;align-items:center;gap:7px;font-size:13px;font-weight:700;font-family:"Noto Sans JP"}
  .hero-badge svg{width:22px;height:22px;color:#fff;background:var(--green);border-radius:50%;padding:4px;stroke-width:3;display:block}
  .hero-badge .ck{position:relative;display:inline-flex;line-height:0}
  .hero-badge .ck::after{content:"";position:absolute;inset:-3px;border-radius:50%;border:2px solid var(--green);opacity:0;pointer-events:none}

  /* trust strip */
  .trust{background:#fff;padding:26px 0}
  .trust p{text-align:center;font-size:13px;color:var(--sub);font-weight:700;font-family:"Noto Sans JP";margin-bottom:14px}
  .trust-logos{display:flex;justify-content:center;gap:16px;flex-wrap:wrap}
  .trust-logos span{background:#F2F5F8;color:#9aa3b0;border-radius:12px;padding:12px 22px;font-size:13px;font-weight:700}

  /* price strip */
  .price-strip{display:grid;grid-template-columns:repeat(3,1fr);gap:0;background:#fff;border-radius:26px;box-shadow:var(--shadow);overflow:hidden;margin-top:16px}
  .ps-item{text-align:center;padding:16px 14px;position:relative}
  .ps-item+.ps-item{border-left:2px dashed #E7ECF2}
  .ps-item .lbl-top{font-size:12px;color:var(--sub);font-weight:700;font-family:"Noto Sans JP"}
  .ps-item .big{font-family:"Inter";font-size:32px;font-weight:800;color:var(--primary);line-height:1.2}
  .ps-item .num{font-size:1.5em;color:var(--orange);font-weight:800;display:inline-block;font-variant-numeric:tabular-nums}
  .ps-item .lbl{font-size:12px;color:var(--sub)}

  /* WORRIES */
  .worry-stage{display:grid;grid-template-columns:1fr auto 1fr;gap:24px;align-items:center}
  .worry-col{display:flex;flex-direction:column;gap:20px}
  .bubble{background:#fff;border-radius:20px;padding:16px 20px;font-weight:700;font-family:"Noto Sans JP";font-size:15px;box-shadow:var(--shadow);position:relative}
  .worry-col.left .bubble::after{content:"";position:absolute;right:-11px;top:50%;transform:translateY(-50%);border:11px solid transparent;border-left-color:#fff}
  .worry-col.right .bubble::after{content:"";position:absolute;left:-11px;top:50%;transform:translateY(-50%);border:11px solid transparent;border-right-color:#fff}
  .bubble .ic{display:inline-flex;width:34px;height:34px;border-radius:50%;background:var(--cream-bg);align-items:center;justify-content:center;margin-bottom:6px}
  .bubble .ic svg{width:20px;height:20px;color:var(--orange);stroke-width:2}
  .worry-center{width:330px;flex-shrink:0}
  .worry-center img{width:100%;filter:none}

  /* transition */
  .transition{text-align:center;padding:52px 0 0}
  .transition .lead{font-family:"Noto Sans JP";font-size:24px;font-weight:900}
  .transition .lead .logo{font-family:"Inter";color:var(--primary);font-size:28px}
  .transition .arrow{margin:10px auto 0;width:0;height:0;border-left:26px solid transparent;border-right:26px solid transparent;border-top:26px solid var(--primary)}
  .transition > *+*{margin-top:10px}

  /* REASONS */
  .reason{display:grid;grid-template-columns:1fr 1fr;gap:44px;align-items:center;margin-bottom:80px}
  .reason:last-child{margin-bottom:0}
  .reason.rev .r-text{order:2}
  .r-head{display:flex;align-items:center;gap:20px;margin-bottom:14px}
  .r-num{position:relative;flex:0 0 auto;width:96px;height:96px;display:flex;align-items:center;justify-content:center;
    font-family:"Inter";font-weight:800;font-style:italic;font-size:44px;line-height:1;color:var(--primary-deep);
    background:linear-gradient(150deg,#EAF7FE 0%,#CFEBFB 100%);
    border:2px solid var(--primary);
    clip-path:polygon(22% 0,100% 0,100% 78%,78% 100%,0 100%,0 22%);
    box-shadow:0 0 0 5px rgba(79,180,232,.14),0 12px 26px rgba(28,111,156,.28)}
  .r-num span{position:relative;z-index:2;background:linear-gradient(180deg,#2E90C4,#1c6f9c);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
  .r-num::before{content:attr(data-n);position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
    font-family:"Inter";font-weight:800;font-style:italic;font-size:76px;color:var(--primary);opacity:.14;z-index:1}
  .r-num::after{content:"";position:absolute;top:8px;left:8px;right:8px;height:2px;background:linear-gradient(90deg,transparent,var(--primary),transparent);opacity:.7;z-index:2}
  .reason h3{font-size:26px;font-weight:900;line-height:1.4;margin:0}
  .reason .r-head+p, .r-text>p{margin-top:0}
  .reason p{font-size:15px;color:#5b6474;font-weight:500}
  .reason .illust{aspect-ratio:1.35/1}
  .r01-visual{position:relative;padding:20px 66px 10px 10px}
  .r01-chat{width:100%;border-radius:18px;box-shadow:0 18px 40px rgba(58,66,86,.18);border:5px solid #fff;transform:rotate(-2.5deg);position:relative;z-index:1}
  .r01-woman{position:absolute;z-index:3;right:-30px;bottom:-30px;width:190px;filter:drop-shadow(-6px 10px 14px rgba(58,66,86,.22))}
  .r01-tag{position:absolute;z-index:4;top:0;left:0;display:inline-flex;align-items:center;gap:7px;background:#06C755;color:#fff;font-weight:700;font-size:14px;padding:8px 18px;border-radius:999px;box-shadow:0 6px 16px rgba(6,199,85,.4)}
  .r01-tag svg{width:18px;height:18px}
  .reason:nth-child(2) .r-num{background:linear-gradient(150deg,#EAF7E4 0%,#CFE9C0 100%);border-color:var(--green);box-shadow:0 0 0 5px rgba(120,194,94,.16),0 12px 26px rgba(59,109,17,.26)}
  .reason:nth-child(2) .r-num span{background:linear-gradient(180deg,#5aa03e,#3B6D11);-webkit-background-clip:text;background-clip:text}
  .reason:nth-child(2) .r-num::before,.reason:nth-child(2) .r-num::after{color:var(--green);background:linear-gradient(90deg,transparent,var(--green),transparent)}
  .reason:nth-child(2) .r-num::before{background:none}
  .r02-visual{position:relative;padding:16px 10px 10px 56px}
  .r02-doc{width:82%;margin-left:auto;display:block;border-radius:12px;box-shadow:0 20px 44px rgba(58,66,86,.16);transform:rotate(2.5deg)}
  .r02-man{position:absolute;z-index:3;left:-30px;bottom:-30px;width:210px;filter:drop-shadow(6px 10px 14px rgba(58,66,86,.22))}
  .r02-tag{position:absolute;z-index:4;top:0;right:6px;display:inline-flex;align-items:center;gap:7px;background:var(--green);color:#fff;font-weight:700;font-size:14px;padding:8px 18px;border-radius:999px;box-shadow:0 6px 16px rgba(120,194,94,.45)}
  .r02-tag svg{width:17px;height:17px}
  .r02-doc{transition:transform .45s}
  .reason:hover .r02-doc{transform:rotate(1deg) scale(1.02)}
  .r02-man{animation:floatySm 5.8s ease-in-out .4s infinite}
  .r03-visual{position:relative;padding:22px 20px 10px 10px}
  .r03-banner{width:100%;border-radius:16px;box-shadow:0 18px 40px rgba(28,60,90,.28);border:5px solid #fff;transform:rotate(-2deg);position:relative;z-index:1}
  .r03-man{position:absolute;z-index:3;right:-34px;bottom:-38px;width:235px;filter:drop-shadow(-6px 10px 14px rgba(58,66,86,.22))}
  .r03-tag{position:absolute;z-index:4;top:0;left:0;display:inline-flex;align-items:center;gap:7px;background:var(--orange);color:#fff;font-weight:700;font-size:14px;padding:8px 18px;border-radius:999px;box-shadow:0 6px 16px rgba(247,155,62,.45)}
  .r03-tag svg{width:17px;height:17px}
  .r03-banner{transition:transform .45s}
  .reason:hover .r03-banner{transform:rotate(-.6deg) scale(1.02)}
  .r03-man{animation:floatySm 5.6s ease-in-out .2s infinite}
  .reason:nth-child(3) .r-num{background:linear-gradient(150deg,#FDEFDF 0%,#FAD9B4 100%);border-color:var(--orange);box-shadow:0 0 0 5px rgba(247,155,62,.18),0 12px 26px rgba(199,111,20,.26)}
  .reason:nth-child(3) .r-num span{background:linear-gradient(180deg,#e07f1e,#c76f14);-webkit-background-clip:text;background-clip:text}
  .reason:nth-child(3) .r-num::before{color:var(--orange);background:none}
  .reason:nth-child(3) .r-num::after{background:linear-gradient(90deg,transparent,var(--orange),transparent)}

  /* SERVICES */
  .svc-showcase{display:flex;align-items:flex-end;justify-content:center;gap:8px;margin:0 auto 34px;max-width:960px}
  .svc-lead{display:block;width:300px;flex:0 0 auto;filter:drop-shadow(0 14px 22px rgba(58,66,86,.14))}
  .mock{position:relative;flex:0 0 auto}
  .mock-frame{position:relative;z-index:2;width:100%;display:block;pointer-events:none;filter:drop-shadow(0 16px 26px rgba(58,66,86,.20))}
  .mock-screen{position:absolute;z-index:1;overflow:hidden;background:#0b0018}
  .mock-shot{width:100.6%;margin-left:-0.3%;display:block}
  .mock-phone{width:190px}
  .mock-phone .mock-screen{left:5.848%;top:2.382%;width:88.304%;height:95.119%;border-radius:8.5%/4.4%}
  .mock-laptop{width:430px;margin-bottom:6px}
  .mock-laptop .mock-screen{left:11.765%;top:6.773%;width:76.471%;height:82.171%}
  .mock-phone .mock-shot{animation:scrollPhone 32s ease-in-out infinite}
  .mock-laptop .mock-shot{animation:scrollDesk 18.6s ease-in-out infinite}
  @keyframes scrollPhone{0%,6%{transform:translateY(0)}50%,56%{transform:translateY(-91.91%)}100%{transform:translateY(0)}}
  @keyframes scrollDesk{0%,7%{transform:translateY(0)}50%,57%{transform:translateY(-84.40%)}100%{transform:translateY(0)}}
  .svc-grid{display:grid;grid-template-columns:1fr 1fr;gap:28px}
  .svc{background:#fff;border-radius:var(--radius);padding:38px;box-shadow:var(--shadow);text-align:center;transition:.15s}
  .svc:hover{transform:translateY(-6px)}
  .svc .ico{width:96px;height:96px;border-radius:50%;background:var(--sky-bg);display:flex;align-items:center;justify-content:center;margin:0 auto 20px}
  .svc .ico svg{width:46px;height:46px;color:var(--primary);stroke-width:1.5}
  .svc.green .ico{background:var(--mint-bg)} .svc.green .ico svg{color:var(--green)}
  .svc h3{font-size:23px;font-weight:900;margin-bottom:12px}
  .svc p{font-size:14px;color:#5b6474;margin-bottom:22px;font-weight:500}

  /* FLOW */
  .flow-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}
  .step{background:#fff;border-radius:var(--radius);padding:22px 18px;text-align:center;position:relative;box-shadow:var(--shadow)}
  .step .st{font-family:"Inter";font-size:14px;font-weight:800;color:#fff;background:var(--primary);border-radius:999px;padding:2px 16px;display:inline-block;margin-bottom:12px}
  .step-img{aspect-ratio:1.4/1;margin-bottom:14px;display:flex;align-items:center;justify-content:center}
  .step-img img{max-width:100%;max-height:100%;display:block}
  .step-img .step-shot{width:100%;height:100%;object-fit:cover;object-position:top;border-radius:12px;box-shadow:0 6px 16px rgba(58,66,86,.12)}
  .step h4{font-size:18px;font-weight:900;margin-bottom:6px}
  .step p{font-size:13px;color:var(--sub)}
  .step:not(:last-child)::after{content:"";position:absolute;right:-13px;top:50%;transform:translateY(-50%);z-index:2;width:0;height:0;border-top:10px solid transparent;border-bottom:10px solid transparent;border-left:14px solid var(--primary)}

  /* NEWS */
  .news-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:26px}
  .news-card{display:flex;flex-direction:column;background:#fff;border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow);transition:transform .2s,box-shadow .2s}
  .news-card:hover{transform:translateY(-6px);box-shadow:0 20px 40px rgba(58,66,86,.14)}
  .news-thumb{aspect-ratio:16/9;overflow:hidden;background:#EEF1F4}
  .news-thumb img{width:100%;height:100%;object-fit:cover;transition:transform .5s}
  .news-card:hover .news-thumb img{transform:scale(1.06)}
  .news-body{padding:18px 20px 22px;display:flex;flex-direction:column;flex:1}
  .news-date{font-family:"Inter";font-size:13px;font-weight:700;color:var(--primary);letter-spacing:.5px}
  .news-body h4{font-size:15px;font-weight:700;line-height:1.6;margin:8px 0 14px;color:var(--text);
    display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
  .news-more{margin-top:auto;display:inline-flex;align-items:center;gap:6px;font-size:13px;font-weight:700;color:var(--primary-dark)}
  .news-more svg{width:15px;height:15px}

  /* TESTIMONIALS */
  .test-carousel{position:relative}
  .test-track-wrap{overflow:hidden}
  .test-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}
  @media(max-width:1000px) and (min-width:861px){.test-grid{grid-template-columns:repeat(2,1fr)}}
  .test-nav{display:none}
  .test-nav{position:absolute;top:50%;transform:translateY(-50%);z-index:5;width:36px;height:36px;border-radius:50%;border:none;background:rgba(255,255,255,.92);box-shadow:0 4px 14px rgba(58,66,86,.18);font-size:22px;font-weight:700;color:var(--primary-dark);cursor:pointer;line-height:1;transition:background .2s,transform .2s}
  .test-nav:hover{background:#fff;transform:translateY(-50%) scale(1.1)}
  .test-prev{left:-4px}
  .test-next{right:-4px}
  .test{background:#fff;border-radius:var(--radius);padding:28px;box-shadow:var(--shadow);display:flex;flex-direction:column}
  .test .stars{color:var(--yellow);font-size:17px;margin-bottom:12px;letter-spacing:2px}
  .test .metric{background:var(--mint-bg);color:var(--green-dark);font-size:12px;font-weight:700;font-family:"Noto Sans JP";padding:5px 14px;border-radius:999px;display:inline-block;margin-bottom:14px;align-self:flex-start}
  .test p{font-size:14px;margin-bottom:18px;font-weight:500;flex:1}
  .test .who{display:flex;flex-direction:column;align-items:center;text-align:center;gap:4px;border-top:2px dashed #EEF1F4;padding-top:18px;margin-top:2px}
  .test .ava{width:104px;height:104px;border-radius:50%;background:var(--cream-bg);overflow:hidden;flex:0 0 auto;margin-bottom:8px;box-shadow:0 6px 16px rgba(58,66,86,.12)}
  .test .ava img{width:100%;height:100%;object-fit:cover;display:block}
  .test .who b{font-size:14px;display:block;font-family:"Noto Sans JP";line-height:1.5}
  .test .who small{font-size:12px;color:var(--sub)}

  /* PRICING */
  .pricing-layout{display:grid;grid-template-columns:340px 1fr;gap:28px;align-items:start}
  .plan{background:#fff;border-radius:var(--radius);padding:34px 26px;box-shadow:0 12px 34px rgba(79,180,232,.28);border:3px solid var(--primary);text-align:center;position:relative;overflow:visible}
  .plan .ribbon{position:absolute;top:-16px;left:0;right:0;margin:0 auto;width:fit-content;background:var(--orange);color:#fff;font-family:"Noto Sans JP";font-size:13px;font-weight:700;padding:6px 22px;border-radius:999px;white-space:nowrap;box-shadow:0 4px 0 var(--orange-dark)}
  .plan h3{font-size:21px;font-weight:900}
  .plan .for{font-size:12px;color:var(--sub);margin:4px 0 18px;font-weight:500}
  .plan .price{font-family:"Inter";font-size:38px;font-weight:800;color:var(--text);line-height:1.1}
  .plan .price small{font-size:15px;color:var(--sub);font-family:"Noto Sans JP"}
  .plan ul{list-style:none;text-align:left;margin:22px 0;font-size:14px}
  .plan ul li{padding:8px 0;border-bottom:1px dashed #E7ECF2;display:flex;gap:8px;font-weight:500}
  .plan ul li svg{width:18px;height:18px;color:var(--green);flex-shrink:0;margin-top:5px;stroke-width:3}
  .options-panel{background:#fff;border-radius:var(--radius);padding:28px;box-shadow:var(--shadow);display:flex;flex-direction:column;overflow:hidden}
  .options-panel h4{font-size:18px;font-weight:900;margin-bottom:6px;display:flex;align-items:center;gap:8px}
  .options-panel h4 svg{width:22px;height:22px;color:var(--primary);stroke-width:2}
  .options-panel .opt-sub{font-size:13px;color:var(--sub);margin-bottom:18px;font-weight:500}
  .opt-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;flex:1;min-height:0;overflow-y:auto;padding-right:6px;scrollbar-width:thin;scrollbar-color:var(--primary) #e8f0f6;align-content:start}
  .opt-grid::-webkit-scrollbar{width:6px}
  .opt-grid::-webkit-scrollbar-track{background:#e8f0f6;border-radius:3px}
  .opt-grid::-webkit-scrollbar-thumb{background:var(--primary);border-radius:3px}
  .opt-item{display:flex;align-items:center;gap:12px;background:var(--sky-bg);border-radius:16px;padding:14px 16px;cursor:pointer;border:2px solid transparent;transition:border-color .2s,background .2s,transform .15s;user-select:none}
  .opt-item:hover{transform:translateY(-2px);background:#daeefb}
  .opt-item.is-on{border-color:var(--primary);background:#d4ecfa}
  .opt-check{width:24px;height:24px;border-radius:8px;border:2px solid #c0d0de;background:#fff;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:background .2s,border-color .2s}
  .opt-item.is-on .opt-check{background:var(--primary);border-color:var(--primary)}
  .opt-check svg{width:14px;height:14px;color:#fff;stroke-width:3;opacity:0;transition:opacity .15s}
  .opt-item.is-on .opt-check svg{opacity:1}
  .opt-info{flex:1;min-width:0}
  .opt-name{font-size:14px;font-weight:700;font-family:"Noto Sans JP";line-height:1.4}
  .opt-price{font-family:"Inter";font-size:13px;font-weight:700;color:var(--primary-dark);margin-top:2px}
  .total-bar{margin-top:28px;background:linear-gradient(135deg,#4FB4E8 0%,#69C6D9 100%);border-radius:20px;padding:22px 30px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px}
  .total-bar .total-label{color:rgba(255,255,255,.92);font-size:15px;font-weight:700;font-family:"Noto Sans JP"}
  .total-bar .total-label small{display:block;font-size:12px;font-weight:500;opacity:.85;margin-top:2px}
  .total-bar .total-price{font-family:"Inter";font-size:40px;font-weight:800;color:#fff;line-height:1.1}
  .total-bar .total-price small{font-size:16px;font-family:"Noto Sans JP";font-weight:700}
  .total-bar .total-price .yen{font-size:22px}
  .price-note{max-width:740px;margin:32px auto 0;background:#fff;border-radius:20px;padding:20px 26px;box-shadow:var(--shadow);font-size:14px;text-align:center;font-weight:500}
  .price-note b{color:var(--primary-dark);font-family:"Noto Sans JP"}
  .opt-select{display:block;width:100%;margin-top:8px;padding:8px 12px;border:2px solid #c0d0de;border-radius:10px;font-family:"Noto Sans JP";font-size:13px;font-weight:700;color:var(--text);background:#fff;cursor:pointer;appearance:auto;-webkit-appearance:auto;transition:border-color .2s}
  .opt-select:focus{outline:none;border-color:var(--primary)}
  .opt-item.is-on .opt-select{border-color:var(--primary)}
  .btn-other-opts{display:flex;align-items:center;justify-content:center;gap:8px;width:100%;margin-top:20px;padding:14px 20px;border:2px dashed #c0d0de;border-radius:16px;background:none;font-family:"Noto Sans JP";font-size:14px;font-weight:700;color:var(--sub);cursor:pointer;transition:border-color .2s,color .2s,background .2s}
  .btn-other-opts svg{width:18px;height:18px;stroke-width:2.5}
  .btn-other-opts:hover{border-color:var(--primary);color:var(--primary);background:var(--sky-bg)}
  .modal-overlay{display:none;position:fixed;inset:0;z-index:200;background:rgba(58,66,86,.45);backdrop-filter:blur(4px);align-items:center;justify-content:center;padding:20px}
  .modal-overlay.is-open{display:flex}
  .modal-box{background:#fff;border-radius:var(--radius);padding:32px 28px 28px;max-width:600px;width:100%;box-shadow:0 24px 60px rgba(58,66,86,.22);position:relative;animation:fadeUp .35s cubic-bezier(.22,1,.36,1) both}
  .modal-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:8px}
