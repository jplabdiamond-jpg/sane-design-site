---
import RenewalLayout from '../layouts/RenewalLayout.astro';
---

<RenewalLayout
  title="お問い合わせ｜Sane Design"
  description="Sane Designへのお問い合わせ。ご依頼内容・ご予算・オプションを選ぶだけ。24時間以内にご返信します。"
>

  <!-- ── Hero ── -->
  <section class="ct-hero reveal">
    <div class="wrap">
      <span class="sec-sub">Contact</span>
      <div class="ct-hero-illust">
        <img src="/assets/creator_thumbsup_tablet.webp" alt="タブレットを持つクリエイター">
      </div>
      <h1>まずはお気軽に<span class="big">ご相談ください</span></h1>
      <p class="lead">ご依頼内容・ご予算・オプションを選ぶだけ。<br>入力は約1分、24時間以内にご返信します。</p>
      <div class="hero-badges">
        <span class="hero-badge"><i class="ck"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg></i>相談だけでもOK</span>
        <span class="hero-badge"><i class="ck"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg></i>しつこい営業なし</span>
        <span class="hero-badge"><i class="ck"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg></i>24時間以内に返信</span>
      </div>
    </div>
  </section>

  <!-- ── Wave ── -->
  <div class="wave"><svg viewBox="0 0 1200 60" preserveAspectRatio="none"><path d="M0,60 C300,0 900,0 1200,60 L1200,0 L0,0 Z" fill="#fff"/></svg></div>

  <!-- ── Form Section ── -->
  <section class="ct-form-section" style="background:var(--cream-bg)">
    <div class="wrap">
      <div class="ct-form-wrap">

        <!-- Step Tabs -->
        <div class="step-tabs reveal" id="stepTabs">
          <div class="step-tab active" data-step="1">
            <span class="st-num">1</span>
            <span class="st-label">プラン・オプション選択</span>
          </div>
          <div class="step-tab" data-step="2">
            <span class="st-num">2</span>
            <span class="st-label">お客様情報入力</span>
          </div>
          <div class="step-tab" data-step="3">
            <span class="st-num">3</span>
            <span class="st-label">送信完了</span>
          </div>
        </div>

        <form id="contact-form" action="https://api.web3forms.com/submit" method="POST">
          <!-- Hidden fields -->
          <input type="hidden" name="access_key" value="7bcc6bbc-01d3-4a99-a783-3cdad33fbaa5">
          <input type="hidden" name="subject" value="【Sane Design】お問い合わせ（料金込み）">
          <input type="hidden" name="from_name" value="Sane Design お問い合わせフォーム">
          <input type="checkbox" name="botcheck" style="display:none">
          <input type="hidden" name="selected_plan" id="hiddenPlan" value="LP・WEBサイト制作プラン（基本料金 ¥20,000〜）">
          <input type="hidden" name="selected_options" id="hiddenOptions" value="">
          <input type="hidden" name="total_amount" id="hiddenTotal" value="¥20,000〜">

          <!-- ════════ STEP 1: Plan & Options ════════ -->
          <div class="step-panel active" id="step1">
            <div class="form-card reveal">
              <div class="form-sec-head">
                <h2>プランとオプションを選ぶ</h2>
                <p>ご希望のプランを選んで、必要なオプションを追加できます。</p>
              </div>

              <!-- Plan Selector -->
              <div class="plan-selector" id="planSelector">
                <div class="plan-sel-card active" data-plan="web" id="planCardWeb">
                  <span class="ps-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg></span>
                  <span class="ps-badge">WEB制作</span>
                  <span class="ps-name">LP・WEBサイト制作</span>
                  <span class="ps-price">¥20,000<small>〜</small></span>
                  <span class="ps-desc">スマホ対応・フォーム込み</span>
                </div>
                <div class="plan-sel-card" data-plan="seo" id="planCardSeo">
                  <span class="ps-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg></span>
                  <span class="ps-badge">SEO</span>
                  <span class="ps-name">SEO対策プラン</span>
                  <span class="ps-price">¥10,000<small>〜</small></span>
                  <span class="ps-desc">60記事追加＋内部SEO</span>
                </div>
              </div>
              <p style="font-size:12px;color:var(--text-muted);margin-bottom:20px;margin-top:-16px;text-align:center">両方のプランを同時に選択して合算できます</p>

              <!-- Consultation Only -->
              <div class="consult-only-wrap">
                <div class="consult-card" id="consultCard">
                  <span class="cc-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg></span>
                  <span class="cc-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></span>
                  <span class="cc-text">
                    <span class="cc-name">まずは相談だけをする</span>
                    <span class="cc-desc">プランが決まっていない方もお気軽にご相談ください</span>
                  </span>
                </div>
                <div class="consult-alert" id="consultAlert">
                  「LP・WEBサイト制作」または「SEO対策プラン」のチェックを外してから選択してください。
                </div>
              </div>

              <!-- ▼ WEB制作プランパネル ▼ -->
              <div class="plan-panel active" id="panelWeb">
                <div class="plan-summary">
                  <span class="plan-badge">基本プラン</span>
                  <div class="plan-info">
                    <h3>LP・WEBサイト制作プラン</h3>
                    <div style="font-size:13px;color:var(--text-muted);margin-top:2px">スマホ対応・フォーム込み・オリジナルデザイン</div>
                  </div>
                  <div class="plan-price">¥20,000<small>〜</small></div>
                </div>

                <h4 style="font-size:15px;font-weight:900;margin-bottom:14px;display:flex;align-items:center;gap:8px">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" style="width:20px;height:20px;stroke-width:2.5"><path d="M12 5v14M5 12h14"/></svg>
                  追加オプション
                </h4>
                <p style="font-size:13px;color:var(--text-muted);margin-bottom:16px">必要に応じて追加オプションをお選びください。</p>

                <div class="opt-grid" id="optGrid">
                  <div class="opt-item opt-page-add" data-price="0" id="optPageAdd">
                    <div class="opt-row">
                      <span class="opt-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg></span>
                      <span class="opt-info">
                        <span class="opt-name">ページ追加</span>
                        <span class="opt-price">1ページあたり + 5,000円</span>
                      </span>
                    </div>
                    <select id="pageAddSelect" class="opt-select">
                      <option value="0">追加なし（1P基本）</option>
                      <option value="1">+1ページ（5,000円）</option>
                      <option value="2">+2ページ（10,000円）</option>
                      <option value="3">+3ページ（15,000円）</option>
                      <option value="4">+4ページ（20,000円）</option>
                      <option value="5">+5ページ（25,000円）</option>
                    </select>
                  </div>
                  <label class="opt-item" data-price="3000" data-name="サーバーへの直接アップロード">
                    <input type="checkbox"><span class="opt-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg></span>
                    <span class="opt-info"><span class="opt-name">サーバーへの直接アップロード（公開まで実施）</span><span class="opt-price">+ 3,000円</span></span>
                  </label>
                  <label class="opt-item" data-price="5000" data-name="予約機能付きカレンダー導入">
                    <input type="checkbox"><span class="opt-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg></span>
                    <span class="opt-info"><span class="opt-name">予約機能付きカレンダー導入</span><span class="opt-price">+ 5,000円</span></span>
                  </label>
                  <label class="opt-item" data-price="5000" data-name="チャットボット導入">
                    <input type="checkbox"><span class="opt-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg></span>
                    <span class="opt-info"><span class="opt-name">チャットボット導入（Tidio等）</span><span class="opt-price">+ 5,000円</span></span>
                  </label>
                  <label class="opt-item" data-price="2000" data-name="Googleアナリティクス（GA4）設置">
                    <input type="checkbox"><span class="opt-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg></span>
                    <span class="opt-info"><span class="opt-name">Googleアナリティクス（GA4）設置</span><span class="opt-price">+ 2,000円</span></span>
                  </label>
                  <label class="opt-item" data-price="2000" data-name="GSC（Googleサーチコンソール）登録">
                    <input type="checkbox"><span class="opt-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg></span>
                    <span class="opt-info"><span class="opt-name">GSC（Googleサーチコンソール）登録</span><span class="opt-price">+ 2,000円</span></span>
                  </label>
                  <label class="opt-item" data-price="2000" data-name="SNSフィード埋め込み">
                    <input type="checkbox"><span class="opt-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg></span>
                    <span class="opt-info"><span class="opt-name">SNSフィード埋め込み（Instagram等）</span><span class="opt-price">+ 2,000円</span></span>
                  </label>
                  <label class="opt-item" data-price="1000" data-name="LINE公式アカウント連携">
                    <input type="checkbox"><span class="opt-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg></span>
                    <span class="opt-info"><span class="opt-name">LINE公式アカウント連携</span><span class="opt-price">+ 1,000円</span></span>
                  </label>
                  <label class="opt-item" data-price="4000" data-name="ブログ/お知らせ更新機能">
                    <input type="checkbox"><span class="opt-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg></span>
                    <span class="opt-info"><span class="opt-name">ブログ/お知らせ更新機能</span><span class="opt-price">+ 4,000円</span></span>
                  </label>
                  <label class="opt-item" data-price="6000" data-name="決済機能（Stripe等）">
                    <input type="checkbox"><span class="opt-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg></span>
                    <span class="opt-info"><span class="opt-name">決済機能（Stripe等）</span><span class="opt-price">+ 6,000円</span></span>
                  </label>
                  <label class="opt-item" data-price="10000" data-name="会員限定コンテンツ（認証機能含む）">
                    <input type="checkbox"><span class="opt-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg></span>
                    <span class="opt-info"><span class="opt-name">会員限定コンテンツ（認証機能含む）</span><span class="opt-price">+ 10,000円</span></span>
                  </label>
                  <label class="opt-item" data-price="5000" data-name="月額保守・更新代行">
                    <input type="checkbox"><span class="opt-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg></span>
                    <span class="opt-info"><span class="opt-name">月額保守・更新代行</span><span class="opt-price">+ 5,000円/月</span></span>
                  </label>
                  <label class="opt-item" data-price="4000" data-name="ドメイン・サーバー初期設定">
                    <input type="checkbox"><span class="opt-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg></span>
                    <span class="opt-info"><span class="opt-name">ドメイン・サーバー初期設定</span><span class="opt-price">+ 4,000円</span></span>
                  </label>
                  <div class="opt-item" data-price="10000" data-name="管理者ダッシュボード設置">
                    <label style="display:flex;align-items:center;gap:12px;cursor:pointer;flex:1">
                      <input type="checkbox"><span class="opt-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg></span>
                      <span class="opt-info">
                        <span class="opt-name">管理者ダッシュボード設置</span>
                        <span class="opt-price">+ 10,000円</span>
                      </span>
                    </label>
                    <div class="opt-tip-wrap">
                      <button type="button" class="opt-tip-btn" aria-label="詳細"><svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-1-5h2v2h-2zm0-8h2v6h-2z"/></svg></button>
                      <div class="opt-tip-popup">サイトの各ページのテキストや見出し文言の変更、画像の変更・問い合わせ項目のテキスト変更ができるようになります。※変更できる箇所はサイト上の全ての画像やテキストではありませんので、まずはご相談ください。</div>
                    </div>
                  </div>
                </div>
                <div class="scroll-hint" id="scrollHint" style="text-align:center;font-size:12px;color:var(--text-muted);padding:8px 0;display:flex;align-items:center;justify-content:center;gap:6px;opacity:.7">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" style="width:16px;height:16px;stroke-width:2.5;animation:bounceDown 1.2s infinite"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
                  スクロールして他のオプションも見る
                </div>
              </div>

              <!-- ▼ SEO対策プランパネル ▼ -->
              <div class="plan-panel" id="panelSeo">
                <div class="plan-divider">SEO対策プラン</div>
                <div class="plan-summary seo-summary">
                  <span class="plan-badge">SEOプラン</span>
                  <div class="plan-info">
                    <h3>SEO対策プラン</h3>
                    <div style="font-size:13px;color:var(--text-muted);margin-top:2px">指定KW 60記事追加＋内部SEO対策</div>
                  </div>
                  <div class="plan-price">¥10,000<small>〜</small></div>
                </div>

                <h4 style="font-size:15px;font-weight:900;margin-bottom:14px;display:flex;align-items:center;gap:8px">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" style="width:20px;height:20px;stroke-width:2.5"><path d="M12 5v14M5 12h14"/></svg>
                  SEOオプション
                </h4>
                <p style="font-size:13px;color:var(--text-muted);margin-bottom:16px">必要に応じて追加オプションをお選びください。</p>

                <div class="opt-grid" id="optGridSeo">
                  <div class="opt-item opt-page-add" data-price="0" id="optArticleAdd">
                    <div class="opt-row">
                      <span class="opt-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg></span>
                      <span class="opt-info">
                        <span class="opt-name">追加記事</span>
                        <span class="opt-price">10記事あたり + 3,000円</span>
                      </span>
                    </div>
                    <select id="articleAddSelect" class="opt-select">
                      <option value="0">追加なし（基本60記事）</option>
                      <option value="1">+10記事（3,000円）</option>
                      <option value="2">+20記事（6,000円）</option>
                      <option value="3">+30記事（9,000円）</option>
                      <option value="4">+40記事（12,000円）</option>
                      <option value="5">+50記事（15,000円）</option>
                    </select>
                  </div>
                  <label class="opt-item" data-price="2000" data-name="Googleアナリティクス（GA4）設置">
                    <input type="checkbox"><span class="opt-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg></span>
                    <span class="opt-info"><span class="opt-name">Googleアナリティクス（GA4）設置</span><span class="opt-price">+ 2,000円</span></span>
                  </label>
                  <label class="opt-item" data-price="2000" data-name="GSC（Googleサーチコンソール）登録">
                    <input type="checkbox"><span class="opt-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg></span>
                    <span class="opt-info"><span class="opt-name">GSC（Googleサーチコンソール）登録</span><span class="opt-price">+ 2,000円</span></span>
                  </label>
                  <label class="opt-item" data-price="5000" data-name="競合分析レポート">
                    <input type="checkbox"><span class="opt-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg></span>
                    <span class="opt-info"><span class="opt-name">競合分析レポート</span><span class="opt-price">+ 5,000円</span></span>
                  </label>
                  <label class="opt-item" data-price="3000" data-name="メタタグ・構造化データ最適化">
                    <input type="checkbox"><span class="opt-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg></span>
                    <span class="opt-info"><span class="opt-name">メタタグ・構造化データ最適化</span><span class="opt-price">+ 3,000円</span></span>
                  </label>
                  <label class="opt-item" data-price="5000" data-name="月額SEO保守・レポート">
                    <input type="checkbox"><span class="opt-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg></span>
                    <span class="opt-info"><span class="opt-name">月額SEO保守・レポート</span><span class="opt-price">+ 5,000円/月</span></span>
                  </label>
                </div>
              </div>

              <!-- Total Bar -->
              <div class="total-bar" id="totalBar">
                <div class="total-label">お見積り合計<small>基本プラン＋選択オプション</small></div>
                <div class="total-price"><span class="yen">¥</span><span id="totalAmount">20,000</span><small>〜（税込）</small></div>
              </div>

              <p style="font-size:12px;color:var(--text-muted);margin-top:12px;line-height:1.7;text-align:center">
                ※ 上記は目安料金です。内容に応じて最適なお見積りをご提案します。
              </p>

              <!-- Step Nav -->
              <div class="step-nav">
                <span></span>
                <button type="button" class="btn btn-primary" id="toStep2">
                  お客様情報の入力へ
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </button>
              </div>
            </div>
          </div>

          <!-- ════════ STEP 2: Contact Info ════════ -->
          <div class="step-panel" id="step2">
            <div class="form-card reveal">
              <div class="form-sec-head">
                <h2>お客様情報の入力</h2>
                <p>ご連絡先とご要望をご入力ください。</p>
              </div>

              <div class="selected-summary" id="selectedSummary">
                <h4>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                  選択中のプラン・オプション
                </h4>
                <div class="selected-list" id="selectedList"></div>
              </div>

              <div class="form-group">
                <label>お名前<span class="req">*必須</span></label>
                <input type="text" name="name" required placeholder="山田 太郎" class="form-input">
              </div>
              <div class="form-group">
                <label>メールアドレス<span class="req">*必須</span></label>
                <input type="email" name="email" required placeholder="your@email.com" class="form-input">
              </div>
              <div class="form-group">
                <label>電話番号<small style="font-weight:400;color:var(--text-muted);margin-left:6px">（任意）</small></label>
                <input type="tel" name="phone" placeholder="090-1234-5678" class="form-input">
              </div>
              <div class="form-group">
                <label>ご依頼・ご相談の種類</label>
                <select name="service" class="form-input" style="cursor:pointer">
                  <option value="">選択してください</option>
                  <option value="ホームページ制作">ホームページ制作</option>
                  <option value="LP制作">LP制作</option>
                  <option value="SEO対策">SEO対策</option>
                  <option value="その他">その他</option>
                </select>
              </div>
              <div class="form-group">
                <label>メッセージ<span class="req">*必須</span></label>
                <textarea name="message" required rows="5" placeholder="ご依頼内容・ご予算・ご希望納期などをご記入ください" class="form-input"></textarea>
              </div>

              <div id="formError" class="error-msg"></div>

              <div class="step-nav">
                <button type="button" class="btn btn-ghost" id="backToStep1">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" style="transform:rotate(180deg)"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                  プラン選択に戻る
                </button>
                <button type="submit" class="btn btn-primary" id="submitBtn">
                  この内容で送信する
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </button>
              </div>
            </div>
          </div>

          <!-- ════════ STEP 3: Confirmation ════════ -->
          <div class="step-panel" id="step3">
            <div class="confirm-card reveal">
              <div class="check-circle">
