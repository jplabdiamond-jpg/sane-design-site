---
import RenewalLayout from '../../../layouts/RenewalLayout.astro';
import WebDesignContent from '../../../components/pages/services/WebDesignContent.astro';
import { SITE_URL } from '../../../consts';

const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Website production',
  name: 'Website Production (Web Design)',
  description:
    'Website production for sole proprietors and small businesses. Delivered in as few as 3 days, from ¥20,000 — just share your images and ideas and we build it fully custom.',
  provider: { '@id': `${SITE_URL}/#organization` },
  areaServed: { '@type': 'Country', name: 'Japan' },
  url: `${SITE_URL}/en/services/web-design/`,
  offers: {
    '@type': 'Offer',
    price: '20000',
    priceCurrency: 'JPY',
    description: 'Top + 4 pages / delivered in 3–4 business days',
  },
};
---

<RenewalLayout
  title="Website Production | From ¥20,000, in 3 days | Sane Design"
  description="Delivered in as few as 3 days, from ¥20,000. Just share your images and ideas and we build a fully custom website for sole proprietors and small businesses. Sane Design — 300+ projects."
  jsonLd={serviceJsonLd}
>
  <WebDesignContent lang="en" />
</RenewalLayout>
