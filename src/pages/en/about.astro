---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AboutContent from '../../components/pages/AboutContent.astro';

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Sane Atsu',
  jobTitle: 'Web Designer / Developer',
  worksFor: { '@id': 'https://sane-design.net/#organization' },
  sameAs: [
    'https://www.instagram.com/sane_design2023/',
    'https://x.com/sane_design',
    'https://note.com/sane_design2026',
  ],
};
---

<BaseLayout
  title="About | About Sane Design | Sane Design"
  description="Sane Design is a web & SEO studio pursuing 'fast and good,' built on 300+ design projects across print and web."
  jsonLd={personJsonLd}
>
  <AboutContent lang="en" />
</BaseLayout>
