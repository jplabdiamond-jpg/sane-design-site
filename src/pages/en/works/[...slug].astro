---
import RenewalLayout from '../../../layouts/RenewalLayout.astro';
import WorkDetailContent from '../../../components/pages/WorkDetailContent.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { SITE_URL, SITE_NAME } from '../../../consts';
import { tagLabel } from '../../../i18n/works';

export async function getStaticPaths() {
  const works = await getCollection('works', ({ data }) => !data.draft);
  return works.map((work, index) => ({
    params: { slug: work.slug },
    props: { work, index },
  }));
}

interface Props {
  work: CollectionEntry<'works'>;
  index: number;
}

const { work, index } = Astro.props;
const d = work.data;
const hasUrl = !!d.url;

const title = d.title_en || d.title;
const client = d.client_en || d.client;
const industry = d.industry_en || d.industry;
const tagsEn = d.tags.map((tg) => tagLabel(tg, 'en'));

const pageTitle = `${client} ${title} | ${industry} project | Sane Design`;
const pageDesc = `${title} for ${client} (${industry}). ${tagsEn.join(', ')}. A website & design project by Sane Design, a studio with 300+ projects.`;

const workJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: `${client} ${title}`,
  description: pageDesc,
  about: industry,
  keywords: tagsEn.join(', '),
  dateCreated: String(d.year),
  inLanguage: 'en',
  ...(d.heroImage ? { image: { '@type': 'ImageObject', url: new URL(d.heroImage, SITE_URL).href, width: 1200, height: 630 } } : {}),
  ...(hasUrl ? { url: d.url } : {}),
  creator: { '@type': 'Organization', name: SITE_NAME, url: SITE_URL },
  provider: { '@id': `${SITE_URL}/#organization` },
};
---

<RenewalLayout
  title={pageTitle}
  description={pageDesc}
  image={d.heroImage}
  ogType="article"
  jsonLd={workJsonLd}
>
  <WorkDetailContent work={work} index={index} lang="en" />
</RenewalLayout>
