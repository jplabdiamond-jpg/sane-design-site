---
import RenewalLayout from '../layouts/RenewalLayout.astro';
---

<RenewalLayout
  title="ページが見つかりません（404）| Sane Design"
  description="お探しのページは見つかりませんでした。URLをご確認いただくか、トップページからお探しください。"
  noindex={true}
>
  <section style="padding:120px 0 80px; text-align:center;">
    <div style="max-width:560px; margin:0 auto; padding:0 22px;">
      <p style="font-family:'Inter',sans-serif; font-size:100px; font-weight:800; color:#4FB4E8; line-height:1; margin:0;">404</p>
      <h1 style="font-size:22px; font-weight:700; margin:20px 0 12px; color:#3A4256;">
        ページが見つかりません
      </h1>
      <p style="font-size:15px; color:#6b7280; line-height:1.8; margin-bottom:36px;">
        お探しのページは移動または削除された可能性があります。<br />
        URLをご確認いただくか、下記よりお探しください。
      </p>
      <div style="display:flex; gap:14px; justify-content:center; flex-wrap:wrap;">
        <a href="/" class="rn-btn rn-btn-primary">トップページへ</a>
        <a href="/works/" class="rn-btn rn-btn-ghost">制作実績を見る</a>
      </div>
    </div>
  </section>
</RenewalLayout>
