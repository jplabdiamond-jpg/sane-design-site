---
import RenewalLayout from '../../layouts/RenewalLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import { SITE_URL } from '../../consts';

// md コレクションから取得（Supabase非依存）。order昇順で全件表示。
const works = (await getCollection('works', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order)
  .map((w) => ({ ...w.data, slug: w.slug }));

// ── フィルタ分類 ──
// サイトジャンル（タグから判定）
const GENRE_TAGS = ['Web', 'LP', 'EC', 'Corporate', 'ポータルサイト', 'System', 'DTPデザイン'] as const;
const genreLabels: Record<string, string> = {
  Web: 'WEBサイト',
  LP: 'LP（ランディングページ）',
  EC: 'ECサイト',
  Corporate: 'コーポレートサイト',
  'ポータルサイト': 'ポータルサイト',
  System: 'システム / ツール',
  'DTPデザイン': 'DTPデザイン',
};
// 実際に作品に存在するジャンルだけ表示
const activeGenres = GENRE_TAGS.filter((g) =>
  works.some((w) => (w.tags || []).includes(g))
);

// 業種（industry フィールドから取得、・で分割して主カテゴリのみ）
const industrySet = new Map<string, string>(); // label → 元の industry 文字列（複数対応）
works.forEach((w) => {
  if (!w.industry) return;
  // "自動車・買取" → "自動車" を主カテゴリとして使う
  const primary = w.industry.split('・')[0];
  if (!industrySet.has(primary)) {
    industrySet.set(primary, primary);
  }
});
const activeIndustries = [...industrySet.keys()].sort();

// 制作実績の ItemList 構造化データ（内部リンク先のみ列挙）
const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Sane Design 制作実績一覧',
  itemListElement: works
    .filter((w) => !w.noLink)
    .map((w, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: `${w.client} ${w.title}`,
      url: w.url || new URL(`/works/${w.slug}/`, SITE_URL).href,
    })),
};
---

<RenewalLayout
  title="制作実績一覧｜ホームページ・LP・チラシ300件以上 | Sane Design"
  description="Sane Designのホームページ制作・LP・DTPデザイン実績一覧。コーポレートサイト、LP、サロン予約サイト、士業サイト、飲食店チラシなど300件以上の制作実績から代表作をご紹介します。"
  jsonLd={itemListJsonLd}
>
  <!-- ── Hero ── -->
  <section class="rw-hero">
    <div class="rw-wrap">
      <Breadcrumbs items={[{ label: '制作実績' }]} />

      <div class="rw-hero-content">
        <span class="rw-sec-sub">Works</span>
        <h1 class="rw-hero-title">これまでの制作例</h1>
        <p class="rw-hero-desc">
          DTP・WEB 合わせて 300 件以上の実績より、<br class="rw-sp-hide" />代表的なプロジェクトをご紹介します。
        </p>

        <!-- Stats strip -->
        <div class="rw-stats">
          <div class="rw-stat">
            <span class="rw-stat-num"><span class="rw-count" data-target="300" data-suffix="+">0</span></span>
            <span class="rw-stat-label">制作実績</span>
          </div>
          <div class="rw-stat-divider"></div>
          <div class="rw-stat">
            <span class="rw-stat-num rw-stat-num-sm">WEBサイト・LP・ECサイト etc...</span>
            <span class="rw-stat-label">制作可能デザイン</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Wave divider -->
    <div class="rw-wave rw-wave-bot">
      <svg viewBox="0 0 1200 60" preserveAspectRatio="none"><path d="M0,0 C300,60 900,60 1200,0 L1200,60 L0,60 Z" fill="#fff"/></svg>
    </div>
  </section>

  <!-- ── Filter ── -->
  <div class="rw-wrap rw-filter-section">
    <div class="rw-filter-controls">
      <!-- すべて表示ボタン -->
      <button class="rw-filter-btn rw-filter-all active" id="filter-all">すべて表示</button>

      <!-- サイトジャンル -->
      <div class="rw-filter-group">
        <button class="rw-filter-toggle" id="toggle-genre" type="button">
          <span>サイトジャンル</span>
          <svg class="rw-filter-chevron" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"/></svg>
        </button>
        <div class="rw-filter-dropdown" id="dropdown-genre">
          {activeGenres.map((g) => (
            <button class="rw-filter-btn" data-filter-type="genre" data-filter-value={g}>
              {genreLabels[g] || g}
            </button>
          ))}
        </div>
      </div>

      <!-- 業種 -->
      <div class="rw-filter-group">
        <button class="rw-filter-toggle" id="toggle-industry" type="button">
          <span>業種</span>
          <svg class="rw-filter-chevron" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"/></svg>
        </button>
        <div class="rw-filter-dropdown" id="dropdown-industry">
          {activeIndustries.map((ind) => (
            <button class="rw-filter-btn" data-filter-type="industry" data-filter-value={ind}>
              {ind}
            </button>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- ── Works Grid ── -->
  <section class="rw-wrap rw-grid-section">
    <div class="rw-grid" id="works-grid">
      {works.map((work, i) => {
        const noLink = !!work.noLink;
        const isExternal = !noLink && !!work.url;
        const href = work.url || `/works/${work.slug}/`;
        const tagsArr = work.tags || [];
        const CardTag = noLink ? 'div' : 'a';
        const linkProps = noLink
          ? {}
          : { href, ...(isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {}) };
        return (
          <div
            class="rw-item"
            data-tags={tagsArr.join(',')}
            data-genre={tagsArr.filter((t: string) => (GENRE_TAGS as readonly string[]).includes(t)).join(',')}
            data-industry={work.industry ? work.industry.split('・')[0] : ''}
            style={`animation-delay:${Math.min(i, 11) * 60}ms`}
          >
            <CardTag
              class={`rw-card${noLink ? ' rw-card-static' : ''}`}
              {...linkProps}
            >
              <div class="rw-thumb">
                <img src={work.thumbnail} alt={`${work.client}｜${work.title}（${work.industry}）の制作実績`} loading="lazy" width="600" height="400" />
                {!noLink && (
                  <div class="rw-thumb-overlay">
                    <span class="rw-view-label">
                      {isExternal ? 'サイトを見る ↗' : '詳しく見る →'}
                    </span>
                  </div>
                )}
              </div>
              <div class="rw-body">
                <div class="rw-tags">
                  {tagsArr.map((tag: string) => (
                    <span>{tag}</span>
                  ))}
                  <span class="rw-year-tag">{work.year}</span>
                </div>
                <h3 class="rw-card-title">{work.title}</h3>
                <p class="rw-card-client">{work.client}</p>
              </div>
            </CardTag>
          </div>
        );
      })}
    </div>
  </section>

  <!-- ── Renewal CTA Section ── -->
  <section class="rw-cta-final">
    <div class="rw-cta-wave-top">
      <svg viewBox="0 0 1200 60" preserveAspectRatio="none"><path d="M0,60 C300,0 900,0 1200,60 L1200,0 L0,0 Z" fill="#fff"/></svg>
    </div>
    <div class="rw-wrap rw-cta-inner">
      <img
        class="rw-cta-illust"
        src="/assets/male_creator_with_window.webp"
        alt="クリエイターのイラスト"
        width="480"
        height="480"
        loading="lazy"
      />
      <h2 class="rw-cta-heading">まずはwebデザインを無料で相談！</h2>
      <p class="rw-cta-text">
        知識や説明があまりできなくても大丈夫です！<br />
        まずは一度ご相談頂けましたら、こちらから様々な提案をさせて頂きます。
      </p>
      <a href="/contact/" class="rn-btn rn-btn-primary rw-cta-btn">
        <span>無料で相談してみる</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </div>
  </section>
</RenewalLayout>

<style is:global>
  /* ══════════════════════════════════════════════
     WORKS PAGE — RENEWAL PASTEL DESIGN
     Matching sane-design_sample.html design system
     ══════════════════════════════════════════════ */

  /* ── Design Tokens (scoped to works page) ── */
  .rw-hero,
  .rw-filter-section,
  .rw-grid-section {
    --rw-primary: #4FB4E8;
    --rw-primary-dark: #2E90C4;
    --rw-primary-deep: #1c6f9c;
    --rw-sky: #E4F4FD;
    --rw-cream: #FFF6E0;
    --rw-mint: #E9F7E4;
    --rw-green: #78C25E;
    --rw-orange: #F79B3E;
    --rw-orange-dark: #c76f14;
    --rw-text: #3A4256;
    --rw-sub: #7A8494;
    --rw-radius: 24px;
    --rw-shadow: 0 10px 30px rgba(58,66,86,.08);

    font-family: "Noto Sans JP", sans-serif;
    color: var(--rw-text);
  }

  /* ── Utility ── */
  .rw-wrap {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 22px;
  }

  @media (max-width: 560px) {
    .rw-sp-hide { display: none; }
  }

  /* ── Hero ── */
  .rw-hero {
    position: relative;
    background: radial-gradient(120% 90% at 50% 0%, #D7EFFB 0%, #EAF7FE 50%, #fff 100%);
    padding: 36px 0 80px;
  }
  .rw-hero .breadcrumbs {
    margin-bottom: 0;
  }
  .rw-hero .breadcrumbs a,
  .rw-hero .breadcrumbs span {
    color: var(--rw-sub) !important;
  }
  .rw-hero .breadcrumbs a:hover {
    color: var(--rw-primary) !important;
  }

  .rw-hero-content {
    text-align: center;
    margin-top: 32px;
  }

  .rw-sec-sub {
    font-family: "Inter", sans-serif;
    font-weight: 800;
    font-size: 14px;
    letter-spacing: 2px;
    color: var(--rw-primary);
    text-transform: uppercase;
    display: block;
    margin-bottom: 8px;
  }

  .rw-hero-title {
    font-family: "Noto Sans JP", sans-serif !important;
    font-size: clamp(28px, 5vw, 42px);
    font-weight: 900 !important;
    line-height: 1.4 !important;
    letter-spacing: 0.02em !important;
    color: var(--rw-text);
    margin-bottom: 16px;
  }

  .rw-hero-desc {
    font-size: 15px;
    color: var(--rw-sub);
    font-weight: 500;
    line-height: 1.9;
    max-width: 520px;
    margin: 0 auto;
  }

  /* ── Stats Strip ── */
  .rw-stats {
    display: inline-flex;
    align-items: center;
    gap: 0;
    margin-top: 32px;
    background: #fff;
    border-radius: 26px;
    box-shadow: var(--rw-shadow);
    padding: 20px 8px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .rw-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 0 28px;
  }
  .rw-stat-num {
    font-family: "Inter", sans-serif;
    font-size: clamp(22px, 3vw, 32px);
    font-weight: 800;
    color: var(--rw-primary);
    line-height: 1.2;
  }
  .rw-stat-label {
    font-size: 12px;
    color: var(--rw-sub);
    font-weight: 700;
    font-family: "Noto Sans JP", sans-serif;
  }
  .rw-stat-num-sm {
    font-size: clamp(14px, 2vw, 18px) !important;
    font-family: "Noto Sans JP", sans-serif;
    letter-spacing: 0.02em;
  }
  .rw-stat-divider {
    width: 2px;
    height: 28px;
    background: #E7ECF2;
    border-radius: 1px;
    flex-shrink: 0;
  }

  /* ── Wave ── */
  .rw-wave {
    position: absolute;
    left: 0;
    width: 100%;
    line-height: 0;
    z-index: 1;
  }
  .rw-wave-bot {
    bottom: -1px;
  }
  .rw-wave svg {
    width: 100%;
    height: 60px;
    display: block;
  }

  /* ── Filter ── */
  .rw-filter-section {
    padding: 32px 22px;
  }
  .rw-filter-controls {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    flex-wrap: wrap;
  }

  /* 共通ボタン */
  .rw-filter-btn {
    display: inline-flex;
    align-items: center;
    padding: 8px 20px;
    border: 2px solid #CDEBFA;
    background: #fff;
    font-size: 13px;
    font-weight: 700;
    font-family: "Noto Sans JP", sans-serif;
    cursor: pointer;
    border-radius: 999px;
    color: var(--rw-primary-dark);
    transition: all 0.2s ease;
    white-space: nowrap;
  }
  .rw-filter-btn:hover {
    background: var(--rw-sky);
    border-color: var(--rw-primary);
    color: var(--rw-primary-dark);
  }
  .rw-filter-btn.active {
    background: var(--rw-primary);
    border-color: var(--rw-primary);
    color: #fff;
    box-shadow: 0 4px 0 var(--rw-primary-deep);
  }

  /* すべて表示ボタン */
  .rw-filter-all {
    flex-shrink: 0;
  }

  /* ドロップダウングループ */
  .rw-filter-group {
    position: relative;
  }
  .rw-filter-toggle {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 20px;
    border: 2px solid #CDEBFA;
    background: #fff;
    font-size: 13px;
    font-weight: 700;
    font-family: "Noto Sans JP", sans-serif;
    cursor: pointer;
    border-radius: 999px;
    color: var(--rw-primary-dark);
    transition: all 0.2s ease;
    white-space: nowrap;
  }
  .rw-filter-toggle:hover {
    background: var(--rw-sky);
    border-color: var(--rw-primary);
  }
  .rw-filter-toggle.open {
    background: var(--rw-sky);
    border-color: var(--rw-primary);
  }
  .rw-filter-toggle.has-active {
    background: var(--rw-primary);
    border-color: var(--rw-primary);
    color: #fff;
    box-shadow: 0 4px 0 var(--rw-primary-deep);
  }
  .rw-filter-chevron {
    width: 16px;
    height: 16px;
    transition: transform 0.25s ease;
    flex-shrink: 0;
  }
  .rw-filter-toggle.open .rw-filter-chevron {
    transform: rotate(180deg);
  }

  /* ドロップダウンパネル */
  .rw-filter-dropdown {
    display: none;
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    min-width: 220px;
    background: #fff;
    border-radius: 16px;
    box-shadow: 0 12px 36px rgba(58,66,86,0.14);
    padding: 12px;
    z-index: 30;
    flex-direction: column;
    gap: 6px;
  }
  .rw-filter-dropdown.open {
    display: flex;
  }
  .rw-filter-dropdown .rw-filter-btn {
    width: 100%;
    justify-content: flex-start;
    border-radius: 12px;
    padding: 10px 16px;
  }

  /* ── Grid ── */
  .rw-grid-section {
    padding-bottom: 80px;
  }
  .rw-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  .rw-item {
    display: block;
    min-width: 0;
    animation: rwFadeUp 0.75s cubic-bezier(.22,1,.36,1) both;
  }
  @keyframes rwFadeUp {
    from { opacity: 0; transform: translateY(30px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .rw-item.hidden {
    display: none;
  }

  /* ── Card ── */
  .rw-card {
    display: block;
    border-radius: var(--rw-radius);
    overflow: hidden;
    background: #fff;
    box-shadow: var(--rw-shadow);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    text-decoration: none;
    color: inherit;
    height: 100%;
  }
  .rw-card:not(.rw-card-static):hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 40px rgba(58,66,86,.14);
  }
  .rw-card-static {
    cursor: default;
  }

  /* Thumbnail */
  .rw-thumb {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: linear-gradient(135deg, #D7EFFB, #E9F7E4);
  }
  .rw-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.45s ease;
  }
  .rw-card:not(.rw-card-static):hover .rw-thumb img {
    transform: scale(1.05);
  }

  .rw-thumb-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(58,66,86,0.6) 0%, transparent 50%);
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    padding: 16px;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .rw-card:not(.rw-card-static):hover .rw-thumb-overlay {
    opacity: 1;
  }

  .rw-view-label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(255,255,255,0.95);
    color: var(--rw-primary-dark);
    font-size: 12px;
    font-weight: 700;
    font-family: "Noto Sans JP", sans-serif;
    padding: 6px 16px;
    border-radius: 999px;
    box-shadow: 0 4px 12px rgba(58,66,86,0.15);
  }

  /* Card body */
  .rw-body {
    padding: 18px 20px 22px;
  }
  .rw-tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-bottom: 10px;
  }
  .rw-tags span {
    font-size: 11px;
    background: var(--rw-sky);
    color: var(--rw-primary-dark);
    padding: 3px 12px;
    border-radius: 999px;
    font-weight: 700;
    font-family: "Noto Sans JP", sans-serif;
  }
  .rw-tags .rw-year-tag {
    background: var(--rw-cream);
    color: var(--rw-orange-dark);
  }
  .rw-card-title {
    font-family: "Noto Sans JP", sans-serif !important;
    font-size: 17px;
    font-weight: 900 !important;
    line-height: 1.5 !important;
    letter-spacing: 0 !important;
    color: var(--rw-text);
    margin-bottom: 4px;
  }
  .rw-card-client {
    font-size: 13px;
    color: var(--rw-sub);
    font-weight: 500;
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .rw-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
    }
  }
  @media (max-width: 560px) {
    .rw-hero {
      padding: 24px 0 64px;
    }
    .rw-hero-content {
      margin-top: 24px;
    }
    .rw-hero-title {
      font-size: 26px;
    }
    .rw-stats {
      flex-direction: column;
      gap: 12px;
      padding: 16px 24px;
    }
    .rw-stat-divider {
      width: 60px;
      height: 2px;
    }
    .rw-stat {
      padding: 0;
    }
    .rw-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
    }
    .rw-filter-section {
      padding: 24px 22px;
    }
    .rw-filter-controls {
      gap: 8px;
    }
    .rw-filter-btn,
    .rw-filter-toggle {
      font-size: 12px;
      padding: 7px 14px;
    }
    .rw-filter-dropdown {
      min-width: 200px;
    }
  }

  /* ── CTA Section ── */
  .rw-cta-final {
    position: relative;
    background: linear-gradient(135deg, #4FB4E8 0%, #69C6D9 100%);
    color: #fff;
    text-align: center;
    padding: 0 0 80px;
    margin-top: 40px;
    overflow: hidden;
  }
  .rw-cta-wave-top {
    line-height: 0;
  }
  .rw-cta-wave-top svg {
    width: 100%;
    height: 60px;
    display: block;
  }
  .rw-cta-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .rw-cta-illust {
    width: 420px;
    max-width: 80%;
    margin: 0 auto -10px;
    filter: drop-shadow(0 10px 16px rgba(0,0,0,0.12));
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 70%, transparent 98%);
    mask-image: linear-gradient(to bottom, #000 0%, #000 70%, transparent 98%);
  }
  .rw-cta-heading {
    font-family: "Noto Sans JP", sans-serif !important;
    font-size: clamp(24px, 4vw, 36px);
    font-weight: 900 !important;
    line-height: 1.4 !important;
    letter-spacing: 0.02em !important;
    margin-bottom: 16px;
    color: #fff;
  }
  .rw-cta-text {
    font-size: 16px;
    opacity: 0.97;
    margin-bottom: 24px;
    font-weight: 500;
    line-height: 1.9;
  }
  .rw-cta-btn {
    font-size: 18px;
    padding: 18px 44px;
  }
  @media (max-width: 560px) {
    .rw-cta-final {
      padding: 0 0 60px;
    }
    .rw-cta-btn {
      font-size: 15px;
      padding: 16px 28px;
      white-space: nowrap;
    }
    .rw-cta-heading {
      font-size: 22px;
    }
    .rw-cta-text {
      font-size: 14px;
    }
  }

  /* ── Reduced motion ── */
  @media (prefers-reduced-motion: reduce) {
    .rw-item {
      animation: none !important;
      opacity: 1 !important;
    }
    .rw-thumb img {
      transition: none !important;
    }
  }
</style>

<script>
  // ── フィルタ ──
  const filterAllBtn = document.getElementById('filter-all') as HTMLButtonElement | null;
  const items = document.querySelectorAll('.rw-item');

  // ドロップダウントグル
  function setupToggle(toggleId: string, dropdownId: string) {
    const toggle = document.getElementById(toggleId);
    const dropdown = document.getElementById(dropdownId);
    if (!toggle || !dropdown) return;

    toggle.addEventListener('click', () => {
      const isOpen = toggle.classList.contains('open');
      // 他のドロップダウンを閉じる
      document.querySelectorAll('.rw-filter-toggle').forEach((t) => t.classList.remove('open'));
      document.querySelectorAll('.rw-filter-dropdown').forEach((d) => d.classList.remove('open'));
      if (!isOpen) {
        toggle.classList.add('open');
        dropdown.classList.add('open');
      }
    });
  }
  setupToggle('toggle-genre', 'dropdown-genre');
  setupToggle('toggle-industry', 'dropdown-industry');

  // ドロップダウン外クリックで閉じる
  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('.rw-filter-group')) {
      document.querySelectorAll('.rw-filter-toggle').forEach((t) => t.classList.remove('open'));
      document.querySelectorAll('.rw-filter-dropdown').forEach((d) => d.classList.remove('open'));
    }
  });

  // フィルタ適用
  let activeFilterType: string | null = null;
  let activeFilterValue: string | null = null;

  function applyFilter() {
    items.forEach((item) => {
      const el = item as HTMLElement;
      if (!activeFilterType || !activeFilterValue) {
        el.classList.remove('hidden');
        return;
      }
      if (activeFilterType === 'genre') {
        const genres = (el.dataset.genre || '').split(',');
        el.classList.toggle('hidden', !genres.includes(activeFilterValue));
      } else if (activeFilterType === 'industry') {
        const industry = el.dataset.industry || '';
        el.classList.toggle('hidden', industry !== activeFilterValue);
      }
    });
  }

  function clearActiveStates() {
    document.querySelectorAll('.rw-filter-dropdown .rw-filter-btn').forEach((b) => b.classList.remove('active'));
    document.querySelectorAll('.rw-filter-toggle').forEach((t) => t.classList.remove('has-active'));
  }

  // 「すべて表示」
  filterAllBtn?.addEventListener('click', () => {
    activeFilterType = null;
    activeFilterValue = null;
    clearActiveStates();
    filterAllBtn.classList.add('active');
    applyFilter();
  });

  // 各フィルタボタン
  document.querySelectorAll('.rw-filter-dropdown .rw-filter-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const el = btn as HTMLElement;
      const type = el.dataset.filterType || '';
      const value = el.dataset.filterValue || '';

      // 同じボタンをもう一度押したらリセット
      if (activeFilterType === type && activeFilterValue === value) {
        activeFilterType = null;
        activeFilterValue = null;
        clearActiveStates();
        filterAllBtn?.classList.add('active');
      } else {
        activeFilterType = type;
        activeFilterValue = value;
        clearActiveStates();
        filterAllBtn?.classList.remove('active');
        el.classList.add('active');
        // 親トグルをハイライト
        const group = el.closest('.rw-filter-group');
        group?.querySelector('.rw-filter-toggle')?.classList.add('has-active');
      }

      applyFilter();

      // ドロップダウンを閉じる
      document.querySelectorAll('.rw-filter-toggle').forEach((t) => t.classList.remove('open'));
      document.querySelectorAll('.rw-filter-dropdown').forEach((d) => d.classList.remove('open'));
    });
  });

  // ── Count Up ──
  function runCountUp(el: HTMLElement) {
    const target = parseInt(el.dataset.target || '0');
    const prefix = el.dataset.prefix || '';
    const suffix = el.dataset.suffix || '';
    const duration = 900;
    const steps = 40;
    const interval = duration / steps;
    let current = 0;
    const increment = target / steps;

    const timer = setInterval(() => {
      current += increment;
      if (current >= target) {
        current = target;
        clearInterval(timer);
      }
      const num = target >= 1000
        ? Math.floor(current).toLocaleString()
        : Math.floor(current);
      el.innerHTML = prefix + num + suffix;
    }, interval);
  }

  const countObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        runCountUp(entry.target as HTMLElement);
        countObserver.unobserve(entry.target);
      }
    });
  }, { threshold: 0.5 });
  document.querySelectorAll('.rw-count').forEach(el => countObserver.observe(el));
</script>
</BaseLayout>
