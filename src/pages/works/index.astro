---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTABanner from '../../components/CTABanner.astro';
import { getCollection } from 'astro:content';

// md コレクションから取得（Supabase非依存）。order昇順で全件表示。
const works = (await getCollection('works', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order)
  .map((w) => ({ ...w.data, slug: w.slug }));

// タグフィルタ用の一覧（出現順をアルファベット順に統一）
const allTags = [...new Set(works.flatMap((w) => w.tags || []))].sort();
---

<BaseLayout
  title="Works｜実績一覧 | Sane Design"
  description="Sane Designのホームページ制作実績一覧。コーポレートサイト、LP、サロン予約サイト、士業サイトなど300件以上の制作実績から代表作をご紹介します。"
>
  <!-- Hero -->
  <section class="works-hero">
    <div class="container-editorial">
      <p class="section-label reveal">Works</p>
      <h1 class="reveal works-title">
        Selected<br />
        <span style="font-style:italic;">Projects.</span>
      </h1>
      <p class="reveal works-desc">
        DTP・WEB 合わせて 300 件以上の実績より、<br />代表的なプロジェクトをご紹介します。
      </p>
    </div>
  </section>

  <!-- Filter -->
  <div class="container-editorial filter-wrap reveal">
    <div class="filter-header">
      <span class="filter-label">FILTER</span>
      <div class="filter-row" id="filter-row">
        <button class="filter-btn active" data-filter="all">
          <span class="filter-dot"></span>All
        </button>
        {allTags.map((tag) => (
          <button class="filter-btn" data-filter={tag}>
            <span class="filter-dot"></span>{tag}
          </button>
        ))}
      </div>
    </div>
  </div>

  <!-- Works grid -->
  <section class="container-editorial works-grid-section">
    <div class="works-grid" id="works-grid">
      {works.map((work, i) => {
        const isExternal = !!work.url;
        const href = work.url || `/works/${work.slug}/`;
        const tagsArr = work.tags || [];
        const firstTag = tagsArr[0] || '';
        return (
          <div class="work-item" data-tags={tagsArr.join(',')}>
            <a
              href={href}
              class="work-card"
              style={`animation-delay:${i * 55}ms`}
              {...(isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              <div class="work-thumb">
                <img src={work.thumbnail} alt={work.client} loading="lazy" class="work-img" />
                <div class="work-overlay"></div>
                <div class="work-hover-info">
                  <span class="work-hover-client">{work.client}</span>
                  <span class="work-hover-link">{isExternal ? 'Visit ↗' : 'View →'}</span>
                </div>
              </div>
              <div class="work-meta">
                <div class="work-meta-left">
                  <p class="work-client">{work.client}</p>
                  <p class="work-title-text">{work.title}</p>
                </div>
                <div class="work-meta-right">
                  <span class="work-year">{work.year}</span>
                  {firstTag && <span class="work-tag-first">{firstTag}</span>}
                </div>
              </div>
            </a>
          </div>
        );
      })}
    </div>
  </section>

  <CTABanner />
</BaseLayout>

<style is:global>
  /* ── Hero ── */
  .works-hero { padding: 80px 0 60px; }
  .works-title {
    font-family: var(--font-serif);
    font-size: clamp(40px, 7vw, 100px);
    font-weight: 300;
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin-top: 16px;
  }
  .works-desc {
    margin-top: 24px;
    max-width: 480px;
    font-size: 15px;
    color: var(--color-muted);
    line-height: 1.9;
  }

  /* ── Filter ── */
  .filter-wrap { padding-bottom: 56px; }
  .filter-header {
    border-top: 1px solid var(--color-border);
    padding-top: 28px;
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }
  .filter-label {
    font-size: 10px;
    letter-spacing: 0.2em;
    color: var(--color-muted);
    font-weight: 500;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .filter-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    flex: 1;
  }
  .filter-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 18px;
    border: 1px solid var(--color-border);
    background: transparent;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    border-radius: 100px;
    transition: all 0.25s ease;
    font-family: var(--font-sans);
    color: var(--color-muted);
    white-space: nowrap;
  }
  .filter-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0;
    transition: opacity 0.25s;
    flex-shrink: 0;
  }
  .filter-btn:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }
  .filter-btn.active {
    border-color: var(--color-primary);
    background: var(--color-primary);
    color: #fff;
  }
  .filter-btn.active .filter-dot { opacity: 1; background: #fff; }

  /* ── Grid ── */
  .works-grid-section { padding-bottom: 120px; }
  .works-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 48px 28px;
  }
  .work-item { display: block; }
  .work-item.hidden { display: none; }

  /* ── Card ── */
  .work-card {
    display: block;
    text-decoration: none;
    animation: workFadeIn 0.8s cubic-bezier(0.19, 1, 0.22, 1) both;
  }
  @keyframes workFadeIn {
    from { opacity: 0; transform: translateY(32px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* サムネイル */
  .work-thumb {
    position: relative;
    overflow: hidden;
    background: var(--color-surface);
    width: 100%;
    padding-top: 66.67%;
    border-radius: 4px;
  }
  .work-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s cubic-bezier(0.19, 1, 0.22, 1);
  }
  .work-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0) 50%);
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  /* ホバー時に画像下部に出るバナー */
  .work-hover-info {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 20px 20px 18px;
    transform: translateY(8px);
    opacity: 0;
    transition: all 0.35s cubic-bezier(0.19, 1, 0.22, 1);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 8px;
  }
  .work-hover-client {
    font-family: var(--font-serif);
    font-size: 14px;
    color: #fff;
    font-weight: 400;
    line-height: 1.3;
  }
  .work-hover-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: rgba(255,255,255,0.15);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255,255,255,0.3);
    padding: 5px 12px;
    border-radius: 100px;
    font-size: 10px;
    color: #fff;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .work-card:hover .work-img { transform: scale(1.05); }
  .work-card:hover .work-overlay { opacity: 1; }
  .work-card:hover .work-hover-info { opacity: 1; transform: translateY(0); }

  /* メタ情報 */
  .work-meta {
    margin-top: 16px;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }
  .work-meta-left { flex: 1; min-width: 0; }
  .work-client {
    font-family: var(--font-serif);
    font-size: 15px;
    font-weight: 400;
    line-height: 1.4;
    color: var(--color-primary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .work-title-text {
    font-size: 11px;
    color: var(--color-muted);
    letter-spacing: 0.04em;
    margin-top: 3px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .work-meta-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
    flex-shrink: 0;
  }
  .work-year {
    font-size: 11px;
    color: var(--color-muted);
    letter-spacing: 0.06em;
    font-variant-numeric: tabular-nums;
  }
  .work-tag-first {
    font-size: 9px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
    border: 1px solid var(--color-border);
    padding: 2px 7px;
    border-radius: 100px;
    white-space: nowrap;
  }

  /* ── Responsive ── */
  @media (max-width: 1024px) {
    .works-grid { grid-template-columns: repeat(3, 1fr); gap: 36px 20px; }
  }
  @media (max-width: 900px) {
    .works-grid { grid-template-columns: repeat(2, 1fr); gap: 32px 16px; }
  }
  @media (max-width: 560px) {
    .works-grid { grid-template-columns: 1fr; gap: 40px; }
    .filter-header { gap: 14px; }
  }
</style>

<script>
  // タグフィルタ（サーバーレンダリング済みDOMに対して動作）
  const filterRow = document.getElementById('filter-row');
  if (filterRow) {
    filterRow.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.filter-btn') as HTMLElement | null;
      if (!btn) return;
      filterRow.querySelectorAll('.filter-btn').forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      const f = btn.dataset.filter;
      document.querySelectorAll('.work-item').forEach((item) => {
        const el = item as HTMLElement;
        const show = f === 'all' || (el.dataset.tags || '').split(',').includes(f as string);
        el.classList.toggle('hidden', !show);
      });
    });
  }

  // スクロールリビール
  const observer = new IntersectionObserver(
    (entries) => entries.forEach((e) => { if (e.isIntersecting) e.target.classList.add('visible'); }),
    { threshold: 0.05 }
  );
  document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
</script>
