---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTABanner from '../../components/CTABanner.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import { SITE_URL } from '../../consts';

// md コレクションから取得（Supabase非依存）。order昇順で全件表示。
const works = (await getCollection('works', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order)
  .map((w) => ({ ...w.data, slug: w.slug }));

// タグフィルタ用の一覧（出現順をアルファベット順に統一）
const allTags = [...new Set(works.flatMap((w) => w.tags || []))].sort();

// 制作実績の ItemList 構造化データ（内部リンク先のみ列挙）
const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Sane Design 制作実績一覧',
  itemListElement: works
    .filter((w) => !w.noLink)
    .map((w, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: `${w.client} ${w.title}`,
      url: w.url || new URL(`/works/${w.slug}/`, SITE_URL).href,
    })),
};
---

<BaseLayout
  title="制作実績一覧｜ホームページ・LP・チラシ300件以上 | Sane Design"
  description="Sane Designのホームページ制作・LP・DTPデザイン実績一覧。コーポレートサイト、LP、サロン予約サイト、士業サイト、飲食店チラシなど300件以上の制作実績から代表作をご紹介します。"
  jsonLd={itemListJsonLd}
>
  <!-- ── Hero ── -->
  <section class="rw-hero">
    <div class="rw-wrap">
      <Breadcrumbs items={[{ label: '制作実績' }]} />

      <div class="rw-hero-content">
        <span class="rw-sec-sub">Works</span>
        <h1 class="rw-hero-title">これまでの制作例</h1>
        <p class="rw-hero-desc">
          DTP・WEB 合わせて 300 件以上の実績より、<br class="rw-sp-hide" />代表的なプロジェクトをご紹介します。
        </p>

        <!-- Stats strip -->
        <div class="rw-stats">
          <div class="rw-stat">
            <span class="rw-stat-num"><span class="rw-count" data-target="300" data-suffix="+">0</span></span>
            <span class="rw-stat-label">制作実績</span>
          </div>
          <div class="rw-stat-divider"></div>
          <div class="rw-stat">
            <span class="rw-stat-num">Web & DTP</span>
            <span class="rw-stat-label">対応デザイン</span>
          </div>
          <div class="rw-stat-divider"></div>
          <div class="rw-stat">
            <span class="rw-stat-num">2024–2026</span>
            <span class="rw-stat-label">制作年</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Wave divider -->
    <div class="rw-wave rw-wave-bot">
      <svg viewBox="0 0 1200 60" preserveAspectRatio="none"><path d="M0,0 C300,60 900,60 1200,0 L1200,60 L0,60 Z" fill="#fff"/></svg>
    </div>
  </section>

  <!-- ── Filter ── -->
  <div class="rw-wrap rw-filter-section">
    <div class="rw-filter-header">
      <span class="rw-filter-label">カテゴリで絞り込む</span>
      <div class="rw-filter-row" id="filter-row">
        <button class="rw-filter-btn active" data-filter="all">すべて</button>
        {allTags.map((tag) => (
          <button class="rw-filter-btn" data-filter={tag}>{tag}</button>
        ))}
      </div>
    </div>
  </div>

  <!-- ── Works Grid ── -->
  <section class="rw-wrap rw-grid-section">
    <div class="rw-grid" id="works-grid">
      {works.map((work, i) => {
        const noLink = !!work.noLink;
        const isExternal = !noLink && !!work.url;
        const href = work.url || `/works/${work.slug}/`;
        const tagsArr = work.tags || [];
        const CardTag = noLink ? 'div' : 'a';
        const linkProps = noLink
          ? {}
          : { href, ...(isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {}) };
        return (
          <div class="rw-item" data-tags={tagsArr.join(',')} style={`animation-delay:${Math.min(i, 11) * 60}ms`}>
            <CardTag
              class={`rw-card${noLink ? ' rw-card-static' : ''}`}
              {...linkProps}
            >
              <div class="rw-thumb">
                <img src={work.thumbnail} alt={`${work.client}｜${work.title}（${work.industry}）の制作実績`} loading="lazy" width="600" height="400" />
                {!noLink && (
                  <div class="rw-thumb-overlay">
                    <span class="rw-view-label">
                      {isExternal ? 'サイトを見る ↗' : '詳しく見る →'}
                    </span>
                  </div>
                )}
              </div>
              <div class="rw-body">
                <div class="rw-tags">
                  {tagsArr.map((tag: string) => (
                    <span>{tag}</span>
                  ))}
                  <span class="rw-year-tag">{work.year}</span>
                </div>
                <h3 class="rw-card-title">{work.title}</h3>
                <p class="rw-card-client">{work.client}</p>
              </div>
            </CardTag>
          </div>
        );
      })}
    </div>
  </section>

  <CTABanner />
</BaseLayout>

<style is:global>
  /* ══════════════════════════════════════════════
     WORKS PAGE — RENEWAL PASTEL DESIGN
     Matching sane-design_sample.html design system
     ══════════════════════════════════════════════ */

  /* ── Design Tokens (scoped to works page) ── */
  .rw-hero,
  .rw-filter-section,
  .rw-grid-section {
    --rw-primary: #4FB4E8;
    --rw-primary-dark: #2E90C4;
    --rw-primary-deep: #1c6f9c;
    --rw-sky: #E4F4FD;
    --rw-cream: #FFF6E0;
    --rw-mint: #E9F7E4;
    --rw-green: #78C25E;
    --rw-orange: #F79B3E;
    --rw-orange-dark: #c76f14;
    --rw-text: #3A4256;
    --rw-sub: #7A8494;
    --rw-radius: 24px;
    --rw-shadow: 0 10px 30px rgba(58,66,86,.08);

    font-family: "Noto Sans JP", sans-serif;
    color: var(--rw-text);
  }

  /* ── Utility ── */
  .rw-wrap {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 22px;
  }

  @media (max-width: 560px) {
    .rw-sp-hide { display: none; }
  }

  /* ── Hero ── */
  .rw-hero {
    position: relative;
    background: radial-gradient(120% 90% at 50% 0%, #D7EFFB 0%, #EAF7FE 50%, #fff 100%);
    padding: 36px 0 80px;
  }
  .rw-hero .breadcrumbs {
    margin-bottom: 0;
  }
  .rw-hero .breadcrumbs a,
  .rw-hero .breadcrumbs span {
    color: var(--rw-sub) !important;
  }
  .rw-hero .breadcrumbs a:hover {
    color: var(--rw-primary) !important;
  }

  .rw-hero-content {
    text-align: center;
    margin-top: 32px;
  }

  .rw-sec-sub {
    font-family: "Inter", sans-serif;
    font-weight: 800;
    font-size: 14px;
    letter-spacing: 2px;
    color: var(--rw-primary);
    text-transform: uppercase;
    display: block;
    margin-bottom: 8px;
  }

  .rw-hero-title {
    font-family: "Noto Sans JP", sans-serif !important;
    font-size: clamp(28px, 5vw, 42px);
    font-weight: 900 !important;
    line-height: 1.4 !important;
    letter-spacing: 0.02em !important;
    color: var(--rw-text);
    margin-bottom: 16px;
  }

  .rw-hero-desc {
    font-size: 15px;
    color: var(--rw-sub);
    font-weight: 500;
    line-height: 1.9;
    max-width: 520px;
    margin: 0 auto;
  }

  /* ── Stats Strip ── */
  .rw-stats {
    display: inline-flex;
    align-items: center;
    gap: 0;
    margin-top: 32px;
    background: #fff;
    border-radius: 26px;
    box-shadow: var(--rw-shadow);
    padding: 20px 8px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .rw-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 0 28px;
  }
  .rw-stat-num {
    font-family: "Inter", sans-serif;
    font-size: clamp(22px, 3vw, 32px);
    font-weight: 800;
    color: var(--rw-primary);
    line-height: 1.2;
  }
  .rw-stat-label {
    font-size: 12px;
    color: var(--rw-sub);
    font-weight: 700;
    font-family: "Noto Sans JP", sans-serif;
  }
  .rw-stat-divider {
    width: 2px;
    height: 28px;
    background: #E7ECF2;
    border-radius: 1px;
    flex-shrink: 0;
  }

  /* ── Wave ── */
  .rw-wave {
    position: absolute;
    left: 0;
    width: 100%;
    line-height: 0;
    z-index: 1;
  }
  .rw-wave-bot {
    bottom: -1px;
  }
  .rw-wave svg {
    width: 100%;
    height: 60px;
    display: block;
  }

  /* ── Filter ── */
  .rw-filter-section {
    padding: 32px 22px;
  }
  .rw-filter-header {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  .rw-filter-label {
    font-size: 13px;
    color: var(--rw-sub);
    font-weight: 700;
    font-family: "Noto Sans JP", sans-serif;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .rw-filter-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .rw-filter-btn {
    display: inline-flex;
    align-items: center;
    padding: 8px 20px;
    border: 2px solid #CDEBFA;
    background: #fff;
    font-size: 13px;
    font-weight: 700;
    font-family: "Noto Sans JP", sans-serif;
    cursor: pointer;
    border-radius: 999px;
    color: var(--rw-primary-dark);
    transition: all 0.2s ease;
    white-space: nowrap;
  }
  .rw-filter-btn:hover {
    background: var(--rw-sky);
    border-color: var(--rw-primary);
    color: var(--rw-primary-dark);
  }
  .rw-filter-btn.active {
    background: var(--rw-primary);
    border-color: var(--rw-primary);
    color: #fff;
    box-shadow: 0 4px 0 var(--rw-primary-deep);
  }

  /* ── Grid ── */
  .rw-grid-section {
    padding-bottom: 80px;
  }
  .rw-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  .rw-item {
    display: block;
    min-width: 0;
    animation: rwFadeUp 0.75s cubic-bezier(.22,1,.36,1) both;
  }
  @keyframes rwFadeUp {
    from { opacity: 0; transform: translateY(30px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .rw-item.hidden {
    display: none;
  }

  /* ── Card ── */
  .rw-card {
    display: block;
    border-radius: var(--rw-radius);
    overflow: hidden;
    background: #fff;
    box-shadow: var(--rw-shadow);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    text-decoration: none;
    color: inherit;
    height: 100%;
  }
  .rw-card:not(.rw-card-static):hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 40px rgba(58,66,86,.14);
  }
  .rw-card-static {
    cursor: default;
  }

  /* Thumbnail */
  .rw-thumb {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: linear-gradient(135deg, #D7EFFB, #E9F7E4);
  }
  .rw-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.45s ease;
  }
  .rw-card:not(.rw-card-static):hover .rw-thumb img {
    transform: scale(1.05);
  }

  .rw-thumb-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(58,66,86,0.6) 0%, transparent 50%);
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    padding: 16px;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .rw-card:not(.rw-card-static):hover .rw-thumb-overlay {
    opacity: 1;
  }

  .rw-view-label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(255,255,255,0.95);
    color: var(--rw-primary-dark);
    font-size: 12px;
    font-weight: 700;
    font-family: "Noto Sans JP", sans-serif;
    padding: 6px 16px;
    border-radius: 999px;
    box-shadow: 0 4px 12px rgba(58,66,86,0.15);
  }

  /* Card body */
  .rw-body {
    padding: 18px 20px 22px;
  }
  .rw-tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-bottom: 10px;
  }
  .rw-tags span {
    font-size: 11px;
    background: var(--rw-sky);
    color: var(--rw-primary-dark);
    padding: 3px 12px;
    border-radius: 999px;
    font-weight: 700;
    font-family: "Noto Sans JP", sans-serif;
  }
  .rw-tags .rw-year-tag {
    background: var(--rw-cream);
    color: var(--rw-orange-dark);
  }
  .rw-card-title {
    font-family: "Noto Sans JP", sans-serif !important;
    font-size: 17px;
    font-weight: 900 !important;
    line-height: 1.5 !important;
    letter-spacing: 0 !important;
    color: var(--rw-text);
    margin-bottom: 4px;
  }
  .rw-card-client {
    font-size: 13px;
    color: var(--rw-sub);
    font-weight: 500;
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .rw-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
    }
  }
  @media (max-width: 560px) {
    .rw-hero {
      padding: 24px 0 64px;
    }
    .rw-hero-content {
      margin-top: 24px;
    }
    .rw-hero-title {
      font-size: 26px;
    }
    .rw-stats {
      flex-direction: column;
      gap: 12px;
      padding: 16px 24px;
    }
    .rw-stat-divider {
      width: 60px;
      height: 2px;
    }
    .rw-stat {
      padding: 0;
    }
    .rw-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
    }
    .rw-filter-section {
      padding: 24px 22px;
    }
    .rw-filter-header {
      gap: 10px;
    }
    .rw-filter-row {
      gap: 6px;
    }
    .rw-filter-btn {
      font-size: 12px;
      padding: 6px 14px;
    }
  }

  /* ── Reduced motion ── */
  @media (prefers-reduced-motion: reduce) {
    .rw-item {
      animation: none !important;
      opacity: 1 !important;
    }
    .rw-thumb img {
      transition: none !important;
    }
  }
</style>

<script>
  // ── タグフィルタ ──
  const filterRow = document.getElementById('filter-row');
  if (filterRow) {
    filterRow.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.rw-filter-btn') as HTMLElement | null;
      if (!btn) return;
      filterRow.querySelectorAll('.rw-filter-btn').forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      const f = btn.dataset.filter;
      document.querySelectorAll('.rw-item').forEach((item) => {
        const el = item as HTMLElement;
        const show = f === 'all' || (el.dataset.tags || '').split(',').includes(f as string);
        el.classList.toggle('hidden', !show);
      });
    });
  }

  // ── Count Up ──
  function runCountUp(el: HTMLElement) {
    const target = parseInt(el.dataset.target || '0');
    const prefix = el.dataset.prefix || '';
    const suffix = el.dataset.suffix || '';
    const duration = 900;
    const steps = 40;
    const interval = duration / steps;
    let current = 0;
    const increment = target / steps;

    const timer = setInterval(() => {
      current += increment;
      if (current >= target) {
        current = target;
        clearInterval(timer);
      }
      const num = target >= 1000
        ? Math.floor(current).toLocaleString()
        : Math.floor(current);
      el.innerHTML = prefix + num + suffix;
    }, interval);
  }

  const countObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        runCountUp(entry.target as HTMLElement);
        countObserver.unobserve(entry.target);
      }
    });
  }, { threshold: 0.5 });
  document.querySelectorAll('.rw-count').forEach(el => countObserver.observe(el));
</script>
</BaseLayout>
