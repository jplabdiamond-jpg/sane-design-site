---
import RenewalLayout from '../../layouts/RenewalLayout.astro';
import WorksListContent from '../../components/pages/WorksListContent.astro';
import { getCollection } from 'astro:content';
import { SITE_URL } from '../../consts';

const works = (await getCollection('works', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);

const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Sane Design 制作実績一覧',
  itemListElement: works
    .filter((w) => !w.data.noLink)
    .map((w, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: `${w.data.client} ${w.data.title}`,
      url: w.data.url || new URL(`/works/${w.slug}/`, SITE_URL).href,
    })),
};
---

<RenewalLayout
  title="制作実績一覧｜ホームページ・LP・チラシ300件以上 | Sane Design"
  description="Sane Designのホームページ制作・LP・DTPデザイン実績一覧。コーポレートサイト、LP、サロン予約サイト、士業サイト、飲食店チラシなど300件以上の制作実績から代表作をご紹介します。"
  jsonLd={itemListJsonLd}
>
  <WorksListContent lang="ja" />
</RenewalLayout>
