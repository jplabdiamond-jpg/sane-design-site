---
import RenewalLayout from '../../layouts/RenewalLayout.astro';
import WebDesignContent from '../../components/pages/services/WebDesignContent.astro';
import { SITE_URL } from '../../consts';

const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'ホームページ制作',
  name: 'ホームページ制作（Web Design）',
  description:
    '個人事業主・中小企業向けのホームページ制作サービス。最速3日納品・20,000円〜、画像とイメージをお渡しいただくだけで完全オーダーメイドで制作します。',
  provider: { '@id': `${SITE_URL}/#organization` },
  areaServed: { '@type': 'Country', name: 'Japan' },
  url: `${SITE_URL}/services/web-design/`,
  offers: {
    '@type': 'Offer',
    price: '20000',
    priceCurrency: 'JPY',
    description: 'TOP + 4ページ / 3〜4営業日納品',
  },
};
---

<RenewalLayout
  title="ホームページ制作｜最速3日・20,000円〜 | Sane Design"
  description="最速3日納品・20,000円〜。画像とイメージをお渡しいただくだけで、個人事業主・中小企業向けのホームページを完全オーダーメイドで制作します。実績300件以上のSane Design。"
  jsonLd={serviceJsonLd}
>
  <WebDesignContent lang="ja" />
</RenewalLayout>
