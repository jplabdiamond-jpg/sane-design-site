.feedback-mock-header h5{font-size:14px;font-weight:900;color:#fff;margin:0;display:flex;align-items:center;gap:6px}
.feedback-mock-body{padding:16px 14px;display:flex;flex-direction:column;gap:10px}
.fb-msg{display:flex;align-items:flex-end;gap:8px;opacity:0;transition:opacity .5s,transform .5s}
.fb-msg.client{flex-direction:row;transform:translateX(-30px)}
.fb-msg.designer{flex-direction:row-reverse;transform:translateX(30px)}
.fb-msg.show{opacity:1;transform:translateX(0)}
.fb-avatar{width:28px;height:28px;border-radius:50%;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:11px;color:#fff;font-weight:700}
.fb-avatar.client{background:var(--orange)}
.fb-avatar.designer{background:var(--primary)}
.fb-bubble{max-width:78%;padding:10px 14px;font-size:14px;line-height:1.5;font-weight:500;position:relative;word-break:break-word}
.fb-msg.client .fb-bubble{background:#fff;color:var(--text);border-radius:16px 16px 16px 4px}
.fb-msg.designer .fb-bubble{background:#78C25E;color:#fff;border-radius:16px 16px 4px 16px}
.fb-time{font-size:9px;color:rgba(255,255,255,.6);flex-shrink:0;margin-bottom:2px}

/* STEP 05 */
.step5-layout{display:flex;align-items:center;justify-content:center;gap:24px;margin-top:20px;padding:32px 24px;background:#fff;border-radius:20px;box-shadow:0 8px 32px rgba(58,66,86,.08)}
.step5-center{text-align:center;display:flex;flex-direction:column;align-items:center;justify-content:center;flex:1}
.step5-center img{width:220px;margin:0 auto;filter:drop-shadow(0 8px 16px rgba(58,66,86,.12))}
.step5-mock{position:relative;flex:0 0 auto}
.step5-mock-frame{position:relative;z-index:2;width:100%;display:block;pointer-events:none;filter:drop-shadow(0 16px 26px rgba(58,66,86,.20))}
.step5-mock-screen{position:absolute;z-index:1;overflow:hidden;background:#0b0018}
.step5-mock-shot{width:100.6%;margin-left:-0.3%;display:block}
.step5-phone{width:160px}
.step5-phone .step5-mock-screen{left:5.848%;top:2.382%;width:88.304%;height:95.119%;border-radius:8.5%/4.4%}
.step5-laptop{width:430px;margin-bottom:6px}
.step5-laptop .step5-mock-screen{left:11.765%;top:6.773%;width:76.471%;height:82.171%}
.step5-phone .step5-mock-shot{animation:step5ScrollPhone 32s ease-in-out infinite}
.step5-laptop .step5-mock-shot{animation:step5ScrollDesk 18.6s ease-in-out infinite}
@keyframes step5ScrollPhone{0%,6%{transform:translateY(0)}50%,56%{transform:translateY(-91.91%)}100%{transform:translateY(0)}}
@keyframes step5ScrollDesk{0%,7%{transform:translateY(0)}50%,57%{transform:translateY(-84.40%)}100%{transform:translateY(0)}}

/* detail */
.detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:32px;max-width:900px;margin:0 auto}
.detail-card{background:#fff;border-radius:20px;padding:32px;box-shadow:var(--shadow)}
.detail-card h3{font-size:20px;font-weight:900;margin-bottom:18px;display:flex;align-items:center;gap:10px}
.detail-card h3 svg{width:24px;height:24px;color:var(--primary);stroke-width:2.5;flex-shrink:0}
.detail-list{list-style:none;padding:0}
.detail-list li{font-size:14px;padding:10px 0;border-bottom:1px solid #f0f0f0;display:flex;align-items:flex-start;gap:10px;font-weight:500;line-height:1.5}
.detail-list li:last-child{border-bottom:none}
.detail-list .ck{color:var(--green);flex-shrink:0;margin-top:2px}
.detail-list .ck svg{width:18px;height:18px;stroke-width:3}
.detail-list .plus{color:var(--orange);flex-shrink:0;margin-top:2px;font-weight:800;font-size:16px}

/* performance */
.perf-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;max-width:700px;margin:0 auto}
.perf-card{background:#fff;border-radius:20px;padding:28px 20px;text-align:center;box-shadow:var(--shadow)}
.perf-card .perf-num{font-family:"Inter";font-size:56px;font-weight:800;color:var(--primary);line-height:1}
.perf-bounce{display:inline-block;opacity:0;transform:translateY(30px) scale(0.5);transition:opacity .4s,transform .8s cubic-bezier(.34,1.56,.64,1)}
.perf-bounce.active{opacity:1;transform:translateY(0) scale(1)}
.perf-card .perf-unit{font-size:16px;color:var(--primary);font-weight:700;margin-left:4px}
.perf-card .perf-label{display:block;font-size:13px;color:var(--sub);font-weight:700;margin-top:8px}

/* CTA */
.cta-section{background:linear-gradient(135deg,var(--primary) 0%,var(--primary-deep) 100%);padding:80px 0;text-align:center;color:#fff;position:relative;overflow:hidden}
.cta-section::before{content:"";position:absolute;top:-60px;right:-60px;width:200px;height:200px;background:rgba(255,255,255,.06);border-radius:50%}
.cta-section::after{content:"";position:absolute;bottom:-80px;left:-40px;width:260px;height:260px;background:rgba(255,255,255,.04);border-radius:50%}
.cta-section h2{font-size:clamp(24px,4vw,42px);font-weight:900;margin-bottom:8px}
.cta-section .cta-sub{font-size:16px;opacity:.85;margin-bottom:32px}
.cta-btns{display:flex;gap:16px;flex-wrap:wrap;justify-content:center;position:relative;z-index:2}

/* works section */
.work-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
.work{display:block;text-decoration:none;border-radius:20px;overflow:hidden;background:#fff;box-shadow:var(--shadow);transition:transform .25s,box-shadow .25s}
.work:hover{transform:translateY(-6px);box-shadow:0 16px 40px rgba(58,66,86,.14)}
.work .thumb{overflow:hidden}
.work .thumb img{width:100%;aspect-ratio:16/9;object-fit:cover;transition:transform .6s}
.work:hover .thumb img{transform:scale(1.05)}
.work .body{padding:18px 20px}
.work .tags{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:8px}
.work .tags span{font-size:11px;background:#EAF7FE;color:var(--primary-dark);border-radius:100px;padding:3px 10px;font-weight:700}
.work h4{font-size:15px;font-weight:900;margin-bottom:4px}
.work p{font-size:13px;color:var(--sub);line-height:1.5}

/* scroll reveal */
.reveal{opacity:0;transform:translateY(40px);transition:opacity .9s cubic-bezier(.19,1,.22,1),transform .9s cubic-bezier(.19,1,.22,1)}
.reveal.visible{opacity:1;transform:translateY(0)}

/* ── Mobile ── */
@media(max-width:768px){
  .spec-strip{grid-template-columns:repeat(2,1fr)}
  .spec-item:nth-child(3){border-left:none}
  .recommend-grid{grid-template-columns:1fr 1fr}
  .rec-card:hover{transform:none !important;z-index:auto !important;box-shadow:var(--shadow) !important}
  .flow-grid{grid-template-columns:1fr;gap:28px}
  .step1-layout{grid-template-columns:1fr;gap:20px;padding:20px 14px}
  .step1-center{order:-1}
  .step-content-side{gap:12px}
  .form-mock{max-width:100%}
  .line-chat{max-width:100%}
  .step2-layout{grid-template-columns:1fr;gap:20px;padding:20px 14px}
  .step2-center{order:-1}
  .hearing-list{max-width:100%}
  .share-mock{max-width:100%}
  .step3-layout{grid-template-columns:1fr;gap:20px;padding:20px 14px}
  .step3-center{order:-1}
  .design-preview{max-width:100%}
  .progress-timeline{max-width:100%}
  .step4-layout{grid-template-columns:1fr;gap:20px;padding:20px 14px}
  .feedback-mock{max-width:100%}
  .step4-right{order:-1}
  .step5-layout{flex-direction:column;gap:20px;padding:20px 14px}
  .step5-center{order:-1}
  .step5-phone{width:120px}
  .step5-laptop{width:100%;max-width:100%}
  .step+.step::before{display:none}
  .detail-grid{grid-template-columns:1fr}
  .perf-grid{grid-template-columns:1fr}
  .work-grid{grid-template-columns:1fr}
  .cta-btns{flex-direction:column;align-items:center}
}
@media(max-width:480px){
  .recommend-grid{grid-template-columns:1fr}
  .spec-strip{grid-template-columns:1fr}
  .spec-item+.spec-item{border-left:none;border-top:2px dashed #E7ECF2}
}
</style>

<script>
// ── Form typing animation (looping) ──
function typeInField(fieldId, callback) {
  var wrapper = document.getElementById(fieldId);
  if (!wrapper) { callback && callback(); return; }
  var span = wrapper.querySelector('.typed-text');
  if (!span) { callback && callback(); return; }
  var text = span.getAttribute('data-text') || '';
  span.textContent = '';
  var cursor = document.createElement('span');
  cursor.className = 'cursor';
  wrapper.classList.add('active');
  wrapper.appendChild(cursor);
  var i = 0;
  var speed = 70;
  function type() {
    if (i < text.length) {
      span.textContent += text.charAt(i);
      i++;
      setTimeout(type, speed + Math.random() * 40);
    } else {
      wrapper.classList.remove('active');
      cursor.remove();
      setTimeout(function(){ callback && callback(); }, 300);
    }
  }
  type();
}

function resetFormFields() {
  ['fi1','fi2','fi3','fi4'].forEach(function(id) {
    var w = document.getElementById(id);
    if (w) {
      var span = w.querySelector('.typed-text');
      if (span) span.textContent = '';
      w.classList.remove('active');
      var cur = w.querySelector('.cursor');
      if (cur) cur.remove();
    }
  });
  var btn = document.getElementById('formSubmitBtn');
  if (btn) btn.style.opacity = '0';
}

function runFormLoop() {
  resetFormFields();
  setTimeout(function() {
    typeInField('fi1', function() {
      typeInField('fi2', function() {
        typeInField('fi3', function() {
          typeInField('fi4', function() {
            var btn = document.getElementById('formSubmitBtn');
            if (btn) btn.style.opacity = '1';
            setTimeout(runFormLoop, 3000);
          });
        });
      });
    });
  }, 600);
}

// ── LINE chat animation (looping) ──
function resetLineChat() {
  var msgs = document.querySelectorAll('.line-msg');
  msgs.forEach(function(m) { m.classList.remove('line-show'); });
  var time = document.querySelector('.line-time');
  if (time) time.classList.remove('line-show');
}

function runLineLoop() {
  resetLineChat();
  var msg1 = document.querySelector('.line-msg.m1');
  var msg3 = document.querySelector('.line-msg.m3');
  var msg2 = document.querySelector('.line-msg.m2');
  var time = document.querySelector('.line-time');
  setTimeout(function() {
    if (msg1) msg1.classList.add('line-show');
    setTimeout(function() {
      if (msg3) msg3.classList.add('line-show');
      setTimeout(function() {
        if (msg2) msg2.classList.add('line-show');
        setTimeout(function() {
          if (time) time.classList.add('line-show');
          setTimeout(runLineLoop, 3000);
        }, 600);
      }, 1800);
    }, 1400);
  }, 1000);
}

function startStep1Animations() {
  var formMock = document.querySelector('.form-mock');
  var lineChat = document.querySelector('.line-chat');
  if (!formMock && !lineChat) return;
  var target = formMock || lineChat;
  var obs = new IntersectionObserver(function(entries) {
    entries.forEach(function(e) {
      if (e.isIntersecting) {
        obs.unobserve(e.target);
        runFormLoop();
        runLineLoop();
      }
    });
  }, { threshold: 0.2 });
  obs.observe(target);
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', startStep1Animations);
} else {
  startStep1Animations();
}

// ── STEP 02 animations ──
function startStep2Animation() {
  var hearingList = document.getElementById('hearingList');
  if (hearingList) {
    var obs1 = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) {
        if (e.isIntersecting) {
          obs1.unobserve(e.target);
          var items = hearingList.querySelectorAll('.hearing-item');
          items.forEach(function(item, i) {
            setTimeout(function() { item.classList.add('show'); }, 400 + i * 350);
          });
        }
      });
    }, { threshold: 0.3 });
    obs1.observe(hearingList);
  }
  var shareFiles = document.getElementById('shareFiles');
  if (shareFiles) {
    var obs2 = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) {
        if (e.isIntersecting) {
          obs2.unobserve(e.target);
          var files = shareFiles.querySelectorAll('.share-file');
          files.forEach(function(file, i) {
            setTimeout(function() { file.classList.add('show'); }, 600 + i * 400);
          });
        }
      });
    }, { threshold: 0.3 });
    obs2.observe(shareFiles);
  }
}
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', startStep2Animation);
} else {
  startStep2Animation();
}

// ── STEP 03 animations ──
function startStep3Animation() {
  var dp = document.getElementById('designPreview');
  if (dp) {
    var obs3a = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) {
        if (e.isIntersecting) {
          obs3a.unobserve(e.target);
          var blocks = dp.querySelectorAll('.dp-block');
          blocks.forEach(function(b, i) {
            setTimeout(function() { b.classList.add('show'); }, 500 + i * 300);
          });
          var cards = dp.querySelectorAll('.dp-card');
          cards.forEach(function(c, i) {
            setTimeout(function() { c.classList.add('show'); }, 1800 + i * 250);
          });
        }
      });
    }, { threshold: 0.3 });
    obs3a.observe(dp);
  }
  var pt = document.getElementById('progressTimeline');
  if (pt) {
    var obs3b = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) {
        if (e.isIntersecting) {
          obs3b.unobserve(e.target);
          var items = pt.querySelectorAll('.tl-item');
          items.forEach(function(item, i) {
            setTimeout(function() { item.classList.add('show'); }, 400 + i * 400);
          });
        }
      });
    }, { threshold: 0.3 });
    obs3b.observe(pt);
  }
}
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', startStep3Animation);
} else {
  startStep3Animation();
}

// ── STEP 04 animations ──
function startStep4Animation() {
  var fb = document.getElementById('feedbackMock');
  if (fb) {
    var obs4a = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) {
        if (e.isIntersecting) {
          obs4a.unobserve(e.target);
          var msgs = fb.querySelectorAll('.fb-msg');
          msgs.forEach(function(msg, i) {
            setTimeout(function() { msg.classList.add('show'); }, 400 + i * 600);
          });
        }
      });
    }, { threshold: 0.3 });
    obs4a.observe(fb);
  }
}
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', startStep4Animation);
} else {
  startStep4Animation();
}

// ── Performance count-up & bounce ──
function startPerfAnimations() {
  var perfGrid = document.querySelector('.perf-grid');
  if (!perfGrid) return;
  var perfObs = new IntersectionObserver(function(entries) {
    entries.forEach(function(e) {
      if (e.isIntersecting) {
        perfObs.unobserve(e.target);
        var counters = perfGrid.querySelectorAll('.perf-count');
        counters.forEach(function(el) {
          var target = parseInt(el.getAttribute('data-target'));
          var duration = 1500;
          var startTime = null;
          function step(timestamp) {
            if (!startTime) startTime = timestamp;
            var progress = Math.min((timestamp - startTime) / duration, 1);
            var eased = 1 - Math.pow(1 - progress, 3);
            el.textContent = Math.floor(eased * target);
            if (progress < 1) requestAnimationFrame(step);
            else el.textContent = target;
          }
          requestAnimationFrame(step);
        });
        var bounceEls = perfGrid.querySelectorAll('.perf-bounce');
        bounceEls.forEach(function(el) {
          setTimeout(function() { el.classList.add('active'); }, 300);
        });
      }
    });
  }, { threshold: 0.3 });
  perfObs.observe(perfGrid);
}
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', startPerfAnimations);
} else {
  startPerfAnimations();
}
</script>
