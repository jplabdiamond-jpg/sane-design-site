---
import RenewalLayout from '../../layouts/RenewalLayout.astro';
import { SITE_URL, SITE_NAME } from '../../consts';

const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'ホームページ制作',
  name: 'ホームページ制作（Web Design）',
  description:
    '個人事業主・中小企業向けのホームページ制作サービス。最速3日納品・20,000円〜、画像とイメージをお渡しいただくだけで完全オーダーメイドで制作します。',
  provider: { '@id': `${SITE_URL}/#organization` },
  areaServed: { '@type': 'Country', name: 'Japan' },
  url: `${SITE_URL}/services/web-design/`,
  offers: {
    '@type': 'Offer',
    price: '20000',
    priceCurrency: 'JPY',
    description: 'TOP + 4ページ / 3〜4営業日納品',
  },
};
---

<RenewalLayout
  title="ホームページ制作｜最速3日・20,000円〜 | Sane Design"
  description="最速3日納品・20,000円〜。画像とイメージをお渡しいただくだけで、個人事業主・中小企業向けのホームページを完全オーダーメイドで制作します。実績300件以上のSane Design。"
  jsonLd={serviceJsonLd}
>

<!-- ═══ 01 HERO ═══ -->
<section class="wd-hero reveal">
  <div class="wrap">
    <span class="sec-sub">Web Design</span>
    <h1>最速3日で<br>ホームページを<span class="big">納品します</span></h1>
    <img class="hero-top-img" src="/assets/webdesign_page_top.png" alt="ホームページ制作のイメージ">
    <p class="lead">画像とイメージをお渡しいただくだけ。<br>個人事業主・中小企業向けに、完全オーダーメイドで制作します。</p>
    <div style="display:flex;gap:16px;flex-wrap:wrap;justify-content:center">
      <a href="/contact/" class="btn btn-primary">まずは無料で相談する<svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
      <a href="/payment/" class="btn btn-ghost">今すぐ注文する</a>
    </div>
    <div class="hero-badges">
      <span class="hero-badge"><i class="ck"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg></i>相談だけでもOK</span>
      <span class="hero-badge"><i class="ck"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg></i>しつこい営業なし</span>
      <span class="hero-badge"><i class="ck"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg></i>修正無制限</span>
    </div>
    <div class="spec-strip">
      <div class="spec-item">
        <div class="lbl-top">コミコミ価格</div>
        <div class="big"><span class="num">¥20,000</span>〜</div>
        <div class="lbl">追加費用なし</div>
      </div>
      <div class="spec-item">
        <div class="lbl-top">スピード納品</div>
        <div class="big">最短<span class="num">3</span>日〜</div>
        <div class="lbl">お急ぎも相談可</div>
      </div>
      <div class="spec-item">
        <div class="lbl-top">ページ数</div>
        <div class="big">TOP + <span class="num">4</span>P</div>
        <div class="lbl">追加ページ 5,000円/P</div>
      </div>
      <div class="spec-item">
        <div class="lbl-top">納品形態</div>
        <div class="big" style="font-size:20px;padding-top:4px">HTML / サーバー</div>
        <div class="lbl">どちらでもOK</div>
      </div>
    </div>
  </div>
</section>

<!-- ═══ 02 こんな方におすすめ ═══ -->
<section class="cream" style="padding-top:60px">
  <div class="wave top"><svg viewBox="0 0 1200 60" preserveAspectRatio="none"><path d="M0,60 C300,0 900,0 1200,60 L1200,0 L0,0 Z" fill="#fff"/></svg></div>
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="sec-sub">Recommend</span>
      <h2 class="sec-title">こんな方に<span class="mk">おすすめ</span><small>ひとつでも当てはまったら、お気軽にご相談ください</small></h2>
    </div>
    <div class="recommend-grid">
      <div class="rec-card reveal">
        <div class="rec-illust-wrap">
          <div class="rec-bubble bl">何日までにWebサイトを作りたい…</div>
          <img class="rec-illust rec-illust-1" src="/assets/webdesign_page_recommend1.png" alt="急ぎでHPが必要な方">
        </div>
        <h4>急ぎでHPが必要な<br>個人事業主・店舗の方</h4>
        <p>開業に合わせて、すぐにホームページが欲しい方に最適です。</p>
      </div>
      <div class="rec-card reveal">
        <div class="rec-illust-wrap">
          <div class="rec-bubble br">どんなサイトが良いんだろう？…</div>
          <img class="rec-illust rec-illust-2" src="/assets/webdesign_page_recommend2.png" alt="デザインのイメージが固まっていない方">
        </div>
        <h4>デザインのイメージが<br>固まっていない方</h4>
        <p>「おまかせ」でOK。ヒアリングからご提案します。</p>
      </div>
      <div class="rec-card reveal">
        <div class="rec-illust-wrap">
          <div class="rec-bubble bl">表示が遅いサイトは嫌だな…</div>
          <img class="rec-illust rec-illust-3" src="/assets/webdesign_page_recommend3.png" alt="軽くて速いサイトが欲しい方">
        </div>
        <h4>軽くて速い<br>サイトが欲しい方</h4>
        <p>WordPressを使わない軽量な構成で、高速表示を実現します。</p>
      </div>
      <div class="rec-card reveal">
        <div class="rec-illust-wrap">
          <div class="rec-bubble br">なるべくコストを抑えたい…</div>
          <img class="rec-illust rec-illust-4" src="/assets/webdesign_page_recommend4.png" alt="予算を抑えたい方">
        </div>
        <h4>予算を<br>抑えたい方</h4>
        <p>20,000円〜のコミコミ価格。あとから追加請求はありません。</p>
      </div>
    </div>
  </div>
</section>

<!-- ═══ 03 制作の流れ ═══ -->
<section class="mint">
  <div class="wave top"><svg viewBox="0 0 1200 60" preserveAspectRatio="none"><path d="M0,60 C300,0 900,0 1200,60 L1200,0 L0,0 Z" fill="var(--cream-bg)"/></svg></div>
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="sec-sub">Flow</span>
      <h2 class="sec-title">かんたん<span class="mk">5ステップ</span><small>ご依頼から納品まで、最短3営業日</small></h2>
    </div>
    <div class="flow-grid">
      <!-- STEP 01 -->
      <div class="step reveal" style="grid-column:1/-1">
        <span class="st">STEP 01</span>
        <div class="step1-layout">
          <div class="step1-center">
            <div class="step-heading"><h4>ご依頼</h4><p>フォームまたはLINEから<br>お気軽にご連絡ください。</p></div>
            <img src="/assets/webdesign_page_step1b.png" alt="ご依頼イメージ">
          </div>
          <div class="form-mock">
            <div class="form-mock-header">
              <h5>お客様情報の入力</h5>
              <p>ご連絡先とご要望をご入力ください。</p>
            </div>
            <div class="form-mock-body">
              <div class="form-field">
                <div class="form-label">お名前 <span class="req">*必須</span></div>
                <div class="form-input" id="fi1"><span class="typed-text" data-text="山田 花子"></span></div>
              </div>
              <div class="form-field">
                <div class="form-label">メールアドレス <span class="req">*必須</span></div>
                <div class="form-input" id="fi2"><span class="typed-text" data-text="hanako@example.com"></span></div>
              </div>
              <div class="form-field">
                <div class="form-label">電話番号 <span class="req" style="color:var(--sub);font-weight:400">（任意）</span></div>
                <div class="form-input" id="fi3"><span class="typed-text" data-text="090-1234-5678"></span></div>
              </div>
              <div class="form-field">
                <div class="form-label">ご依頼内容 <span class="req">*必須</span></div>
                <div class="form-input" id="fi4" style="min-height:48px"><span class="typed-text" data-text="ネイルサロンのHPを作成希望です"></span></div>
              </div>
              <button class="form-btn" id="formSubmitBtn">この内容で送信する →</button>
            </div>
          </div>
          <div class="line-chat">
            <div class="line-header">
              <div class="line-header-icon">SD</div>
              <div class="line-header-name">Sane Design</div>
            </div>
            <div class="line-body">
              <div class="line-msg left m1">ネイルサロンを来月開業するので、ホームページを作りたいです。おしゃれで大人っぽい雰囲気にしたくて、メニュー・料金・アクセス・予約フォームのページが欲しいです！</div>
              <div class="line-msg left m3">名刺とショップカードのデザインがあるので、色やフォントのイメージはそちらに合わせていただけると嬉しいです 🙏</div>
              <div class="line-msg right m2">ご連絡ありがとうございます！素敵なサロンですね ✨ デザインイメージ承知しました。名刺のお写真をお送りいただければ、雰囲気を合わせてご提案いたしますね！</div>
              <div class="line-time">既読 14:32</div>
            </div>
          </div>
        </div>
      </div>
      <!-- STEP 02 -->
      <div class="step reveal" style="grid-column:1/-1">
        <span class="st">STEP 02</span>
        <div class="step2-layout">
          <div class="hearing-list">
            <div class="hearing-list-header">
              <h5>📋 ヒアリング項目</h5>
            </div>
            <div class="hearing-list-body" id="hearingList">
              <div class="hearing-item"><span class="hi-icon">✓</span><span>サイトの目的・ゴール</span></div>
              <div class="hearing-item"><span class="hi-icon">✓</span><span>ターゲット層・業種</span></div>
              <div class="hearing-item"><span class="hi-icon">✓</span><span>デザインのイメージ・参考サイト</span></div>
              <div class="hearing-item"><span class="hi-icon">✓</span><span>掲載したいコンテンツ</span></div>
              <div class="hearing-item"><span class="hi-icon">✓</span><span>ご希望の納期</span></div>
            </div>
          </div>
          <div>
            <div class="share-mock">
              <div class="share-mock-header">
                <h5>📁 共有いただくもの</h5>
              </div>
              <div class="share-mock-body" id="shareFiles">
                <div class="share-file"><div class="share-file-icon img">🖼️</div><div class="share-file-info"><div class="share-file-name">ロゴ画像.png</div><div class="share-file-size">2.4 MB</div></div></div>
                <div class="share-file"><div class="share-file-icon doc">📄</div><div class="share-file-info"><div class="share-file-name">掲載テキスト.docx</div><div class="share-file-size">156 KB</div></div></div>
                <div class="share-file"><div class="share-file-icon ref">🔗</div><div class="share-file-info"><div class="share-file-name">参考サイトURL</div><div class="share-file-size">3件</div></div></div>
                <div class="share-file"><div class="share-file-icon img">📸</div><div class="share-file-info"><div class="share-file-name">店舗写真（5枚）</div><div class="share-file-size">12.8 MB</div></div></div>
              </div>
            </div>
            <p style="font-size:10px;color:var(--orange);font-weight:700;margin-top:10px;line-height:1.5;text-align:center">※ご用意できなくてもOKです。ご相談ください！</p>
          </div>
          <div class="step2-center">
            <div class="step-heading"><h4>ヒアリング</h4><p>画像・文章・ご要望を<br>共有していただきます。</p></div>
            <img src="/assets/webdesign_page_step2.png" alt="ヒアリングイメージ">
          </div>
        </div>
      </div>
      <!-- STEP 03 -->
      <div class="step reveal" style="grid-column:1/-1">
        <span class="st">STEP 03</span>
        <div class="step3-layout">
          <div class="step3-center">
            <div class="step-heading"><h4>初稿提出</h4><p>数営業日で、まずは初稿を<br>提出してご確認いただきます。</p></div>
            <img src="/assets/webdesign_page_step3.png" alt="初稿提出イメージ">
          </div>
          <div class="design-preview">
            <div class="design-preview-header">
              <div class="dots"><span></span><span></span><span></span></div>
              <div class="url-bar">nail-salon.com</div>
            </div>
            <div class="design-preview-body" id="designPreview">
              <div class="dp-hero">
                <h6>Nail Salon</h6>
                <p>あなたの指先に、美しさを。</p>
              </div>
              <div class="dp-content">
                <div class="dp-block w100"></div>
                <div class="dp-block w80"></div>
                <div class="dp-block w60"></div>
                <div class="dp-grid">
                  <div class="dp-card"></div>
                  <div class="dp-card"></div>
                </div>
                <div class="dp-block w40" style="margin-top:8px"></div>
              </div>
            </div>
          </div>
          <div class="progress-timeline">
            <div class="progress-timeline-header">
              <h5>⏱️ 制作の進捗</h5>
            </div>
            <div class="progress-timeline-body" id="progressTimeline">
              <div class="tl-item"><div class="tl-dot done"></div><div class="tl-info"><div class="tl-label">ヒアリング完了</div><div class="tl-time">1日目</div></div></div>
              <div class="tl-item"><div class="tl-dot done"></div><div class="tl-info"><div class="tl-label">デザイン構成案作成</div><div class="tl-time">1日目</div></div></div>
              <div class="tl-item"><div class="tl-dot active"></div><div class="tl-info"><div class="tl-label">初稿デザイン制作中</div><div class="tl-time">2日目 ← いまここ</div></div></div>
              <div class="tl-item"><div class="tl-dot wait"></div><div class="tl-info"><div class="tl-label">お客様へ初稿提出</div><div class="tl-time">2〜3日目</div></div></div>
            </div>
          </div>
        </div>
      </div>
      <!-- STEP 04 -->
      <div class="step reveal" style="grid-column:1/-1">
        <span class="st">STEP 04</span>
        <div class="step4-layout">
          <div class="feedback-mock">
            <div class="feedback-mock-header">
              <h5>💬 お客様とのやりとり</h5>
            </div>
            <div class="feedback-mock-body" id="feedbackMock">
              <div class="fb-msg client"><div class="fb-avatar client">客</div><div class="fb-bubble">ヘッダーの色をもう少し濃くしたいです</div><div class="fb-time">14:02</div></div>
              <div class="fb-msg designer"><div class="fb-avatar designer">制</div><div class="fb-bubble">承知しました！すぐに修正いたします 🙌</div><div class="fb-time">14:05</div></div>
              <div class="fb-msg client"><div class="fb-avatar client">客</div><div class="fb-bubble">写真をもう1枚追加できますか？</div><div class="fb-time">14:10</div></div>
              <div class="fb-msg designer"><div class="fb-avatar designer">制</div><div class="fb-bubble">もちろんです！追加しておきました。ご確認ください ✨</div><div class="fb-time">14:15</div></div>
              <div class="fb-msg client"><div class="fb-avatar client">客</div><div class="fb-bubble">ありがとうございます！完璧です 😊</div><div class="fb-time">14:20</div></div>
            </div>
          </div>
          <div class="step4-right">
            <div class="step-heading"><h4>修正・調整</h4><p>フィードバックを反映。<br>修正回数は<strong>無制限</strong>。</p></div>
            <img src="/assets/webdesign_page_step4.png" alt="修正・調整イラスト">
          </div>
        </div>
      </div>
      <!-- STEP 05 -->
      <div class="step reveal">
        <span class="st">STEP 05</span>
        <div class="step5-layout">
          <div class="step5-center">
            <div class="step-heading">
              <h4>納品</h4>
              <p>モバイル対応のwebサイト<br>納品します！</p>
            </div>
            <img src="/assets/webdesign_page_step5.png" alt="納品イラスト">
          </div>
          <div class="step5-mock step5-phone">
            <div class="step5-mock-screen"><img class="step5-mock-shot" src="/assets/webdesign_page_flow5mobile.png" alt="モバイル表示のスクリーンショット"></div>
            <img class="step5-mock-frame" src="/assets/phone_frame.png" alt="">
          </div>
          <div class="step5-mock step5-laptop">
            <div class="step5-mock-screen"><img class="step5-mock-shot" src="/assets/webdesign_page_flow5desktop.png" alt="デスクトップ表示のスクリーンショット"></div>
            <img class="step5-mock-frame" src="/assets/laptop_frame.png" alt="">
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ═══ 04 サービス詳細 ═══ -->
<section>
  <div class="wave top"><svg viewBox="0 0 1200 60" preserveAspectRatio="none"><path d="M0,60 C300,0 900,0 1200,60 L1200,0 L0,0 Z" fill="var(--mint-bg)"/></svg></div>
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="sec-sub">Detail</span>
      <h2 class="sec-title">サービス詳細<small>基本プランに含まれるもの・オプション</small></h2>
    </div>
    <div class="detail-grid">
      <div class="detail-card reveal">
        <h3><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg>含まれるもの</h3>
        <ul class="detail-list">
          <li><span class="ck"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg></span>デザイン（レスポンシブ・スマホ対応）</li>
          <li><span class="ck"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg></span>コーディング（HTML / CSS / JS）</li>
          <li><span class="ck"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg></span>文章作成</li>
          <li><span class="ck"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg></span>SNS機能 / ギャラリー / お問い合わせフォーム</li>
          <li><span class="ck"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg></span>地図 / 動画挿入 / FAQ / イベント</li>
          <li><span class="ck"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg></span>無料修正：<strong>完成まで無制限</strong></li>
        </ul>
      </div>
      <div class="detail-card reveal">
        <h3><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 5v14M5 12h14"/></svg>オプション</h3>
        <ul class="detail-list">
          <li><span class="plus">+</span>¥3,000 — サーバーへの直接アップロード・公開対応</li>
          <li><span class="plus">+</span>¥10,000 — デザイン提出後の大幅変更</li>
          <li><span class="plus">+</span>¥40,000 — ECサイト構築（Stripe / Square 決済連携含）</li>
          <li><span class="plus">+</span>¥1,000 — 軽微な修正（画像入替・役員追加など）</li>
          <li><span class="plus">+</span>¥5,000 — 大規模修正（文字1,000字以上・画像20枚以上）</li>
        </ul>
      </div>
    </div>
    <p style="text-align:center;font-size:13px;color:var(--sub);margin-top:28px;font-weight:500;line-height:1.8">
      ご不明点はお気軽にご相談ください。サーバー・ドメインの選び方、ページ追加、ECサイト構築なども対応しております。
    </p>
  </div>
</section>

<!-- ═══ 05 パフォーマンス ═══ -->
<section class="sky">
  <div class="wave top"><svg viewBox="0 0 1200 60" preserveAspectRatio="none"><path d="M0,60 C300,0 900,0 1200,60 L1200,0 L0,0 Z" fill="#fff"/></svg></div>
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="sec-sub">Performance</span>
      <h2 class="sec-title">安心の<span class="mk">修正対応</span></h2>
    </div>
    <div class="perf-grid">
      <div class="perf-card reveal">
        <span class="perf-num perf-bounce" style="font-family:'Noto Sans JP'">無制限</span>
        <span class="perf-label">完成までの修正</span>
      </div>
      <div class="perf-card reveal">
        <span class="perf-num perf-count" data-target="5">0</span><span class="perf-unit">日</span>
        <span class="perf-label">平均納期（実績）</span>
      </div>
      <div class="perf-card reveal">
        <span class="perf-num perf-count" data-target="300">0</span><span class="perf-unit">+</span>
        <span class="perf-label">制作実績</span>
      </div>
    </div>
  </div>
</section>

<!-- ═══ 06 制作実績 ═══ -->
<section id="web-works">
  <div class="wave top"><svg viewBox="0 0 1200 60" preserveAspectRatio="none"><path d="M0,60 C300,0 900,0 1200,60 L1200,0 L0,0 Z" fill="var(--sky-bg)"/></svg></div>
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="sec-sub">Works</span>
      <h2 class="sec-title">制作実績<small>最新の制作例をご紹介します</small></h2>
    </div>
    <div class="work-grid">
