---
import RenewalLayout from '../../layouts/RenewalLayout.astro';
import { SITE_URL, SITE_NAME } from '../../consts';

const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'SEO対策',
  name: 'SEO対策・内部対策',
  description:
    '10,000円〜・1日3記事ずつ公開。指定キーワードに基づくブログ記事追加と内部SEO対策を実施。検索順位向上をサポートします。',
  provider: { '@id': `${SITE_URL}/#organization` },
  areaServed: { '@type': 'Country', name: 'Japan' },
  url: `${SITE_URL}/services/seo/`,
  offers: {
    '@type': 'Offer',
    price: '10000',
    priceCurrency: 'JPY',
    description: '厳選60記事追加＋内部SEO対策',
  },
};
---

<RenewalLayout
  title="SEO対策・内部SEO｜10,000円〜・1日3記事ずつ公開 | Sane Design"
  description="10,000円〜・1日3記事ずつ公開。指定キーワードに基づくブログ記事60本追加と内部SEO対策を実施。実績200件以上のデザイナーが検索順位向上をサポートします。"
  jsonLd={serviceJsonLd}
>

<!-- ═══ 01 HERO ═══ -->
<section class="seo-hero reveal">
  <div class="wrap">
    <span class="sec-sub">SEO</span>
    <h1>検索で<br><span class="big">見つかるサイト</span>に</h1>
    <p class="lead">指定キーワードに基づく厳選記事追加と内部SEO対策で、<br>あなたのサイトの検索順位向上をサポートします。</p>
    <div style="display:flex;gap:16px;flex-wrap:wrap;justify-content:center">
      <a href="/contact/" class="btn btn-primary">まずは無料で相談する<svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
      <a href="/payment/" class="btn btn-ghost">今すぐ注文する</a>
    </div>
    <div class="hero-badges">
      <span class="hero-badge"><i class="ck"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg></i>相談だけでもOK</span>
      <span class="hero-badge"><i class="ck"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg></i>1日3記事ずつ公開</span>
      <span class="hero-badge"><i class="ck"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg></i>実績200件以上</span>
    </div>
    <div class="spec-strip">
      <div class="spec-item">
        <div class="lbl-top">コミコミ価格</div>
        <div class="big"><span class="num">¥10,000</span>〜</div>
        <div class="lbl">追加費用なし</div>
      </div>
      <div class="spec-item">
        <div class="lbl-top">公開ペース</div>
        <div class="big">1日<span class="num">3</span>記事</div>
        <div class="lbl">じっくり公開</div>
      </div>
      <div class="spec-item">
        <div class="lbl-top">記事数</div>
        <div class="big"><span class="num">60</span>本</div>
        <div class="lbl">キーワード厳選</div>
      </div>
      <div class="spec-item">
        <div class="lbl-top">納品形態</div>
        <div class="big" style="font-size:20px;padding-top:4px">テキスト / 直接UP</div>
        <div class="lbl">どちらでもOK</div>
      </div>
    </div>
  </div>
</section>

<!-- ═══ 02 こんな方におすすめ ═══ -->
<section class="cream" style="padding-top:60px">
  <div class="wave top"><svg viewBox="0 0 1200 60" preserveAspectRatio="none"><path d="M0,60 C300,0 900,0 1200,60 L1200,0 L0,0 Z" fill="#fff"/></svg></div>
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="sec-sub">Recommend</span>
      <h2 class="sec-title">こんな方に<span class="mk">おすすめ</span><small>ひとつでも当てはまったら、お気軽にご相談ください</small></h2>
    </div>
    <div class="seo-recommend-grid">
      <div class="seo-rec-card reveal">
        <div class="seo-rec-icon blue">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
        </div>
        <h4>着実にSEO効果を<br>出したい方</h4>
        <p>1日3記事ずつ計60記事を公開。検索エンジンに評価されやすいペースで着実に対策します。</p>
      </div>
      <div class="seo-rec-card reveal">
        <div class="seo-rec-icon orange">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4-4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
        </div>
        <h4>記事作成の<br>リソースが不足</h4>
        <p>社内にライターがいなくても大丈夫。プロが60本すべて作成します。</p>
      </div>
      <div class="seo-rec-card reveal">
        <div class="seo-rec-icon green">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/></svg>
        </div>
        <h4>内部対策の<br>見直しをしたい方</h4>
        <p>タイトル・メタ・見出し構造・内部リンク・スキーマを徹底的に最適化。</p>
      </div>
      <div class="seo-rec-card reveal">
        <div class="seo-rec-icon pink">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
        </div>
        <h4>検索順位を上げて<br>問い合わせを増やしたい</h4>
        <p>コンテンツSEOと内部対策の両面から、検索流入の増加をサポートします。</p>
      </div>
    </div>
  </div>
</section>

<!-- ═══ 03 実施内容 ═══ -->
<section class="mint">
  <div class="wave top"><svg viewBox="0 0 1200 60" preserveAspectRatio="none"><path d="M0,60 C300,0 900,0 1200,60 L1200,0 L0,0 Z" fill="var(--cream-bg)"/></svg></div>
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="sec-sub">Service</span>
      <h2 class="sec-title">かんたん<span class="mk">2ステップ</span>で<br>SEO対策を実装<small>コンテンツSEOと内部対策の両面からアプローチ</small></h2>
    </div>
    <div class="seo-service-grid">
      <!-- コンテンツSEO -->
      <div class="seo-service-card reveal">
        <div class="seo-service-num">01</div>
        <div class="seo-service-body">
          <h3>コンテンツSEO</h3>
          <p class="seo-service-desc">指定キーワードに基づき、検索意図を満たす記事を<strong>60本</strong>作成・追加します。</p>
          <div class="seo-feature-list">
            <div class="seo-feature-item">
              <span class="seo-fi-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
              </span>
              <span>キーワード調査・選定</span>
            </div>
            <div class="seo-feature-item">
              <span class="seo-fi-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
              </span>
              <span>検索意図に合った記事構成</span>
            </div>
            <div class="seo-feature-item">
              <span class="seo-fi-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
              </span>
              <span>SEOに最適化されたライティング</span>
            </div>
            <div class="seo-feature-item">
              <span class="seo-fi-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
              </span>
              <span>内部リンク設計</span>
            </div>
          </div>
        </div>
      </div>

      <!-- 内部SEO -->
      <div class="seo-service-card reveal">
        <div class="seo-service-num">02</div>
        <div class="seo-service-body">
          <h3>内部SEO対策</h3>
          <p class="seo-service-desc">サイト全体の技術的なSEO要素を見直し、検索エンジンに正しく評価される構造に最適化します。</p>
          <div class="seo-feature-list">
            <div class="seo-feature-item">
              <span class="seo-fi-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
              </span>
              <span>タイトルタグ・メタディスクリプション</span>
            </div>
            <div class="seo-feature-item">
              <span class="seo-fi-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
              </span>
              <span>見出し構造（h1〜h6）最適化</span>
            </div>
            <div class="seo-feature-item">
              <span class="seo-fi-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
              </span>
              <span>構造化データ（スキーマ）マークアップ</span>
            </div>
            <div class="seo-feature-item">
              <span class="seo-fi-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
              </span>
              <span>サイト内リンク構造の改善</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ═══ 04 SEO効果のイメージ ═══ -->
<section class="sky">
  <div class="wave top"><svg viewBox="0 0 1200 60" preserveAspectRatio="none"><path d="M0,60 C300,0 900,0 1200,60 L1200,0 L0,0 Z" fill="var(--mint-bg)"/></svg></div>
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="sec-sub">Flow</span>
      <h2 class="sec-title">ご依頼から<span class="mk">公開まで</span><small>1日3記事ずつ、じっくり公開していきます</small></h2>
    </div>
    <div class="seo-flow-timeline">
      <div class="seo-flow-step reveal">
        <div class="seo-flow-dot"></div>
        <div class="seo-flow-card">
          <span class="seo-flow-day">STEP 1</span>
          <h4>ヒアリング</h4>
          <p>対策したいキーワードやサイトの現状をお伺いします。お気軽にご相談ください。</p>
        </div>
      </div>
      <div class="seo-flow-step reveal">
        <div class="seo-flow-dot"></div>
        <div class="seo-flow-card">
          <span class="seo-flow-day">STEP 2</span>
          <h4>キーワード調査・記事作成</h4>
          <p>ターゲットキーワードを選定し、検索意図に合った記事60本を作成します。</p>
        </div>
      </div>
      <div class="seo-flow-step reveal">
        <div class="seo-flow-dot active"></div>
        <div class="seo-flow-card">
          <span class="seo-flow-day">STEP 3</span>
          <h4>1日3記事ずつ公開</h4>
          <p>検索エンジンに評価されやすいペースで、1日3記事ずつじっくり公開していきます。</p>
        </div>
      </div>
      <div class="seo-flow-step reveal">
        <div class="seo-flow-dot done"></div>
        <div class="seo-flow-card">
          <span class="seo-flow-day">STEP 4</span>
          <h4>内部SEO対策＋完了</h4>
          <p>タイトル・メタ・見出し・スキーマなどの内部SEO対策を実施し、すべての作業が完了します。</p>
        </div>
      </div>
    </div>
    <p style="text-align:center;font-size:12px;color:var(--sub);margin-top:32px;font-weight:500;line-height:1.8">
      ※ SEO対策では一度に大量の記事を公開する事はマイナス評価に繋がる可能性があるので、じっくり公開して参ります。<br>
      ※ 検索順位への反映には通常数週間〜数ヶ月かかります。即日の順位変動を保証するものではありません。
    </p>
  </div>
</section>

<!-- ═══ 05 サービス詳細 ═══ -->
<section>
  <div class="wave top"><svg viewBox="0 0 1200 60" preserveAspectRatio="none"><path d="M0,60 C300,0 900,0 1200,60 L1200,0 L0,0 Z" fill="var(--sky-bg)"/></svg></div>
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="sec-sub">Detail</span>
      <h2 class="sec-title">サービス詳細<small>基本プランに含まれるもの・オプション</small></h2>
    </div>
    <div class="detail-grid">
      <div class="detail-card reveal">
        <h3><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg>含まれるもの</h3>
        <ul class="detail-list">
          <li><span class="ck"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg></span>指定キーワードに基づくブログ記事 <strong>60本</strong>作成・追加</li>
          <li><span class="ck"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg></span>内部SEO対策（タイトル・メタ・見出し構造・内部リンク・スキーマ）</li>
          <li><span class="ck"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg></span>実績200件以上のノウハウで対策を実施</li>
          <li><span class="ck"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M20 6L9 17l-5-5"/></svg></span>キーワード調査・選定</li>
        </ul>
      </div>
      <div class="detail-card reveal">
        <h3><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M12 5v14M5 12h14"/></svg>オプション</h3>
        <ul class="detail-list">
          <li><span class="plus">+</span>¥5,000 — サーバーへの直接アップロード（内部SEO対策実施含）</li>
          <li><span class="plus">+</span>¥5,000 — 完全オリジナル画像付き記事 60本</li>
        </ul>
        <p style="font-size:12px;color:var(--sub);margin-top:16px;line-height:1.7;font-weight:500">
          ご不明点はお気軽にご相談ください。<br>キーワード選定のアドバイスも無料で承ります。
        </p>
      </div>
    </div>
  </div>
</section>

<!-- ═══ 06 パフォーマンス ═══ -->
<section class="cream">
  <div class="wave top"><svg viewBox="0 0 1200 60" preserveAspectRatio="none"><path d="M0,60 C300,0 900,0 1200,60 L1200,0 L0,0 Z" fill="#fff"/></svg></div>
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="sec-sub">Performance</span>
      <h2 class="sec-title">選ばれる<span class="mk">理由</span></h2>
    </div>
    <div class="perf-grid">
      <div class="perf-card reveal">
        <span class="perf-num perf-count" data-target="60">0</span><span class="perf-unit">本</span>
        <span class="perf-label">厳選記事を追加</span>
      </div>
      <div class="perf-card reveal">
        <span class="perf-num perf-count" data-target="3">0</span><span class="perf-unit">記事/日</span>
        <span class="perf-label">じっくり公開</span>
      </div>
      <div class="perf-card reveal">
        <span class="perf-num perf-count" data-target="200">0</span><span class="perf-unit">+</span>
        <span class="perf-label">SEO対策実績</span>
      </div>
    </div>
  </div>
</section>

<!-- ═══ 07 CTA ═══ -->
<section class="cta-section">
  <div class="wrap" style="position:relative;z-index:2">
    <h2>¥10,000〜 / 1日3記事ずつ公開</h2>
    <p class="cta-sub">フォームからお気軽にご相談ください</p>
    <div class="cta-btns">
      <a href="/payment/" class="btn btn-white">今すぐ注文する →</a>
      <a href="/contact/#contact-form" class="btn btn-primary" style="box-shadow:0 5px 0 rgba(0,0,0,.2)">まずは相談する<svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
    </div>
  </div>
</section>

</RenewalLayout>

<style is:global>
/* ══════════════════════════════════════════════
   SEO PAGE STYLES
   ══════════════════════════════════════════════ */
:root {
  --primary:#4FB4E8; --primary-dark:#2E90C4; --primary-deep:#1c6f9c;
  --sky-bg:#E4F4FD; --cream-bg:#FFF6E0; --mint-bg:#E9F7E4; --pink-bg:#FFEFF0;
  --green:#78C25E; --green-dark:#4e8a3c;
  --yellow:#FFCF4D; --yellow-dark:#a9821f;
  --orange:#F79B3E; --orange-dark:#c76f14;
  --text:#3A4256; --sub:#7A8494;
  --white:#fff; --radius:24px; --shadow:0 10px 30px rgba(58,66,86,.08);
}
img{max-width:100%;display:block}
h1,h2,h3,h4{font-family:"Noto Sans JP",sans-serif}
.en{font-family:"Inter",sans-serif}
.wrap{max-width:1080px;margin:0 auto;padding:0 22px}
.mk{background:linear-gradient(transparent 60%, #FFE08A 60%);padding:0 2px}

/* ── Buttons ── */
.btn{display:inline-flex;align-items:center;gap:10px;font-family:"Noto Sans JP";font-weight:700;border-radius:999px;padding:16px 34px;font-size:16px;transition:.12s;cursor:pointer;border:none;position:relative;text-decoration:none;box-sizing:border-box}
.btn svg{width:18px;height:18px;stroke-width:3}
.btn-primary{background:var(--orange);color:#fff!important;box-shadow:0 5px 0 var(--orange-dark)}
.btn-primary:hover{transform:translateY(2px);box-shadow:0 3px 0 var(--orange-dark);background:var(--orange);color:#fff!important}
.btn-primary::after{display:none!important}
.btn-ghost{background:#fff;color:var(--primary-dark)!important;box-shadow:0 5px 0 #CDEBFA;border:2px solid #CDEBFA}
.btn-ghost:hover{transform:translateY(2px);box-shadow:0 3px 0 #CDEBFA;color:var(--primary-dark)!important;background:#fff}
.btn-ghost::after{display:none!important}
.btn-white{background:#fff;color:var(--text)!important;box-shadow:0 5px 0 #ddd;border:2px solid #eee}
.btn-white:hover{transform:translateY(2px);box-shadow:0 3px 0 #ddd;background:#fff;color:var(--text)!important}
.btn-white::after{display:none!important}

/* ── Section base ── */
section{padding:84px 0;position:relative}
.sky{background:var(--sky-bg)} .cream{background:var(--cream-bg)} .mint{background:var(--mint-bg)} .pink{background:var(--pink-bg)}
.sec-head{text-align:center;margin-bottom:48px}
.sec-sub{font-family:"Inter";font-weight:800;font-size:14px;letter-spacing:2px;color:var(--primary);text-transform:uppercase;display:block;margin-bottom:6px}
.sec-title{font-size:34px;font-weight:900;line-height:1.5}
.sec-title small{display:block;font-size:15px;color:var(--sub);font-weight:500;margin-top:12px;font-family:"Noto Sans JP"}
.wave{position:absolute;left:0;width:100%;line-height:0;z-index:1}
.wave.top{top:-1px}
.wave svg{width:100%;height:60px;display:block}

/* ── HERO ── */
.seo-hero{background:radial-gradient(120% 90% at 80% 0%,#D7EFFB 0%,#EAF7FE 45%,#fff 100%);padding:80px 0 0;text-align:center}
.seo-hero .sec-sub{margin-bottom:10px;font-size:clamp(28px,9vw,42px);letter-spacing:6px;white-space:nowrap}
.seo-hero h1{font-size:clamp(28px,4.5vw,52px);font-weight:900;line-height:1.3;letter-spacing:1px}
.seo-hero h1 .big{color:var(--primary);font-size:1.15em}
.seo-hero .lead{font-size:17px;color:#5b6474;margin:20px 0 28px;font-weight:500;line-height:1.8}
.seo-hero .hero-badges{display:flex;gap:20px;margin-top:24px;flex-wrap:wrap;justify-content:center}
.hero-badge{display:flex;align-items:center;gap:7px;font-size:13px;font-weight:700}
.hero-badge svg{width:22px;height:22px;color:#fff;background:var(--green);border-radius:50%;padding:4px;stroke-width:3;display:block}
.hero-badge .ck{position:relative;display:inline-flex;line-height:0}

/* spec strip */
.spec-strip{display:grid;grid-template-columns:repeat(4,1fr);gap:0;background:#fff;border-radius:26px;box-shadow:var(--shadow);overflow:hidden;margin-top:44px}
.spec-item{text-align:center;padding:22px 14px;position:relative}
.spec-item+.spec-item{border-left:2px dashed #E7ECF2}
.spec-item .lbl-top{font-size:12px;color:var(--sub);font-weight:700;margin-bottom:4px}
.spec-item .big{font-family:"Inter";font-size:28px;font-weight:800;color:var(--primary);line-height:1.2}
.spec-item .big .num{font-size:1.3em;color:var(--orange);font-weight:800}
